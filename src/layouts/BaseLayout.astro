---
import "../styles/global.css";
import { ViewTransitions } from "astro:transitions";
import NoiseOverlay from "@components/NoiseOverlay.astro";
import FlyingNav from "@components/FlyingNav.astro";
import CartDrawer from "@components/CartDrawer.astro";
import Footer from "@components/Footer.astro";
import { BRAND } from "@data/site";

interface Props {
  title?: string;
  description?: string;
}
const {
  title = `${BRAND.name} — ${BRAND.tagline}`,
  description = "Społeczna kawiarnia specialty MOCna!. Tworzymy miejsca pracy dla osób z niepełnosprawnościami, organizujemy wydarzenia, szkolenia i budujemy społeczność.",
} = Astro.props;

const FONTSHARE_CSS =
  "https://api.fontshare.com/v2/css?f[]=clash-display@600,700&f[]=satoshi@300,400,500,700&display=swap";
---
<!doctype html>
<html lang="pl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preconnect" href="https://api.fontshare.com" crossorigin />
    <link rel="preconnect" href="https://cdn.fontshare.com" crossorigin />
    <link rel="preload" href={FONTSHARE_CSS} as="style" />
    <link rel="stylesheet" href={FONTSHARE_CSS} media="print" onload="this.media='all'" />
    <noscript><link rel="stylesheet" href={FONTSHARE_CSS} /></noscript>
    <link rel="preload" href="/brand/logo-kolor.svg" as="image" type="image/svg+xml" fetchpriority="high" />
    <link rel="icon" type="image/svg+xml" href="/brand/logo-kolor.svg" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f39200" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <title>{title}</title>
    <ViewTransitions />
    <slot name="head" />
  </head>
  <body class="relative flex min-h-screen flex-col">
    <!-- Subtelny watermark patternu marki na całej witrynie -->
    <div
      class="pointer-events-none fixed inset-0 -z-50 bg-repeat"
      style="background-image:url('/brand/pattern.png'); background-size:340px; opacity: 0.04;"
      aria-hidden="true"
    ></div>

    <NoiseOverlay />

    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[70] focus:rounded-full focus:bg-graphite focus:px-5 focus:py-3 focus:text-white">
      Przejdź do treści
    </a>

    <FlyingNav />
    <CartDrawer />
    <!-- Spacer: odpycha treść dokładnie o wysokość navbaru (który jest fixed) -->
    <div id="nav-spacer" aria-hidden="true" class="h-16 sm:h-[4.5rem]"></div>

    <main id="main" class="flex flex-1 flex-col">
      <slot />
    </main>

    <Footer />

    <script>
      import { initSectionScroll } from "../scripts/scroll-to-section";
      initSectionScroll();
      document.addEventListener("astro:page-load", initSectionScroll);
    </script>
  </body>
</html>

<style is:global>
  /* Delikatne wejście treści przy zmianie podstrony (View Transitions) */
  main {
    animation: rise-in 0.6s cubic-bezier(0.22, 1, 0.36, 1) both;
  }
</style>
