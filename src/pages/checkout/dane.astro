---
import CheckoutLayout from "@layouts/CheckoutLayout.astro";
---

<CheckoutLayout title="Dane zamówienia — MOCna!">
  <div class="checkout-page pb-20 pt-16 sm:pb-28 sm:pt-24 min-h-screen">
    <div class="shell max-w-3xl">

      <div id="data-empty" class="hidden text-center mt-12 border border-graphite-200 bg-white p-10">
        <p class="text-xl text-graphite-muted">Uzupełnij wcześniejsze kroki zamówienia.</p>
        <a href="/checkout" class="btn-orange mt-6 inline-flex">Wróć do dostawy</a>
      </div>

      <div id="data-content" class="hidden border border-graphite-200 bg-white">
        <div class="p-6 sm:p-8 border-b border-graphite-200">
          <h1 class="text-2xl font-bold text-graphite">Dane zamawiającego</h1>
        </div>

        <form id="data-form" class="p-6 sm:p-8 space-y-8">
          <section>
            <div class="grid gap-5 sm:grid-cols-2">
              <div>
                <label for="firstName" class="block text-sm font-medium text-graphite-muted mb-1.5">Imię *</label>
                <input type="text" id="firstName" name="firstName" required class="field-input w-full" />
              </div>
              <div>
                <label for="lastName" class="block text-sm font-medium text-graphite-muted mb-1.5">Nazwisko *</label>
                <input type="text" id="lastName" name="lastName" required class="field-input w-full" />
              </div>
              <div class="sm:col-span-2">
                <label for="email" class="block text-sm font-medium text-graphite-muted mb-1.5">E-mail *</label>
                <input type="email" id="email" name="email" required class="field-input w-full" />
              </div>
              <div class="sm:col-span-2">
                <label for="phone" class="block text-sm font-medium text-graphite-muted mb-1.5">Telefon *</label>
                <input type="tel" id="phone" name="phone" required class="field-input w-full" />
              </div>
            </div>
          </section>

          <section id="courier-address" class="hidden">
            <h2 class="text-lg font-bold text-graphite mb-4">Adres dostawy</h2>
            <div class="grid gap-5 sm:grid-cols-2">
              <div class="sm:col-span-2">
                <label for="address" class="block text-sm font-medium text-graphite-muted mb-1.5">Ulica i nr domu/mieszkania *</label>
                <input type="text" id="address" name="address" class="field-input w-full" />
              </div>
              <div>
                <label for="zipCode" class="block text-sm font-medium text-graphite-muted mb-1.5">Kod pocztowy *</label>
                <input type="text" id="zipCode" name="zipCode" class="field-input w-full" placeholder="00-000" />
              </div>
              <div>
                <label for="city" class="block text-sm font-medium text-graphite-muted mb-1.5">Miejscowość *</label>
                <input type="text" id="city" name="city" class="field-input w-full" />
              </div>
            </div>
          </section>

          <section id="paczkomat-info" class="hidden">
            <h2 class="text-lg font-bold text-graphite mb-4">Paczkomat</h2>
            <div id="paczkomat-summary" class="checkout-highlight-green p-4 text-sm"></div>
          </section>

          <div id="data-error" class="checkout-error hidden"></div>

          <div class="flex flex-col-reverse sm:flex-row gap-3">
            <a href="/checkout/platnosc" class="btn border border-graphite-200 bg-white text-graphite hover:bg-graphite-50 justify-center py-4 text-center">
              Wróć
            </a>
            <button type="submit" class="btn-orange flex-1 justify-center py-4 text-lg">
              Przejdź do podsumowania
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>
</CheckoutLayout>

<script>
  import { readCart } from "../../scripts/cart";
  import { parseInPostPointAddress } from "../../lib/inpost-point";
  import { patchCheckoutDraft, readCheckoutDraft } from "../../scripts/checkout-draft";

  function init() {
    const emptyView = document.getElementById("data-empty");
    const contentView = document.getElementById("data-content");
    const form = document.getElementById("data-form") as HTMLFormElement | null;
    const errorEl = document.getElementById("data-error");
    if (!form) return;

    const draft = readCheckoutDraft();
    if (readCart().length === 0 || !draft?.shippingMethod || !draft.paymentMethod) {
      emptyView?.classList.remove("hidden");
      contentView?.classList.add("hidden");
      return;
    }

    emptyView?.classList.add("hidden");
    contentView?.classList.remove("hidden");

    const courierSection = document.getElementById("courier-address");
    const paczkomatInfo = document.getElementById("paczkomat-info");
    const addressInputs = courierSection?.querySelectorAll("input") ?? [];

    if (draft.shippingMethod === "courier") {
      courierSection?.classList.remove("hidden");
      paczkomatInfo?.classList.add("hidden");
      addressInputs.forEach((i) => i.setAttribute("required", ""));
    } else {
      courierSection?.classList.add("hidden");
      paczkomatInfo?.classList.remove("hidden");
      addressInputs.forEach((i) => i.removeAttribute("required"));

      const summaryEl = document.getElementById("paczkomat-summary");
      if (summaryEl && draft.paczkomatPoint) {
        try {
          const p = JSON.parse(draft.paczkomatPoint);
          const parsed = parseInPostPointAddress(p);
          const name = p.display_name ?? p.name ?? "";
          const addr = [parsed.address, parsed.zipCode, parsed.city].filter(Boolean).join(", ");
          summaryEl.innerHTML = `<p class="font-bold text-white">${name}</p><p class="text-white mt-1">${addr}</p>`;
        } catch {
          summaryEl.textContent = "Wybrany paczkomat";
        }
      }
    }

    if (draft.firstName) (form.elements.namedItem("firstName") as HTMLInputElement).value = draft.firstName;
    if (draft.lastName) (form.elements.namedItem("lastName") as HTMLInputElement).value = draft.lastName;
    if (draft.email) (form.elements.namedItem("email") as HTMLInputElement).value = draft.email;
    if (draft.phone) (form.elements.namedItem("phone") as HTMLInputElement).value = draft.phone;
    if (draft.address) (form.elements.namedItem("address") as HTMLInputElement).value = draft.address;
    if (draft.zipCode) (form.elements.namedItem("zipCode") as HTMLInputElement).value = draft.zipCode;
    if (draft.city) (form.elements.namedItem("city") as HTMLInputElement).value = draft.city;

    if (form.dataset.bound === "true") return;
    form.dataset.bound = "true";

    form.addEventListener("submit", (e) => {
      e.preventDefault();

      const fd = new FormData(form);
      const data = Object.fromEntries(fd.entries());

      let address = (data.address as string) || "";
      let zipCode = (data.zipCode as string) || "";
      let city = (data.city as string) || "";

      if (draft.shippingMethod === "paczkomat" && draft.paczkomatPoint) {
        const parsed = parseInPostPointAddress(JSON.parse(draft.paczkomatPoint));
        address = parsed.address;
        zipCode = parsed.zipCode;
        city = parsed.city;

        if (!zipCode || !city) {
          if (errorEl) {
            errorEl.textContent = "Nie udało się odczytać adresu paczkomatu. Wróć i wybierz punkt ponownie.";
            errorEl.classList.remove("hidden");
          }
          return;
        }
      }

      errorEl?.classList.add("hidden");

      patchCheckoutDraft({
        firstName: data.firstName as string,
        lastName: data.lastName as string,
        email: data.email as string,
        phone: data.phone as string,
        address,
        zipCode,
        city,
      });

      window.location.href = "/checkout/podsumowanie";
    });
  }

  document.addEventListener("astro:page-load", init);
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", init);
  } else {
    init();
  }
</script>
