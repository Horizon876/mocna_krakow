---
import BaseLayout from "@layouts/BaseLayout.astro";
import PageHero from "@components/PageHero.astro";
import SectionHeading from "@components/SectionHeading.astro";
import Photo from "@components/Photo.astro";
import StoriesSection from "@components/StoriesSection.astro";
import OrganicDivider from "@components/OrganicDivider.astro";
import { STATS, COLORS } from "@data/site";

const values = [
  { emoji: "🫶", title: "Najpierw człowiek", desc: "Stanowisko dopasowujemy do osoby, nie odwrotnie.", color: "orange" },
  { emoji: "☕", title: "Jakość bez kompromisów", desc: "Specialty, świeży wypał, rzetelne rzemiosło.", color: "red" },
  { emoji: "🌍", title: "Realny wpływ", desc: "Każda kawa finansuje godną pracę.", color: "green" },
  { emoji: "🤝", title: "Społeczność", desc: "Relacje, które wykraczają poza ladę.", color: "blue" },
] as const;
---
<BaseLayout title="O MOCnej — kim jesteśmy">
  <PageHero
    kicker="O MOCnej"
    title="Zaczęło się od <span class='text-orange'>jednego pytania</span>: a gdyby praca dawała godność?"
    lead="MOCna! to przedsiębiorstwo społeczne i kawiarnia specialty w jednym. Łączymy najwyższą jakość kawy z misją, która zmienia życie ludzi."
    variant="hero"
  />

  <section class="py-12 sm:py-16">
    <div class="shell grid items-center gap-10 lg:grid-cols-2">
      <Photo alt="Założycielka MOCnej" emoji="💬" color="#f39200" mask="blob" ratio="4/4.4" class="shadow-soft" />
      <div>
        <span class="kicker">Nasza historia</span>
        <p class="text-fluid-xl font-display font-bold leading-tighter tracking-tightest">
          „Nie chciałam tworzyć kolejnej kawiarni. Chciałam stworzyć
          <span class="text-orange">miejsce, w którym ludzie rozkwitają.</span>”
        </p>
        <p class="mt-5 text-fluid-sm leading-relaxed text-graphite-soft">
          MOCna! narodziła się z przekonania, że osoby z niepełnosprawnościami
          zasługują na coś więcej niż współczucie — zasługują na realną,
          satysfakcjonującą pracę. Zaczęliśmy od jednego ekspresu i kilku osób.
          Dziś jesteśmy zespołem, wydarzeniami i społecznością.
        </p>
        <p class="mt-4 text-fluid-sm leading-relaxed text-graphite-soft">
          Po drodze nauczyliśmy się jednego: kiedy stawiasz człowieka w centrum,
          jakość przychodzi sama. A nasza kawa? Najlepsza w mieście. Mówią to
          nasi goście, nie my.
        </p>
      </div>
    </div>
  </section>

  <section class="py-12 sm:py-16">
    <div class="shell">
      <SectionHeading align="center" kicker="Nasze wartości" title="Cztery filary <span class='text-orange'>MOCy</span>" />
      <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {values.map((v) => (
          <article class="rounded-[26px] border border-graphite-200 bg-white p-7 transition-transform duration-500 hover:-translate-y-1" style={`border-top:4px solid ${COLORS[v.color]}`}>
            <span class="text-4xl">{v.emoji}</span>
            <h3 class="mt-4 text-fluid-lg font-display font-bold tracking-tightest">{v.title}</h3>
            <p class="mt-2 text-fluid-sm text-graphite-soft">{v.desc}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="py-12 sm:py-16">
    <div class="shell grid gap-4 rounded-[32px] bg-yellow-cream p-8 sm:grid-cols-2 lg:grid-cols-4 sm:p-12">
      {STATS.map((s) => (
        <div>
          <div class="font-display text-5xl font-bold tracking-tightest" style={`color:${s.color}`}>
            {s.value.toLocaleString("pl-PL")}{s.suffix ?? ""}
          </div>
          <p class="mt-2 text-fluid-sm text-graphite-soft">{s.label}</p>
        </div>
      ))}
    </div>
  </section>

  <OrganicDivider fill="#333333" />
  <StoriesSection />
</BaseLayout>
