---
// Plik wygenerowany jako pełna strona (index.astro / demo-hero.astro)
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>TailGrids E-commerce</title>
  </head>
  <body class="font-sans antialiased text-gray-600 bg-white min-h-screen flex flex-col">
    <!-- Top Bar (Desktop Only) -->
    <div class="hidden md:block border-b border-gray-100 bg-white">
      <div class="container mx-auto px-4 sm:px-6 lg:px-8 max-w-[1200px]">
        <div class="flex justify-between items-center h-[42px] text-[13px] text-gray-500 font-medium">
          <ul class="flex space-x-6">
            <li><a href="#" class="hover:text-blue-600 transition-colors">About Us</a></li>
            <li><a href="#" class="hover:text-blue-600 transition-colors">Order Tracking</a></li>
            <li><a href="#" class="hover:text-blue-600 transition-colors">Contact Us</a></li>
            <li><a href="#" class="hover:text-blue-600 transition-colors">FAQs</a></li>
          </ul>
          <div class="flex space-x-6">
            <div class="flex items-center cursor-pointer hover:text-blue-600 transition-colors">
              English 
              <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 ml-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
              </svg>
            </div>
            <div class="flex items-center cursor-pointer hover:text-blue-600 transition-colors">
              USD 
              <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 ml-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
              </svg>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Main Navbar -->
    <header class="border-b border-gray-100 bg-white">
      <div class="container mx-auto px-4 sm:px-6 lg:px-8 max-w-[1200px]">
        <div class="flex justify-between items-center h-[88px] gap-4">
          
          <!-- Logo -->
          <a href="#" class="flex items-center flex-shrink-0">
            <svg class="h-9 w-9 text-blue-600" viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M20 40C31.0457 40 40 31.0457 40 20C40 8.9543 31.0457 0 20 0C8.9543 0 0 8.9543 0 20C0 31.0457 8.9543 40 20 40Z" fill="#EEF2FF"/>
              <path d="M25.7 15.5C24.3 14 22.3 13.1 20 13.1C16.2 13.1 13.1 16.2 13.1 20C13.1 23.8 16.2 26.9 20 26.9C22.6 26.9 24.9 25.4 26 23.2H19.5V19.8H30.1C30.2 20.5 30.3 21.2 30.3 22C30.3 27.6 25.7 32.2 20.1 32.2C13.4 32.2 7.9 26.7 7.9 20C7.9 13.3 13.4 7.8 20.1 7.8C23.5 7.8 26.5 9.2 28.7 11.4L25.7 15.5Z" fill="#2563EB"/>
            </svg>
            <span class="ml-2 text-[22px] font-bold text-[#111827] tracking-tight">TailGrids</span>
          </a>

          <!-- Mobile Menu Button -->
          <button class="lg:hidden text-gray-500 hover:text-blue-600">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16m-7 6h7" />
            </svg>
          </button>

          <!-- Search Bar -->
          <div class="hidden lg:flex flex-1 max-w-[600px] mx-4 xl:mx-8">
            <div class="flex w-full bg-[#F4F7FF] border border-gray-200 rounded-[5px] overflow-hidden focus-within:ring-1 focus-within:ring-blue-600 focus-within:border-blue-600 transition-all">
              <div class="relative flex items-center border-r border-gray-200 px-4 bg-[#F4F7FF] text-[14px] text-gray-700 font-medium cursor-pointer min-w-[140px] justify-between">
                All Categories
                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                </svg>
              </div>
              <input type="text" placeholder="I'm shopping for..." class="flex-1 bg-transparent px-5 py-[10px] text-[15px] outline-none placeholder-gray-400 text-gray-700" />
              <button class="bg-blue-600 text-white px-6 py-[10px] hover:bg-blue-700 transition-colors flex items-center justify-center">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-[18px] h-[18px]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                </svg>
              </button>
            </div>
          </div>

          <!-- Right side -->
          <div class="hidden lg:flex items-center space-x-6">
            <div class="flex items-center space-x-3 border-r border-gray-100 pr-6">
              <div class="w-10 h-10 rounded-full border border-gray-200 flex items-center justify-center text-gray-600">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                </svg>
              </div>
              <div class="leading-tight">
                <div class="text-[12px] text-gray-500 font-medium">Need Help?</div>
                <div class="text-[14px] font-bold text-gray-900">+001 123 456 789</div>
              </div>
            </div>
            
            <div class="flex items-center space-x-3">
              <a href="#" class="w-10 h-10 rounded-full bg-[#F4F7FF] flex items-center justify-center text-gray-600 hover:text-blue-600 hover:bg-blue-50 transition-colors relative">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                </svg>
              </a>
              <a href="#" class="w-10 h-10 rounded-full bg-[#F4F7FF] flex items-center justify-center text-gray-600 hover:text-blue-600 hover:bg-blue-50 transition-colors relative">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
                </svg>
                <span class="absolute top-0 right-0 transform translate-x-1/4 -translate-y-1/4 bg-blue-600 text-white text-[10px] font-bold rounded-full w-[18px] h-[18px] flex items-center justify-center border-2 border-white">1</span>
              </a>
              <a href="#" class="w-10 h-10 rounded-full bg-[#F4F7FF] flex items-center justify-center text-gray-600 hover:text-blue-600 hover:bg-blue-50 transition-colors relative">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
                </svg>
                <span class="absolute top-0 right-0 transform translate-x-1/4 -translate-y-1/4 bg-blue-600 text-white text-[10px] font-bold rounded-full w-[18px] h-[18px] flex items-center justify-center border-2 border-white">1</span>
              </a>
            </div>
          </div>
        </div>
      </div>
    </header>

    <!-- Category Bar -->
    <div class="border-b border-gray-100 hidden lg:block bg-white">
       <div class="container mx-auto px-4 sm:px-6 lg:px-8 max-w-[1200px]">
         <div class="flex items-center h-[56px]">
           <!-- All Categories Dropdown Button -->
           <button class="bg-blue-600 text-white px-5 flex items-center justify-between font-medium h-full w-[260px] hover:bg-blue-700 transition-colors relative top-[1px]">
             <div class="flex items-center">
               <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                 <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
               </svg>
               <span class="ml-3 text-[15px]">All categories</span>
             </div>
             <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
               <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
             </svg>
           </button>
           
           <!-- Navigation Links -->
           <nav class="flex-1 ml-8">
             <ul class="flex space-x-7 text-[15px] font-medium text-gray-500">
               <li><a href="#" class="text-blue-600">Mens</a></li>
               <li><a href="#" class="hover:text-blue-600 transition-colors">Womens</a></li>
               <li><a href="#" class="hover:text-blue-600 transition-colors">Kids</a></li>
               <li><a href="#" class="hover:text-blue-600 transition-colors">Electronic Items</a></li>
               <li><a href="#" class="hover:text-blue-600 transition-colors">Kitchen Accessories</a></li>
               <li><a href="#" class="hover:text-blue-600 transition-colors">News & Blogs</a></li>
               <li><a href="#" class="hover:text-blue-600 transition-colors">Contact Us</a></li>
             </ul>
           </nav>
         </div>
       </div>
    </div>

    <!-- Main Workspace -->
    <main class="flex-1 bg-white">
      <div class="container mx-auto px-4 sm:px-6 lg:px-8 max-w-[1200px] py-8 lg:py-10">
        
        <!-- Mobile Search (Visible only on small screens) -->
        <div class="lg:hidden mb-6">
            <div class="flex w-full bg-[#F4F7FF] border border-gray-200 rounded-[5px] overflow-hidden">
              <input type="text" placeholder="I'm shopping for..." class="flex-1 bg-transparent px-4 py-3 text-[15px] outline-none placeholder-gray-400 text-gray-700" />
              <button class="bg-blue-600 text-white px-5 hover:bg-blue-700 transition-colors flex items-center justify-center">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                </svg>
              </button>
            </div>
        </div>

        <div class="flex flex-col lg:flex-row gap-8 items-start">
          
          <!-- Vertical Sidebar Menu -->
          <div class="w-full lg:w-[260px] flex-shrink-0 hidden lg:block border border-gray-100 rounded-md py-3 shadow-sm bg-white">
            <ul class="text-[15px] text-gray-500 font-medium">
              <li><a href="#" class="flex justify-between items-center px-6 py-[10px] hover:text-blue-600 transition-colors">Arts & Crafts</a></li>
              <li>
                <a href="#" class="flex justify-between items-center px-6 py-[10px] text-blue-600 bg-blue-50/50">
                  Fashion 
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
                  </svg>
                </a>
              </li>
              <li><a href="#" class="flex justify-between items-center px-6 py-[10px] hover:text-blue-600 transition-colors">Bages & Shoes</a></li>
              <li><a href="#" class="flex justify-between items-center px-6 py-[10px] hover:text-blue-600 transition-colors">Jewelry & Watch</a></li>
              <li><a href="#" class="flex justify-between items-center px-6 py-[10px] hover:text-blue-600 transition-colors">Beauty & Health</a></li>
              <li><a href="#" class="flex justify-between items-center px-6 py-[10px] hover:text-blue-600 transition-colors">Electronics</a></li>
            </ul>
          </div>

          <!-- Sub-menu & Banner Area -->
          <div class="flex-1 border border-gray-100 rounded-md p-6 lg:p-10 bg-white shadow-[0_4px_30px_rgba(0,0,0,0.03)] flex flex-col md:flex-row gap-8 lg:gap-12 w-full justify-between items-center md:items-stretch">
            
            <!-- Lists -->
            <div class="flex flex-1 gap-8 sm:gap-16 w-full">
              <!-- New Arrivals -->
              <div class="flex-1">
                <h3 class="font-bold text-[#111827] text-[16px] mb-5">New Arrivals</h3>
                <ul class="space-y-[14px] text-[15px] text-gray-500 font-medium">
                  <li><a href="#" class="hover:text-blue-600 transition-colors">Dressess</a></li>
                  <li><a href="#" class="text-blue-600">Jackets</a></li>
                  <li><a href="#" class="hover:text-blue-600 transition-colors">Sweatshirts</a></li>
                  <li><a href="#" class="hover:text-blue-600 transition-colors">Tops & Tees</a></li>
                  <li><a href="#" class="hover:text-blue-600 transition-colors">Party Dressess</a></li>
                  <li><a href="#" class="hover:text-blue-600 transition-colors">Electronics</a></li>
                </ul>
              </div>
              
              <!-- Trending -->
              <div class="flex-1">
                <h3 class="font-bold text-[#111827] text-[16px] mb-5">Trending</h3>
                <ul class="space-y-[14px] text-[15px] text-gray-500 font-medium">
                  <li><a href="#" class="hover:text-blue-600 transition-colors">Pants</a></li>
                  <li><a href="#" class="hover:text-blue-600 transition-colors">Accessories</a></li>
                  <li><a href="#" class="hover:text-blue-600 transition-colors">Tops & Tees</a></li>
                  <li><a href="#" class="hover:text-blue-600 transition-colors">Casual Shorts</a></li>
                  <li><a href="#" class="hover:text-blue-600 transition-colors">Jeans</a></li>
                  <li><a href="#" class="hover:text-blue-600 transition-colors">Electronics</a></li>
                </ul>
              </div>
            </div>

            <!-- Promotion Banner -->
            <div class="w-full md:w-[280px] h-[280px] bg-[#8B9FF0] rounded-lg relative overflow-hidden flex flex-col items-center justify-center text-white text-center flex-shrink-0 group">
               <!-- Mocking the background from the image using gradients and simple CSS shapes to look premium -->
               <div class="absolute inset-0 bg-gradient-to-b from-[#8B9FF0] to-[#637DEB] z-0"></div>
               
               <!-- Subtle background decoration (mocking the chair/stand outline) -->
               <svg class="absolute bottom-0 w-full opacity-30 text-white z-0" viewBox="0 0 100 100" preserveAspectRatio="none">
                 <path d="M30 100 L45 40 L55 40 L70 100" stroke="currentColor" stroke-width="2" fill="none"/>
                 <path d="M40 70 L60 70" stroke="currentColor" stroke-width="2" />
               </svg>

               <div class="relative z-10 p-6 flex flex-col items-center justify-center h-full w-full">
                 <div class="text-[42px] font-bold leading-tight mb-1 drop-shadow-md">50%</div>
                 <div class="text-[18px] font-semibold mb-6 drop-shadow-md">Flat Discount</div>
                 <a href="#" class="bg-blue-600 hover:bg-blue-700 text-white text-[14px] font-medium px-6 py-2.5 rounded shadow-lg transform transition-transform hover:-translate-y-0.5">
                   Shop Now
                 </a>
               </div>
            </div>
          </div>
          
        </div>
      </div>
    </main>
  </body>
</html>
