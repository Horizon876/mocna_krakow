---
import BaseLayout from "@layouts/BaseLayout.astro";
import { db } from "../../../db";
import { events } from "../../../db/schema";
import { eq } from "drizzle-orm";
import { COLORS } from "@data/site";

const { eventId } = Astro.params;

const [event] = await db.select().from(events).where(eq(events.id, eventId!));

if (!event || event.status !== 'active') {
  return Astro.redirect('/wydarzenia');
}

const dateObj = new Date(event.eventDate);
const dataStr = dateObj.toLocaleDateString('pl-PL', { day: '2-digit', month: 'long', year: 'numeric' });
const godzinaStr = dateObj.toLocaleTimeString('pl-PL', { hour: '2-digit', minute: '2-digit' });
const cenaJednostkowa = (event.ticketPrice / 100).toFixed(0);
const dostepneMiejsca = event.seatLimit - event.enrolledCount;
const isBezplatne = event.ticketPrice === 0;
---

<BaseLayout title={`Kup bilet: ${event.title} — MOCna!`}>
  <div class="checkout-page home-page pb-20 pt-16 sm:pb-28 sm:pt-24 min-h-screen">
    <div class="shell max-w-3xl">

      <div class="border border-graphite-200 bg-white">
        <!-- Nagłówek wydarzenia -->
        <div 
          class="p-6 sm:p-8 border-b border-graphite-200 flex gap-5 items-start"
          style={`border-left: 4px solid ${COLORS[(event.color as keyof typeof COLORS)] || COLORS.orange};`}
        >
          {event.imageUrl && (
            <img 
              src={event.imageUrl} 
              alt={event.imageAlt || event.title}
              class="w-20 h-20 object-cover shrink-0 hidden sm:block border border-graphite-200"
            />
          )}
          <div class="flex-1 min-w-0">
            <span class="text-xs font-bold uppercase tracking-widest text-graphite-muted">{event.kategoria}</span>
            <h1 class="text-xl sm:text-2xl font-bold text-graphite mt-1">{event.title}</h1>
            <div class="flex flex-wrap gap-4 mt-2 text-sm text-graphite-muted">
              <span class="flex items-center gap-1.5">
                <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/>
                </svg>
                {dataStr} o {godzinaStr}
              </span>
              <span class="flex items-center gap-1.5">
                <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>
                </svg>
                {dostepneMiejsca} wolnych miejsc
              </span>
            </div>
          </div>
        </div>

        <div class="p-6 sm:p-8">
          {dostepneMiejsca <= 0 ? (
            <div class="text-center py-10">
              <p class="text-xl font-bold text-graphite">Brak wolnych miejsc</p>
              <p class="mt-2 text-graphite-muted">Wszystkie bilety na to wydarzenie zostały wyprzedane.</p>
              <a href="/wydarzenia" class="btn-orange mt-6 inline-flex">Sprawdź inne wydarzenia</a>
            </div>
          ) : (
            <form id="ticket-form" data-event-id={eventId} data-max={dostepneMiejsca} data-price={event.ticketPrice}>
              <div class="space-y-6">
                <!-- Wybór ilości -->
                <div>
                  <label class="block text-sm font-medium text-graphite-muted mb-3">
                    Liczba biletów
                  </label>
                  <div class="flex items-center gap-4">
                    <button 
                      type="button" 
                      id="qty-minus"
                      class="w-11 h-11 border border-graphite-200 flex items-center justify-center text-xl font-bold text-graphite hover:bg-graphite-50 transition-colors"
                      aria-label="Zmniejsz ilość"
                    >−</button>
                    <span id="qty-display" class="text-3xl font-black text-graphite w-10 text-center">1</span>
                    <button 
                      type="button" 
                      id="qty-plus"
                      class="w-11 h-11 border border-graphite-200 flex items-center justify-center text-xl font-bold text-graphite hover:bg-graphite-50 transition-colors"
                      aria-label="Zwiększ ilość"
                    >+</button>
                    <input type="hidden" id="qty-input" name="quantity" value="1" />
                  </div>
                </div>

                <!-- Podsumowanie ceny -->
                <div class="border border-graphite-100 bg-[#fff8f0] p-5">
                  {isBezplatne ? (
                    <div class="flex justify-between items-center">
                      <span class="text-graphite-muted font-medium">Łącznie</span>
                      <span class="text-2xl font-black text-green">Bezpłatne</span>
                    </div>
                  ) : (
                    <div class="space-y-2">
                      <div class="flex justify-between text-sm text-graphite-muted">
                        <span><span id="price-qty">1</span> × {cenaJednostkowa} zł</span>
                        <span id="price-subtotal">{cenaJednostkowa} zł</span>
                      </div>
                      <div class="flex justify-between items-center border-t border-graphite-200 pt-2">
                        <span class="font-bold text-graphite">Łącznie</span>
                        <span class="text-2xl font-black text-blue" id="price-total">{cenaJednostkowa} zł</span>
                      </div>
                    </div>
                  )}
                </div>

                <button 
                  type="submit" 
                  class="btn-orange w-full justify-center py-4 text-lg"
                >
                  Dalej
                  <svg class="ml-2 h-5 w-5 inline-block" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                  </svg>
                </button>
              </div>
            </form>
          )}
        </div>
      </div>

    </div>
  </div>
</BaseLayout>

<script>
  import { patchTicketDraft } from "../../../scripts/ticket-draft";

  function init() {
    const form = document.getElementById("ticket-form") as HTMLFormElement | null;
    if (!form) return;

    const eventId = form.dataset.eventId!;
    const maxQty = parseInt(form.dataset.max || "20");
    const unitPrice = parseInt(form.dataset.price || "0");

    const qtyDisplay = document.getElementById("qty-display")!;
    const qtyInput = document.getElementById("qty-input") as HTMLInputElement;
    const minusBtn = document.getElementById("qty-minus") as HTMLButtonElement;
    const plusBtn = document.getElementById("qty-plus") as HTMLButtonElement;
    const priceQty = document.getElementById("price-qty");
    const priceSubtotal = document.getElementById("price-subtotal");
    const priceTotal = document.getElementById("price-total");

    let qty = 1;

    function updateDisplay() {
      qtyDisplay.textContent = String(qty);
      qtyInput.value = String(qty);
      minusBtn.disabled = qty <= 1;
      plusBtn.disabled = qty >= maxQty;

      if (priceQty) priceQty.textContent = String(qty);
      if (priceSubtotal && priceTotal) {
        const total = unitPrice * qty / 100;
        const formatted = total.toFixed(0) + " zł";
        priceSubtotal.textContent = formatted;
        priceTotal.textContent = formatted;
      }
    }

    minusBtn.addEventListener("click", () => { if (qty > 1) { qty--; updateDisplay(); } });
    plusBtn.addEventListener("click", () => { if (qty < maxQty) { qty++; updateDisplay(); } });
    updateDisplay();

    form.addEventListener("submit", (e) => {
      e.preventDefault();
      patchTicketDraft({ eventId, quantity: qty });
      window.location.href = `/bilety/${eventId}/dane`;
    });
  }

  document.addEventListener("astro:page-load", init);
  if (document.readyState !== "loading") init();
</script>
