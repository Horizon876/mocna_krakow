---
import BaseLayout from "@layouts/BaseLayout.astro";
import SectionHeading from "@components/SectionHeading.astro";
import { db } from "../db";
import { products as dbProducts } from "../db/schema";
import { desc, eq } from "drizzle-orm";

const productsData = await db.select().from(dbProducts).where(eq(dbProducts.availabilityStatus, 'available')).orderBy(desc(dbProducts.createdAt));

// Format for template
const products = productsData.map(p => ({
  id: p.id,
  name: p.name,
  price: (p.price / 100).toFixed(2).replace('.', ',') + ' zł',
  tag: p.description,
  image: p.imageUrl
}));
---
<BaseLayout title="Sklep — MOCna!">
  <div class="home-page">
    <section class="relative scroll-mt-16 pt-10 pb-20 sm:scroll-mt-[4.5rem] sm:pt-12 sm:pb-28">
      <div class="shell">
        <SectionHeading
          title="<span class='text-orange'>Sk</span><span class='text-green'>lep</span> <span class='text-blue'>M</span><span class='text-red'>O</span><span class='text-yellow'>C</span><span class='text-green'>n</span><span class='text-pink'>e</span><span class='text-orange'>j</span>"
        />

        <ul class="mt-12 grid list-none gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {
            products.map((product) => (
              <li>
                <article
                  class="flex h-full flex-col overflow-hidden border border-graphite-200 bg-white"
                  data-product-card
                  data-product-id={product.id}
                  data-product-name={product.name}
                  data-product-price={product.price}
                  data-product-image={product.image ?? ""}
                >
                  {
                    product.image ? (
                      <img
                        src={product.image}
                        alt={product.name}
                        class="aspect-[4/3] w-full object-cover"
                        loading="lazy"
                        width="640"
                        height="480"
                      />
                    ) : (
                      <div
                        class="aspect-[4/3]"
                        style={`background:#2c5ea918`}
                        aria-hidden="true"
                      ></div>
                    )
                  }
                  <div class="flex flex-1 flex-col p-5 sm:p-6">
                    <h3 class="text-fluid-lg font-bold text-graphite">{product.name}</h3>
                    <p class="mt-2 font-display text-fluid-xl font-bold tracking-tightest text-graphite">
                      {product.price}
                    </p>

                    <div class="mt-5 flex flex-col gap-3">
                      <div class="flex items-center justify-between gap-3">
                        <span class="text-sm font-medium text-graphite-muted">Ilość</span>
                        <div class="flex items-center border border-graphite-200">
                          <button
                            type="button"
                            data-qty-minus
                            class="grid h-10 w-10 place-items-center text-lg leading-none text-graphite transition-colors hover:bg-graphite-100"
                            aria-label="Zmniejsz ilość"
                          >
                            −
                          </button>
                          <input
                            type="number"
                            data-qty
                            min="1"
                            max="99"
                            step="1"
                            value="1"
                            inputmode="numeric"
                            aria-label={`Ilość — ${product.name}`}
                            class="shop-qty-input h-10 w-14 border-x border-graphite-200 bg-white text-center text-sm font-medium text-graphite focus:outline-none focus:ring-2 focus:ring-inset focus:ring-blue/30"
                          />
                          <button
                            type="button"
                            data-qty-plus
                            class="grid h-10 w-10 place-items-center text-lg leading-none text-graphite transition-colors hover:bg-graphite-100"
                            aria-label="Zwiększ ilość"
                          >
                            +
                          </button>
                        </div>
                      </div>

                      <button type="button" data-add-to-cart class="shop-add-btn btn-orange w-full justify-center">
                        <span data-add-default class="shop-add-label inline-flex items-center gap-2.5">
                          <svg
                            class="h-5 w-5 shrink-0"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="1.6"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            aria-hidden="true"
                          >
                            <path d="M6 6h15l-1.5 9h-12z"></path>
                            <path d="M6 6l-1.2-3H2"></path>
                            <circle cx="9" cy="20" r="1"></circle>
                            <circle cx="18" cy="20" r="1"></circle>
                          </svg>
                          Dodaj do koszyka
                        </span>
                        <span data-add-success class="shop-add-label shop-add-label--success" aria-hidden="true">
                          <svg
                            class="shop-add-check h-5 w-5 shrink-0"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2.2"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            aria-hidden="true"
                          >
                            <path d="M5 12.5 10 17.5 19 7.5"></path>
                          </svg>
                          Dodano!
                        </span>
                      </button>
                    </div>
                  </div>
                </article>
              </li>
            ))
          }
        </ul>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .shop-qty-input::-webkit-outer-spin-button,
  .shop-qty-input::-webkit-inner-spin-button {
    -webkit-appearance: none;
    margin: 0;
  }

  .shop-qty-input {
    appearance: textfield;
    -moz-appearance: textfield;
  }

  .shop-add-btn {
    position: relative;
    overflow: hidden;
    transition:
      background-color 0.28s cubic-bezier(0.22, 1, 0.36, 1),
      border-color 0.28s cubic-bezier(0.22, 1, 0.36, 1),
      box-shadow 0.28s cubic-bezier(0.22, 1, 0.36, 1),
      transform 0.28s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .shop-add-label {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.625rem;
    transition:
      opacity 0.22s cubic-bezier(0.22, 1, 0.36, 1),
      transform 0.28s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .shop-add-label--success {
    position: absolute;
    inset: 0;
    opacity: 0;
    transform: translateY(10px) scale(0.96);
    pointer-events: none;
  }

  .shop-add-btn.is-added {
    animation: shop-add-pop 0.55s cubic-bezier(0.22, 1, 0.36, 1);
    background-color: #00955e;
    border-color: #00955e;
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.14);
    transform: translateY(-2px);
  }

  .shop-add-btn.is-added [data-add-default] {
    opacity: 0;
    transform: translateY(-10px) scale(0.96);
  }

  .shop-add-btn.is-added .shop-add-label--success {
    opacity: 1;
    transform: translateY(0) scale(1);
  }

  .shop-add-btn.is-added .shop-add-check {
    animation: shop-check-draw 0.42s cubic-bezier(0.22, 1, 0.36, 1) 0.06s both;
  }

  .shop-add-btn.is-added:hover {
    background-color: #007a4c;
    border-color: #007a4c;
  }

  @keyframes shop-add-pop {
    0% {
      transform: scale(1) translateY(0);
    }
    40% {
      transform: scale(1.03) translateY(-2px);
    }
    100% {
      transform: scale(1) translateY(-2px);
    }
  }

  @keyframes shop-check-draw {
    0% {
      opacity: 0;
      transform: scale(0.5) rotate(-12deg);
    }
    100% {
      opacity: 1;
      transform: scale(1) rotate(0deg);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .shop-add-btn,
    .shop-add-label,
    .shop-add-btn.is-added {
      animation: none !important;
      transition-duration: 0.001ms !important;
    }
  }
</style>

<script src="../scripts/shop.ts"></script>
