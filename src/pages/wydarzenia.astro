---
import BaseLayout from "@layouts/BaseLayout.astro";
import PageHero from "@components/PageHero.astro";
import BrandBlobs from "@components/BrandBlobs.astro";
import { COLORS } from "@data/site";
import { db } from "../db";
import { events } from "../db/schema";
import { desc, eq, and, gte } from "drizzle-orm";

// Fetch only active events, sorted by date (upcoming first)
// Optionally we could filter out past events: gte(events.eventDate, new Date())
const dbEvents = await db.select()
  .from(events)
  .where(eq(events.status, 'active'))
  .orderBy(events.eventDate);

const wydarzenia = dbEvents.map(e => {
  const dateObj = new Date(e.eventDate);
  const data = dateObj.toLocaleDateString('pl-PL', { day: '2-digit', month: '2-digit', year: 'numeric' });
  const godzina = dateObj.toLocaleTimeString('pl-PL', { hour: '2-digit', minute: '2-digit' });
  const cena = e.ticketPrice === 0 ? "Bezpłatne" : `${(e.ticketPrice / 100).toFixed(0)}zł`;

  const hasInternalTickets = !e.link;
  const ticketLink = hasInternalTickets ? `/bilety/${e.id}` : (e.link || "/kontakt");
  const available = e.seatLimit - e.enrolledCount;

  return {
    id: e.id,
    title: e.title,
    kategoria: e.kategoria || "Wydarzenie",
    data,
    godzina,
    cena,
    opis: e.longDescription || e.shortDescription || "",
    image: e.imageUrl || "/media/jan_wojdak_concert.png",
    imageAlt: e.imageAlt || `Plakat wydarzenia: ${e.title}`,
    color: (e.color as keyof typeof COLORS) || "orange",
    link: ticketLink,
    hasInternalTickets,
    available,
  };
});
---

<BaseLayout title="Wydarzenia — MOCna!">
  <div class="home-page flex min-h-full flex-1 flex-col">

    <PageHero
      title="Nadchodzące <span class='text-orange'>wydarzenia</span>"
      variant="warm"
      animated={false}
    />

    <section class="relative py-16 sm:py-24">
      <BrandBlobs variant="soft" animated={false} />
      <div class="shell relative">

        <div class="flex flex-col gap-10">
          {wydarzenia.map((e) => (
            <article 
              class="event-card grid grid-cols-1 md:grid-cols-12 border border-graphite-200 bg-white"
              style={`--accent: ${COLORS[e.color] || COLORS.orange};`}
            >
              {/* Zdjęcie */}
              <div class="md:col-span-6 lg:col-span-5 relative min-h-[280px] md:min-h-0 md:h-full">
                <img
                  src={e.image}
                  alt={e.imageAlt}
                  class="absolute inset-0 w-full h-full object-cover"
                  loading="eager"
                  decoding="async"
                />
              </div>

              {/* Treść */}
              <div class="md:col-span-6 lg:col-span-7 flex flex-col justify-between p-6 sm:p-8 lg:p-10 font-sans min-h-[300px] md:min-h-0">
                <div>
                  {/* Kategoria i Meta */}
                  <div class="flex flex-wrap items-center gap-3 mb-4">
                    <span 
                      class="text-xs font-bold uppercase tracking-[0.15em] px-3 py-1 text-white border"
                      style={`background-color: var(--accent); border-color: var(--accent);`}
                    >
                      {e.kategoria}
                    </span>
                    
                    <span class="text-xs text-graphite-soft font-semibold flex items-center gap-1.5">
                      <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/>
                        <line x1="16" y1="2" x2="16" y2="6"/>
                        <line x1="8" y1="2" x2="8" y2="6"/>
                        <line x1="3" y1="10" x2="21" y2="10"/>
                      </svg>
                      {e.data}
                    </span>

                    <span class="text-xs text-graphite-soft font-semibold flex items-center gap-1.5">
                      <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <circle cx="12" cy="12" r="10"/>
                        <polyline points="12 6 12 12 16 14"/>
                      </svg>
                      {e.godzina}
                    </span>
                  </div>

                  <h2 class="text-fluid-xl font-display font-bold leading-tight tracking-tightest text-graphite mb-4">
                    {e.title}
                  </h2>
                  <p class="text-fluid-sm leading-relaxed text-graphite-soft text-pretty">
                    {e.opis}
                  </p>
                </div>

                {/* Dolna sekcja: Cena i Przycisk */}
                <div class="mt-8 pt-6 border-t border-graphite-100 flex flex-wrap items-center justify-between gap-4">
                  <div class="flex flex-col">
                    <span class="text-xs text-graphite-muted uppercase tracking-wider font-semibold">Cena biletu</span>
                    <span class="text-fluid-lg font-display font-extrabold text-graphite">{e.cena}</span>
                  </div>
                  
                  {e.available <= 0 ? (
                    <span class="btn border border-graphite-200 bg-graphite-50 text-graphite-muted font-bold text-xs uppercase tracking-wider px-8 py-3.5 cursor-not-allowed">
                      Wyprzedane
                    </span>
                  ) : (
                    <a
                      href={e.link}
                      class="btn bg-blue text-white hover:bg-blue/90 font-bold text-xs uppercase tracking-wider px-8 py-3.5 flex items-center gap-2 transition-all"
                    >
                      {e.cena === "Bezpłatne" ? "Zapisz się" : "Kup bilet"}
                      <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                      </svg>
                    </a>
                  )}
                </div>
              </div>
            </article>
          ))}
        </div>

        {/* Pusty stan */}
        {wydarzenia.length === 0 && (
          <div class="text-center py-20 border border-dashed border-graphite-200 bg-white">
            <p class="text-graphite-soft font-medium">Aktualnie brak zaplanowanych wydarzeń. Sprawdź wkrótce!</p>
          </div>
        )}

      </div>
    </section>

  </div>
</BaseLayout>

<style>
  @media (min-width: 768px) {
    .event-card {
      height: 400px;
    }
  }
</style>
