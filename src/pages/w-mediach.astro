---
import BaseLayout from "@layouts/BaseLayout.astro";
import PageHero from "@components/PageHero.astro";
import MediaWall from "@components/MediaWall.astro";
import SectionHeading from "@components/SectionHeading.astro";
import { MEDIA, COLORS } from "@data/site";
---
<BaseLayout title="W mediach — MOCna!">
  <PageHero
    kicker="W mediach"
    title="Nasza historia <span class='text-orange'>niesie się dalej</span>"
    lead="Dziennikarze, portale i stacje opowiadają o MOCnej. Zebraliśmy najważniejsze materiały w jednym miejscu."
  />

  <MediaWall />

  <section class="pb-20">
    <div class="shell">
      <SectionHeading kicker="Materiały" title="Przeczytaj i <span class='text-orange'>posłuchaj</span>" />
      <div class="mt-8 grid gap-4 lg:grid-cols-2">
        {MEDIA.map((m) => (
          <a href={m.href} target="_blank" rel="noopener" class="group flex items-center gap-5 rounded-[24px] border border-graphite-200 bg-white p-6 transition-all duration-500 hover:-translate-y-1 hover:shadow-soft">
            <span class="grid h-16 w-16 shrink-0 place-items-center rounded-2xl font-display text-fluid-lg font-bold tracking-tightest text-white" style={`background:${COLORS[m.accent]}`}>{m.outlet.slice(0, 2)}</span>
            <div class="flex-1">
              <span class="text-xs font-medium uppercase tracking-[0.14em] text-graphite-muted">{m.outlet}</span>
              <h3 class="mt-1 text-fluid-lg font-display font-bold leading-tight tracking-tightest text-graphite">{m.title}</h3>
            </div>
            <span class="text-graphite-muted transition-all duration-300 group-hover:translate-x-1 group-hover:text-orange">↗</span>
          </a>
        ))}
      </div>

      <div class="mt-12 rounded-[28px] border border-graphite-200 bg-yellow-cream p-8 text-center">
        <p class="text-fluid-lg font-display font-bold tracking-tightest">Jesteś dziennikarzem?</p>
        <p class="mx-auto mt-2 max-w-xl text-fluid-sm text-graphite-soft">Chętnie opowiemy o ekonomii społecznej i specialty coffee. Materiały prasowe i zdjęcia wyślemy od ręki.</p>
        <a href="/kontakt" class="btn-orange mt-6">Skontaktuj się z nami</a>
      </div>
    </div>
  </section>
</BaseLayout>
