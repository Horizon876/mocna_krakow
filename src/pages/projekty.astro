---
import BaseLayout from "@layouts/BaseLayout.astro";
import PageHero from "@components/PageHero.astro";
import SectionHeading from "@components/SectionHeading.astro";
import { COLORS } from "@data/site";

const projects = [
  {
    title: "Miejsca pracy przy barze",
    tag: "Zatrudnienie wspierane",
    desc: "Stałe stanowiska w kawiarni — bar, obsługa, zaplecze. Praca dopasowana do możliwości i tempa każdej osoby.",
    href: "/o-mocnej",
    color: "orange",
  },
  {
    title: "Szkolenia i staże",
    tag: "Kompetencje",
    desc: "Warsztaty barista, obsługa gości i umiejętności miękkie. Budujemy pewność krok po kroku.",
    href: "/szkolenia",
    color: "blue",
  },
  {
    title: "Wydarzenia integracyjne",
    tag: "Społeczność",
    desc: "Koncerty, spotkania i warsztaty otwarte na sąsiedztwo — przestrzeń, w której spotykają się ludzie.",
    href: "/wydarzenia",
    color: "red",
  },
  {
    title: "Kawa zawieszona",
    tag: "Wsparcie",
    desc: "Mały gest gościa finansuje filiżankę dla kogoś, kogo nie stać. Prosty mechanizm realnej pomocy.",
    href: "/wesprzyj#zawieszona",
    color: "green",
  },
  {
    title: "Catering społeczny",
    tag: "Dla firm i instytucji",
    desc: "Kawa i przekąski na Wasze wydarzenie — z misją i jakością specialty w tle.",
    href: "/catering",
    color: "yellow",
  },
  {
    title: "Partnerstwa lokalne",
    tag: "Współpraca",
    desc: "Łączymy siły z firmami, szkołami i organizacjami. Szukamy partnerów, którzy chcą działać razem z nami.",
    href: "/kontakt",
    color: "pink",
  },
] as const;
---
<BaseLayout title="Projekty — MOCna!">
  <PageHero
    kicker="Projekty"
    title="To, co robimy <span class='text-orange'>na co dzień</span>"
    lead="MOCna! to więcej niż kawa. Prowadzimy projekty społeczne, które dają pracę, kompetencje i poczucie sprawczości."
    variant="soft"
  />

  <section class="py-12 sm:py-16">
    <div class="shell">
      <SectionHeading
        kicker="Nasze inicjatywy"
        title="Każdy projekt ma <span class='text-orange'>człowieka</span> w centrum"
      >
        <p class="mt-3 max-w-2xl text-fluid-sm text-graphite-soft">
          Poniżej znajdziesz główne obszary działania. Kliknij kartę, by dowiedzieć się więcej lub dołączyć.
        </p>
      </SectionHeading>

      <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {projects.map((p) => (
          <a
            href={p.href}
            class="group flex flex-col rounded-[26px] border border-graphite-200 bg-white p-7 transition-all duration-500 ease-organic hover:-translate-y-1.5 hover:shadow-soft"
            style={`border-top: 4px solid ${COLORS[p.color]}`}
          >
            <span
              class="text-[11px] font-bold uppercase tracking-[0.18em]"
              style={`color: ${COLORS[p.color]}`}
            >
              {p.tag}
            </span>
            <h3 class="mt-3 text-fluid-lg font-display font-bold tracking-tightest text-graphite transition-colors duration-300 group-hover:text-blue">
              {p.title}
            </h3>
            <p class="mt-2 flex-1 text-fluid-sm leading-relaxed text-graphite-soft">{p.desc}</p>
            <span class="mt-5 inline-flex items-center gap-1.5 text-[13px] font-semibold text-blue">
              Dowiedz się więcej
              <svg class="h-3.5 w-3.5 transition-transform duration-300 group-hover:translate-x-1" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M2.5 7h9M8 3.5 11.5 7 8 10.5"/>
              </svg>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="pb-20">
    <div class="shell rounded-[32px] bg-yellow-cream px-8 py-10 text-center sm:px-12 sm:py-14">
      <p class="text-fluid-xl font-display font-bold tracking-tightest text-graphite">
        Masz pomysł na wspólny projekt?
      </p>
      <p class="mx-auto mt-3 max-w-xl text-fluid-sm leading-relaxed text-graphite-soft">
        Instytucje, firmy i osoby prywatne — chętnie porozmawiamy o partnerstwie, które realnie wspiera naszą społeczność.
      </p>
      <a href="/kontakt" class="btn-orange mt-8">Napisz do nas</a>
    </div>
  </section>
</BaseLayout>
