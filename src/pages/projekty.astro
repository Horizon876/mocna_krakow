---
import BaseLayout from "@layouts/BaseLayout.astro";
import PageHero from "@components/PageHero.astro";
import BrandBlobs from "@components/BrandBlobs.astro";
import { COLORS } from "@data/site";
import { getProjects } from "@/lib/projects";

const projekty = await getProjects();

Astro.response.headers.set(
  "Cache-Control",
  "public, s-maxage=86400, stale-while-revalidate=604800",
);
---

<BaseLayout title="Projekty — MOCna!">
  <div class="page-surface flex min-h-full flex-1 flex-col">

    <PageHero
      title="<span class='text-blue'>N</span><span class='text-red'>a</span><span class='text-yellow'>s</span><span class='text-green'>ze</span> <span class='text-orange'>Pro</span><span class='text-green'>je</span><span class='text-blue'>kty</span>"
      variant="cool"
      animated={false}
    />

    <section class="page-surface relative overflow-hidden py-16 sm:py-24">
      <BrandBlobs variant="soft" animated={false} />
      <div class="shell relative">

        <div class="flex flex-col gap-10">
          {projekty.map((p) => {
            const ink = p.textColor === "black" ? "black" : "white";
            const textClass = ink === "black" ? "text-graphite" : "text-white";
            const softClass = ink === "black" ? "text-graphite/80" : "text-white/90";
            const lineClass = ink === "black" ? "border-graphite/25" : "border-white/30";
            const markerClass = ink === "black" ? "marker:text-graphite" : "marker:text-white";
            return (
              <article
                class="project-card flex flex-col lg:flex-row gap-10 lg:gap-16 items-start border-2 p-8 sm:p-12"
                style={`--accent: ${COLORS[p.color] ?? COLORS.blue};`}
              >
                <div class:list={["flex-1 min-w-0 flex flex-col gap-6 font-sans", textClass]}>
                  <div>
                    <h2 class:list={["text-fluid-xl font-display font-bold leading-tight tracking-tightest text-balance", textClass]}>
                      {p.title}
                    </h2>
                  </div>

                  <div class="flex flex-col gap-4">
                    <p class:list={["text-fluid-sm leading-relaxed text-pretty font-semibold", textClass]}>
                      {p.opis}
                    </p>

                    {p.punkty && p.punkty.length > 0 && (
                      <ul class:list={["list-disc pl-5 text-fluid-sm leading-relaxed text-pretty flex flex-col gap-2 font-semibold", textClass, markerClass]}>
                        {p.punkty.map((punkt) => (
                          <li>{punkt}</li>
                        ))}
                      </ul>
                    )}

                    {p.dodatkowyOpis && (
                      <p class:list={["text-fluid-sm leading-relaxed text-pretty font-semibold", textClass]}>
                        {p.dodatkowyOpis}
                      </p>
                    )}
                  </div>

                  {p.logo && (
                    <div class="bg-white p-0 border border-white/10 flex items-center justify-center h-32 w-full overflow-hidden">
                      <img
                        src={p.logo}
                        alt={p.logoAlt || p.title}
                        class:list={["h-full w-full object-contain", p.logoClass]}
                        style={p.logoPosition ? `object-position: ${p.logoPosition}` : undefined}
                        loading="lazy"
                      />
                    </div>
                  )}

                  {p.finansowanie && (
                    <p class:list={["text-[11.5px] leading-relaxed text-pretty border-t pt-3 italic font-semibold", softClass, lineClass]}>
                      {p.finansowanie}
                    </p>
                  )}
                </div>

                <div class="shrink-0 lg:w-[24rem] w-full flex flex-col gap-6 justify-between self-stretch">
                  <div class="flex flex-col gap-6 font-sans">
                    {p.meta.length > 0 && (
                      <div class="border border-graphite-200 bg-white text-graphite">
                        <div class="border-b border-graphite-200 bg-graphite-50 px-5 py-3">
                          <span class="text-xs font-bold uppercase tracking-[0.15em] text-graphite">
                            {p.metaTitle || "Dofinansowanie"}
                          </span>
                        </div>
                        <dl>
                          {p.meta.map((m) => (
                            <div class="flex flex-col sm:flex-row sm:justify-between sm:items-center gap-1 sm:gap-4 px-5 py-3.5 border-b border-graphite-100 last:border-b-0">
                              <dt class="text-[11px] uppercase tracking-wider font-bold text-graphite-muted sm:whitespace-nowrap">{m.label}</dt>
                              <dd class="text-sm font-extrabold text-graphite sm:text-right">{m.value}</dd>
                            </div>
                          ))}
                        </dl>
                      </div>
                    )}
                  </div>

                  {p.link && (
                    <div class="flex flex-col gap-3 font-sans">
                      <a
                        href={p.link}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="btn w-full py-4 text-center text-xs justify-center bg-white text-[color:var(--accent)] border border-transparent hover:bg-white/90 font-bold"
                      >
                        {p.linkLabel ?? "Zobacz relację"}
                        <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                        </svg>
                      </a>
                    </div>
                  )}
                </div>
              </article>
            );
          })}
        </div>

      </div>
    </section>

  </div>
</BaseLayout>

<style>
  .project-card {
    border-color: var(--accent);
    background-color: var(--accent);
  }
</style>
