---
import BaseLayout from "@layouts/BaseLayout.astro";
import PageHero from "@components/PageHero.astro";
import SectionHeading from "@components/SectionHeading.astro";
import { COLORS, BRAND } from "@data/site";

const roles = [
  { emoji: "🎪", title: "Wsparcie wydarzeń", desc: "Pomoc przy koncertach i warsztatach — od witania gości po porządki.", color: "orange" },
  { emoji: "📣", title: "Social media & foto", desc: "Tworzysz contentem? Pokaż MOC światu.", color: "red" },
  { emoji: "🧑‍🏫", title: "Mentoring", desc: "Dzielisz się wiedzą z naszym zespołem (kawa, biznes, kompetencje).", color: "blue" },
  { emoji: "🛠️", title: "Złota rączka", desc: "Drobne naprawy, ogródek, logistyka — ręce zawsze się przydadzą.", color: "green" },
] as const;
---
<BaseLayout title="Wolontariat — MOCna!">
  <PageHero
    kicker="Wolontariat"
    title="Masz trochę czasu i <span class='text-orange'>dużo serca?</span>"
    lead="Wolontariusze są częścią rodziny MOCnej. Niezależnie od tego, co potrafisz — znajdzie się dla Ciebie miejsce."
    variant="soft"
  />

  <section class="py-12 sm:py-16">
    <div class="shell grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {roles.map((r) => (
        <article class="rounded-[26px] border border-graphite-200 bg-white p-7 transition-transform duration-500 hover:-translate-y-1" style={`border-top:4px solid ${COLORS[r.color]}`}>
          <span class="text-4xl">{r.emoji}</span>
          <h3 class="mt-4 text-fluid-lg font-display font-bold tracking-tightest">{r.title}</h3>
          <p class="mt-2 text-fluid-sm text-graphite-soft">{r.desc}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="pb-20">
    <div class="shell grid items-center gap-8 rounded-[32px] bg-graphite p-8 text-white sm:p-12 lg:grid-cols-2">
      <div>
        <SectionHeading kicker="Dołącz" title="Zgłoś się <span class='text-orange'>w minutę</span>" />
        <p class="mt-4 text-fluid-sm text-white/75">Napisz kilka słów o sobie — oddzwonimy lub odpiszemy. Bez CV, bez stresu. Liczy się chęć.</p>
        <ul class="mt-6 space-y-2 text-fluid-sm text-white/85">
          <li>✦ Elastyczne godziny — dopasujemy się.</li>
          <li>✦ Realny wpływ i wdzięczność zespołu.</li>
          <li>✦ Kawa w czasie dyżuru oczywiście na nas ☕</li>
        </ul>
      </div>
      <form class="grid gap-4 rounded-[24px] bg-white/10 p-6 backdrop-blur" data-volunteer>
        <input required placeholder="Imię" class="rounded-2xl border border-white/20 bg-white/10 px-4 py-3 text-fluid-sm text-white placeholder:text-white/50 focus:border-orange focus:outline-none" />
        <input required type="email" placeholder="E-mail" class="rounded-2xl border border-white/20 bg-white/10 px-4 py-3 text-fluid-sm text-white placeholder:text-white/50 focus:border-orange focus:outline-none" />
        <textarea rows="3" placeholder="W czym chcesz pomóc?" class="rounded-2xl border border-white/20 bg-white/10 px-4 py-3 text-fluid-sm text-white placeholder:text-white/50 focus:border-orange focus:outline-none"></textarea>
        <button type="submit" class="btn-orange justify-center">Chcę pomagać 🧡</button>
        <p class="hidden text-center text-fluid-sm font-medium text-green-soft" data-ok>Dziękujemy! Odezwiemy się wkrótce 💛</p>
      </form>
    </div>
    <p class="shell mt-6 text-center text-fluid-sm text-graphite-muted">Wolisz mailowo? Pisz na <a href={`mailto:${BRAND.email}`} class="font-medium text-orange hover:underline">{BRAND.email}</a></p>
  </section>
</BaseLayout>

<script>
  function initVol() {
    document.querySelectorAll("[data-volunteer]").forEach((form) => {
      form.addEventListener("submit", (e) => {
        e.preventDefault();
        form.querySelector("[data-ok]")?.classList.remove("hidden");
        form.querySelector("button")?.setAttribute("disabled", "true");
      });
    });
  }
  initVol();
  document.addEventListener("astro:after-swap", initVol);
</script>
