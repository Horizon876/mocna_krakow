---
import AdminLayout from "@layouts/AdminLayout.astro";
import { db } from "../../db";
import { orders as dbOrders } from "../../db/schema";
import { desc } from "drizzle-orm";
import { formatPln } from "../../scripts/cart";

const allOrders = await db.select().from(dbOrders).orderBy(desc(dbOrders.createdAt));

const filterStatus = Astro.url.searchParams.get("status") ?? "all";
const filterShipping = Astro.url.searchParams.get("shipping") ?? "all";
const filterPayment = Astro.url.searchParams.get("payment") ?? "all";
const searchQuery = Astro.url.searchParams.get("search")?.toLowerCase() ?? "";

const filteredOrders = allOrders.filter((order) => {
  if (filterStatus !== "all" && order.status !== filterStatus) return false;
  if (filterShipping !== "all" && order.shippingMethod !== filterShipping) return false;
  if (filterPayment !== "all" && order.paymentMethod !== filterPayment) return false;
  if (searchQuery) {
    const q = searchQuery.toLowerCase();
    const orderUuidPart = order.id.split('-')[0].toLowerCase();
    const orderNumberStr = String(order.orderNumber || '').padStart(4, '0');
    const orderFullStr = `${orderUuidPart}-${orderNumberStr}`;
    const matchesSearch =
      orderFullStr.includes(q) ||
      orderUuidPart.includes(q) ||
      orderNumberStr.includes(q) ||
      order.firstName.toLowerCase().includes(q) ||
      order.lastName.toLowerCase().includes(q) ||
      order.email.toLowerCase().includes(q);
    if (!matchesSearch) return false;
  }
  return true;
});

const statusMap: Record<string, string> = {
  pending:    "Złożone",
  confirmed:  "Potwierdzone",
  paid:       "Opłacone",
  processing: "W realizacji",
  shipped:    "Wysłane",
  cancelled:  "Anulowane",
};

const statusColors: Record<string, string> = {
  pending:    "bg-orange text-white border-orange",
  confirmed:  "bg-green text-white border-green",
  paid:       "bg-green text-white border-green",
  processing: "bg-blue text-white border-blue",
  shipped:    "bg-blue text-white border-blue",
  cancelled:  "bg-red text-white border-red",
};

const CANCELLABLE = new Set(["pending", "confirmed", "paid", "processing"]);
---

<AdminLayout title="Zarządzanie zamówieniami - Panel Admina" activeTab="zamowienia">
  <div class="mb-6 flex flex-col justify-between gap-4 sm:flex-row sm:items-end">
    <div>
      <h1 class="text-3xl font-bold tracking-tight text-graphite">Zamówienia</h1>
      <p class="mt-1.5 text-sm text-graphite-muted">Przeglądaj zamówienia, filtruj, przenoś do realizacji i anuluj.</p>
    </div>
  </div>

  <form method="GET" action="/admin/zamowienia" class="mb-6 flex flex-wrap items-end gap-3">
    <div class="w-full sm:w-44">
      <label class="field-label mb-1 block text-xs font-semibold text-graphite-muted" for="f-status">Status</label>
      <select id="f-status" name="status" class="field-input orders-filter w-full">
        <option value="all" selected={filterStatus === "all"}>Wszystkie</option>
        {Object.entries(statusMap).map(([val, label]) => (
          <option value={val} selected={filterStatus === val}>{label}</option>
        ))}
      </select>
    </div>
    <div class="w-full sm:w-44">
      <label class="field-label mb-1 block text-xs font-semibold text-graphite-muted" for="f-shipping">Dostawa</label>
      <select id="f-shipping" name="shipping" class="field-input orders-filter w-full">
        <option value="all" selected={filterShipping === "all"}>Wszystkie</option>
        <option value="courier" selected={filterShipping === "courier"}>Kurier</option>
        <option value="paczkomat" selected={filterShipping === "paczkomat"}>Paczkomat</option>
      </select>
    </div>
    <div class="w-full sm:w-44">
      <label class="field-label mb-1 block text-xs font-semibold text-graphite-muted" for="f-payment">Płatność</label>
      <select id="f-payment" name="payment" class="field-input orders-filter w-full">
        <option value="all" selected={filterPayment === "all"}>Wszystkie</option>
        <option value="online" selected={filterPayment === "online"}>Online</option>
        <option value="cod" selected={filterPayment === "cod"}>Za pobraniem</option>
      </select>
    </div>
    <div class="w-full sm:w-44">
      <label class="field-label mb-1 block text-xs font-semibold text-graphite-muted" for="f-search">Wyszukaj</label>
      <input
        type="text"
        id="f-search"
        name="search"
        value={Astro.url.searchParams.get('search') ?? ''}
        placeholder="Nr zamówienia, imię..."
        class="field-input orders-filter w-full text-sm"
      />
    </div>
    <div class="w-full sm:w-44">
      <label class="field-label mb-1 block invisible text-xs font-semibold text-graphite-muted" aria-hidden="true">Filtruj</label>
      <button type="submit" class="btn btn-orange orders-filter w-full text-sm">Szukaj</button>
    </div>
    {(filterStatus !== "all" || filterShipping !== "all" || filterPayment !== "all" || searchQuery) && (
      <div class="w-full sm:w-44">
        <label class="field-label mb-1 block invisible text-xs font-semibold text-graphite-muted" aria-hidden="true">Wyczyść</label>
        <a href="/admin/zamowienia" class="btn border border-graphite-200 bg-white text-graphite orders-filter w-full text-center text-sm">
          Wyczyść filtry
        </a>
      </div>
    )}
  </form>

  <p class="mb-4 text-sm text-graphite-muted">
    Wyświetlono {filteredOrders.length} z {allOrders.length} zamówień
  </p>

  <div class="admin-panel border border-graphite-200 bg-white">
    <div class="overflow-x-auto">
      <table class="w-full text-left text-sm">
        <thead class="border-b border-graphite-200 bg-graphite-50/50">
          <tr>
            <th class="px-5 py-4 font-semibold text-graphite">ID / Data</th>
            <th class="px-5 py-4 font-semibold text-graphite">Klient</th>
            <th class="px-5 py-4 font-semibold text-graphite">Koszyk</th>
            <th class="px-5 py-4 font-semibold text-graphite">Dostawa / Płatność</th>
            <th class="px-5 py-4 font-semibold text-graphite">Status</th>
            <th class="px-5 py-4 font-semibold text-graphite text-right">Akcje</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-graphite-100" id="orders-tbody">
          {filteredOrders.length === 0 ? (
            <tr>
              <td colspan="6" class="py-12 text-center text-graphite-muted">
                Brak zamówień dla wybranych filtrów.
              </td>
            </tr>
          ) : (
            filteredOrders.map((order) => {
              const items = JSON.parse(order.items);
              const dateStr = new Date(order.createdAt).toLocaleString("pl-PL", {
                day: "2-digit",
                month: "2-digit",
                year: "numeric",
                hour: "2-digit",
                minute: "2-digit",
              });

              let paczkomatInfo: { name?: string; addr?: string } | null = null;
              if (order.shippingMethod === "paczkomat" && order.paczkomatPoint) {
                try {
                  const p = JSON.parse(order.paczkomatPoint);
                  paczkomatInfo = {
                    name: p.name ?? p.id,
                    addr: [p.address?.line1, p.address?.city].filter(Boolean).join(", "),
                  };
                } catch {
                  paczkomatInfo = { name: order.paczkomatPoint };
                }
              }

              const statusClass = statusColors[order.status] ?? "bg-graphite text-white border-graphite";
              const canCancel = CANCELLABLE.has(order.status);

              return (
                <tr class="transition-colors hover:bg-graphite-50/50" data-order-row={order.id}>
                  <td class="px-5 py-4 align-top">
                    <span class="block font-mono text-base font-bold text-graphite">{order.id.split('-')[0]}-{String(order.orderNumber || '').padStart(4, '0')}</span>
                    <span class="block mt-1 font-medium text-graphite-muted text-xs">{dateStr}</span>
                  </td>

                  <td class="px-5 py-4 align-top">
                    <span class="block font-bold text-graphite">{order.firstName} {order.lastName}</span>
                    <a href={`mailto:${order.email}`} class="block mt-0.5 text-blue hover:underline text-xs">{order.email}</a>
                    <a href={`tel:${order.phone}`} class="block mt-0.5 text-graphite-muted hover:text-graphite text-xs">{order.phone}</a>
                  </td>

                  <td class="px-5 py-4 align-top">
                    <ul class="space-y-1.5 max-w-xs">
                      {items.map((it: { name: string; qty: number; price: string }) => (
                        <li class="flex justify-between gap-2 text-xs">
                          <span class="font-medium text-graphite truncate" title={it.name}>{it.qty}x {it.name}</span>
                          <span class="text-graphite-muted whitespace-nowrap">{it.price}</span>
                        </li>
                      ))}
                    </ul>
                    <div class="mt-3 pt-2 border-t border-graphite-100 font-bold text-graphite text-sm">
                      Razem: {formatPln(order.totalAmount / 100)}
                    </div>
                  </td>

                  <td class="px-5 py-4 align-top text-xs space-y-1">
                    <div class="font-medium text-graphite">
                      Dostawa:{" "}
                      <span class="font-bold text-orange">
                        {order.shippingMethod === "courier" ? "Kurier" :
                         order.shippingMethod === "paczkomat" ? "Paczkomat InPost" :
                         order.shippingMethod}
                      </span>
                    </div>
                    {paczkomatInfo ? (
                      <div class="mt-1 border border-graphite-200 bg-white p-2 text-xs">
                        <p class="font-bold text-graphite">{paczkomatInfo.name}</p>
                        {paczkomatInfo.addr && <p class="text-graphite-muted">{paczkomatInfo.addr}</p>}
                      </div>
                    ) : (
                      <div class="text-graphite-muted">
                        {order.address}<br />
                        {order.zipCode} {order.city}
                      </div>
                    )}
                    <div class="mt-2 font-medium text-graphite pt-1">
                      Płatność:{" "}
                      <span class="font-bold text-blue">
                        {order.paymentMethod === "online" ? "Online" : "Za pobraniem"}
                      </span>
                    </div>
                  </td>

                  <td class="px-5 py-4 align-top min-w-[160px]">
                    <span
                      class={`status-badge-styled text-xs font-bold border ${statusClass}`}
                      data-status-badge={order.id}
                    >
                      {statusMap[order.status] ?? order.status}
                    </span>

                    <div class="mt-2 flex flex-col gap-1.5" data-quick-actions={order.id}>
                      {(order.status === "paid" || order.status === "confirmed") && (
                        <button
                          type="button"
                          class="orders-workflow-btn border border-blue bg-blue px-3 py-1.5 text-xs font-semibold text-white"
                          data-order-id={order.id}
                          data-new-status="processing"
                        >
                          → W realizacji
                        </button>
                      )}
                      {order.status === "processing" && (
                        <button
                          type="button"
                          class="orders-workflow-btn border border-blue bg-blue px-3 py-1.5 text-xs font-semibold text-white"
                          data-order-id={order.id}
                          data-new-status="shipped"
                        >
                          → Wysłano
                        </button>
                      )}
                    </div>
                  </td>

                  <td class="px-5 py-4 align-top text-right">
                    <div class="orders-actions flex flex-col gap-2">
                      {canCancel && (
                        <button
                          type="button"
                          data-cancel-order-btn
                          data-order-id={order.id}
                          class="orders-action-btn border border-red bg-red text-xs font-semibold text-white"
                        >
                          Anuluj
                        </button>
                      )}
                      <button
                        type="button"
                        data-delete-order-btn
                        data-order-id={order.id}
                        class="orders-action-btn border border-graphite-200 bg-white text-xs font-medium text-graphite hover:bg-graphite-50"
                      >
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-3.5 h-3.5 shrink-0" aria-hidden="true">
                          <path stroke-linecap="round" stroke-linejoin="round" d="m14.74 9-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 0 1-2.244 2.077H8.084a2.25 2.25 0 0 1-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 0 0-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 0 1 3.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 0 0-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 0 0-7.5 0" />
                        </svg>
                        Usuń
                      </button>
                    </div>
                  </td>
                </tr>
              );
            })
          )}
        </tbody>
      </table>
    </div>
  </div>
</AdminLayout>

<script>
  import { actions } from "astro:actions";

  const STATUS_LABELS: Record<string, string> = {
    pending:    "Złożone",
    confirmed:  "Potwierdzone",
    paid:       "Opłacone",
    processing: "W realizacji",
    shipped:    "Wysłane",
    cancelled:  "Anulowane",
  };

  const STATUS_CLASSES: Record<string, string> = {
    pending:    "bg-orange text-white border-orange",
    confirmed:  "bg-green text-white border-green",
    paid:       "bg-green text-white border-green",
    processing: "bg-blue text-white border-blue",
    shipped:    "bg-blue text-white border-blue",
    cancelled:  "bg-red text-white border-red",
  };

  function rebuildQuickActions(orderId: string, newStatus: string) {
    const container = document.querySelector(`[data-quick-actions="${orderId}"]`);
    if (!container) return;

    container.innerHTML = "";
    if (newStatus === "paid" || newStatus === "confirmed") {
      container.innerHTML = `
        <button type="button" class="orders-workflow-btn border border-blue bg-blue px-3 py-1.5 text-xs font-semibold text-white"
          data-order-id="${orderId}" data-new-status="processing">
          → W realizacji
        </button>`;
    } else if (newStatus === "processing") {
      container.innerHTML = `
        <button type="button" class="orders-workflow-btn border border-blue bg-blue px-3 py-1.5 text-xs font-semibold text-white"
          data-order-id="${orderId}" data-new-status="shipped">
          → Wysłano
        </button>`;
    }

    attachWorkflowButtons(container);
  }

  function applyStatusChange(orderId: string, newStatus: string) {
    const badge = document.querySelector(`[data-status-badge="${orderId}"]`);
    if (badge) {
      badge.textContent = STATUS_LABELS[newStatus] ?? newStatus;
      badge.className = `status-badge-styled text-xs font-bold border ${STATUS_CLASSES[newStatus] ?? "bg-graphite text-white border-graphite"}`;
    }

    rebuildQuickActions(orderId, newStatus);

    const row = document.querySelector(`[data-order-row="${orderId}"]`);
    if (newStatus === "cancelled" || newStatus === "shipped") {
      row?.querySelector("[data-cancel-order-btn]")?.remove();
    }
  }

  async function updateStatus(orderId: string, newStatus: string, btn: HTMLButtonElement) {
    btn.disabled = true;
    const orig = btn.textContent;
    btn.textContent = "Zapisywanie...";

    const fd = new FormData();
    fd.append("id", orderId);
    fd.append("status", newStatus);

    const { error } = await actions.updateOrderStatus(fd);
    if (error) {
      alert(error.message);
      btn.disabled = false;
      btn.textContent = orig ?? "";
      return false;
    }

    applyStatusChange(orderId, newStatus);
    return true;
  }

  function attachWorkflowButtons(container: Element) {
    container.querySelectorAll<HTMLButtonElement>(".orders-workflow-btn").forEach((btn) => {
      if (btn.dataset.bound === "true") return;
      btn.dataset.bound = "true";
      btn.addEventListener("click", async () => {
        const orderId = btn.getAttribute("data-order-id");
        const newStatus = btn.getAttribute("data-new-status");
        if (!orderId || !newStatus) return;
        await updateStatus(orderId, newStatus, btn as HTMLButtonElement);
      });
    });
  }

  function removeOrderRow(orderId: string) {
    const row = document.querySelector(`[data-order-row="${orderId}"]`);
    if (!row) return;

    (row as HTMLElement).style.transition = "opacity 0.3s ease";
    (row as HTMLElement).style.opacity = "0";
    setTimeout(() => {
      row.remove();
      const tbody = document.getElementById("orders-tbody");
      if (tbody && tbody.querySelectorAll("tr[data-order-row]").length === 0) {
        tbody.innerHTML = `<tr><td colspan="6" class="py-12 text-center text-graphite-muted">Brak zamówień dla wybranych filtrów.</td></tr>`;
      }
    }, 300);
  }

  async function cancelOrder(orderId: string, btn: HTMLButtonElement) {
    if (!confirm("Czy na pewno chcesz anulować to zamówienie? Klient otrzyma e-mail z informacją.")) {
      return;
    }

    btn.textContent = "Anulowanie...";
    const ok = await updateStatus(orderId, "cancelled", btn);
    if (ok) btn.remove();
  }

  function initOrdersAdmin() {
    document.querySelectorAll("[data-quick-actions]").forEach(attachWorkflowButtons);

    document.querySelectorAll<HTMLButtonElement>("[data-cancel-order-btn]").forEach((btn) => {
      if (btn.dataset.bound === "true") return;
      btn.dataset.bound = "true";
      btn.addEventListener("click", () => {
        const orderId = btn.getAttribute("data-order-id");
        if (orderId) cancelOrder(orderId, btn as HTMLButtonElement);
      });
    });

    document.querySelectorAll<HTMLButtonElement>("[data-delete-order-btn]").forEach((btn) => {
      if (btn.dataset.bound === "true") return;
      btn.dataset.bound = "true";
      btn.addEventListener("click", async () => {
        const targetBtn = btn as HTMLButtonElement;
        const orderId = targetBtn.getAttribute("data-order-id");
        if (!orderId) return;

        if (!confirm("Czy na pewno chcesz usunąć to zamówienie? Ta operacja jest nieodwracalna.")) {
          return;
        }

        targetBtn.disabled = true;
        const origContent = targetBtn.innerHTML;
        targetBtn.textContent = "Usuwanie...";

        const fd = new FormData();
        fd.append("id", orderId);
        const { error } = await actions.deleteOrder(fd);

        if (error) {
          alert(error.message);
          targetBtn.disabled = false;
          targetBtn.innerHTML = origContent;
        } else {
          removeOrderRow(orderId);
        }
      });
    });
  }

  initOrdersAdmin();
  document.addEventListener("astro:page-load", initOrdersAdmin);
</script>

<style>
  .orders-actions {
    min-width: 6.75rem;
    margin-left: auto;
  }

  .status-badge-styled,
  .orders-action-btn,
  .orders-workflow-btn {
    border-radius: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.375rem;
    width: 100%;
    min-height: 2.125rem;
    padding: 0.375rem 0.75rem;
    box-sizing: border-box;
  }

  .orders-filter {
    border-radius: 0;
  }

  select.orders-filter.field-input,
  input.orders-filter.field-input,
  button.orders-filter,
  a.orders-filter {
    height: 3.25rem !important;
    min-height: 3.25rem !important;
    max-height: 3.25rem !important;
    box-sizing: border-box !important;
    padding-top: 0 !important;
    padding-bottom: 0 !important;
    display: inline-flex !important;
    align-items: center !important;
    justify-content: center !important;
    line-height: 1.4 !important;
    font-size: 0.9375rem !important;
  }

  select.orders-filter.field-input {
    padding-right: 2.5rem !important;
    padding-left: 1rem !important;
    display: block !important;
  }

  input.orders-filter.field-input {
    padding-left: 1rem !important;
    padding-right: 1rem !important;
    display: block !important;
  }
</style>
