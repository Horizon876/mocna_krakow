---
import AdminLayout from '../../layouts/AdminLayout.astro';
import TeamMemberForm from '../../components/admin/TeamMemberForm.astro';
import { db } from '../../db';
import { teamMembers } from '../../db/schema';
import { asc, eq } from 'drizzle-orm';
import { actions } from 'astro:actions';
import { ensureTeamSeeded } from '../../lib/team';

const resultDelete = Astro.getActionResult(actions.deleteTeamMember);
if (resultDelete?.data?.success) {
  return Astro.redirect('/admin/ludzie');
}

const resultCreate = Astro.getActionResult(actions.createTeamMember);
if (resultCreate?.data?.success) {
  return Astro.redirect('/admin/ludzie');
}

const resultUpdate = Astro.getActionResult(actions.updateTeamMember);
if (resultUpdate?.data?.success) {
  return Astro.redirect('/admin/ludzie');
}

await ensureTeamSeeded();

const editId = Astro.url.searchParams.get('edit');

const [allMembers, editResult] = await Promise.all([
  db.select().from(teamMembers).orderBy(asc(teamMembers.sortOrder), asc(teamMembers.createdAt)),
  editId
    ? db.select().from(teamMembers).where(eq(teamMembers.id, editId)).limit(1)
    : Promise.resolve([]),
]);

const editMember = editResult.length > 0 ? editResult[0] : undefined;
---

<AdminLayout title="Ludzie MOCnej - Panel Admina" activeTab="ludzie" noScroll>
  <div class="admin-crud grid min-h-0 flex-1 grid-cols-1 gap-6 overflow-hidden lg:grid-cols-12 lg:gap-8">
    <div class="lg:col-span-5">
      <div class="admin-panel flex flex-col p-6 md:p-8">
        <header class="mb-6 shrink-0">
          <h2 class="text-fluid-lg font-display font-bold leading-tighter tracking-tightest text-graphite">
            {editMember ? "Edytuj osobę" : "Dodaj osobę"}
          </h2>
          <p class="mt-1 text-sm text-graphite-muted">
            Kafelki wyświetlają się na stronie <a href="/ludziemocnej" target="_blank" class="text-blue hover:underline">/ludziemocnej</a>.
          </p>
        </header>
        <div class="admin-crud-body">
          <TeamMemberForm member={editMember} />
        </div>
      </div>
    </div>

    <div class="lg:col-span-7">
      <div class="admin-panel flex flex-col p-6 md:p-8">
        <header class="mb-6 shrink-0">
          <h2 class="text-fluid-lg font-display font-bold leading-tighter tracking-tightest text-graphite">
            Lista kafelków
          </h2>
          <p class="mt-1 text-sm text-graphite-muted invisible select-none" aria-hidden="true">
            &nbsp;
          </p>
        </header>
        <div class="admin-crud-body space-y-4">
          {allMembers.length === 0 ? (
            <div class="border border-dashed border-graphite-200 bg-white/50 p-8 text-center">
              <p class="text-graphite-muted italic">Brak osób w bazie.</p>
            </div>
          ) : (
            allMembers.map((person) => (
              <div class:list={["admin-list-item", editId === person.id && "is-active"]}>
                {person.photoUrl ? (
                  <img
                    src={person.photoUrl}
                    alt=""
                    class="h-16 w-16 object-cover border border-graphite-200 shrink-0"
                    style={person.photoPosition ? `object-position: ${person.photoPosition}` : undefined}
                  />
                ) : (
                  <div
                    class="flex h-16 w-16 shrink-0 items-center justify-center border border-graphite-200 text-lg font-bold text-white"
                    style={`background-color: var(--mocna-${person.accent});`}
                  >
                    {person.name.charAt(0)}
                  </div>
                )}
                <div class="min-w-0 flex-1">
                  <h3 class="mb-1 text-fluid-lg font-bold text-graphite">{person.name}</h3>
                  <p class="mb-2 line-clamp-2 text-sm text-graphite-muted">{person.description}</p>
                  <div class="flex flex-wrap items-center gap-2">
                    <span
                      class="text-xs font-bold uppercase tracking-wider text-white px-2 py-0.5"
                      style={`background-color: var(--mocna-${person.accent});`}
                    >
                      {person.accent}
                    </span>
                    <span class="text-xs text-graphite-muted">#{person.sortOrder}</span>
                  </div>
                </div>
                <div class="flex items-center gap-2">
                  <a href={`/admin/ludzie?edit=${person.id}`} class="btn btn-edit px-4 py-2 text-[13px]">
                    Edytuj
                  </a>
                  <form
                    method="POST"
                    action={actions.deleteTeamMember}
                    onsubmit="return confirm('Czy na pewno chcesz usunąć ten kafelek?');"
                  >
                    <input type="hidden" name="id" value={person.id} />
                    <button type="submit" class="btn btn-delete px-4 py-2 text-[13px]">
                      Usuń
                    </button>
                  </form>
                </div>
              </div>
            ))
          )}
        </div>
      </div>
    </div>
  </div>
</AdminLayout>
