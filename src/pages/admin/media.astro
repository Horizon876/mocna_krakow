---
import AdminLayout from '../../layouts/AdminLayout.astro';
import MediaLogoForm from '../../components/admin/MediaLogoForm.astro';
import { db } from '../../db';
import { mediaLogos } from '../../db/schema';
import { asc, eq } from 'drizzle-orm';
import { actions } from 'astro:actions';
import { ensureMediaLogosSeeded } from '../../lib/media-logos';

const resultDelete = Astro.getActionResult(actions.deleteMediaLogo);
if (resultDelete?.data?.success) {
  return Astro.redirect('/admin/media');
}

const resultCreate = Astro.getActionResult(actions.createMediaLogo);
if (resultCreate?.data?.success) {
  return Astro.redirect('/admin/media');
}

const resultUpdate = Astro.getActionResult(actions.updateMediaLogo);
if (resultUpdate?.data?.success) {
  return Astro.redirect('/admin/media');
}

await ensureMediaLogosSeeded();

const editId = Astro.url.searchParams.get('edit');

const [allItems, editResult] = await Promise.all([
  db.select().from(mediaLogos).orderBy(asc(mediaLogos.sortOrder), asc(mediaLogos.createdAt)),
  editId
    ? db.select().from(mediaLogos).where(eq(mediaLogos.id, editId)).limit(1)
    : Promise.resolve([]),
]);

const editItem = editResult.length > 0 ? editResult[0] : undefined;
---

<AdminLayout title="MOCna w mediach - Panel Admina" activeTab="media" noScroll>
  <div class="admin-crud grid min-h-0 flex-1 grid-cols-1 gap-6 overflow-hidden lg:grid-cols-12 lg:gap-8">
    <div class="lg:col-span-5">
      <div class="admin-panel flex flex-col p-6 md:p-8">
        <header class="mb-6 shrink-0">
          <h2 class="text-fluid-lg font-display font-bold leading-tighter tracking-tightest text-graphite">
            {editItem ? "Edytuj kafelek" : "Dodaj kafelek"}
          </h2>
          <p class="mt-1 text-sm text-graphite-muted">
            Sekcja na stronie głównej <a href="/#mocna-w-mediach" target="_blank" class="text-blue hover:underline">/#mocna-w-mediach</a>.
          </p>
        </header>
        <div class="admin-crud-body">
          <MediaLogoForm item={editItem} />
        </div>
      </div>
    </div>

    <div class="lg:col-span-7">
      <div class="admin-panel flex flex-col p-6 md:p-8">
        <header class="mb-6 shrink-0">
          <h2 class="text-fluid-lg font-display font-bold leading-tighter tracking-tightest text-graphite">
            Lista kafelków
          </h2>
          <p class="mt-1 text-sm text-graphite-muted invisible select-none" aria-hidden="true">
            &nbsp;
          </p>
        </header>
        <div class="admin-crud-body space-y-4">
          {allItems.length === 0 ? (
            <div class="border border-dashed border-graphite-200 bg-white/50 p-8 text-center">
              <p class="text-graphite-muted italic">Brak kafelków w bazie.</p>
            </div>
          ) : (
            allItems.map((row) => (
              <div class:list={["admin-list-item", editId === row.id && "is-active"]}>
                {row.logoUrl ? (
                  <div class="flex h-16 w-16 shrink-0 items-center justify-center border border-graphite-200 bg-white p-1.5">
                    <img src={row.logoUrl} alt="" class="max-h-full max-w-full object-contain" />
                  </div>
                ) : (
                  <div class="flex h-16 w-16 shrink-0 items-center justify-center border border-graphite-200 bg-graphite-100 text-sm font-bold text-graphite">
                    {row.name.charAt(0)}
                  </div>
                )}
                <div class="min-w-0 flex-1">
                  <h3 class="mb-1 text-fluid-lg font-bold text-graphite">{row.name}</h3>
                  {row.href ? (
                    <a href={row.href} target="_blank" rel="noopener" class="mb-1 block truncate text-sm text-blue hover:underline">
                      {row.href}
                    </a>
                  ) : (
                    <p class="mb-1 text-sm text-graphite-muted italic">Bez linku</p>
                  )}
                  <span class="text-xs text-graphite-muted">#{row.sortOrder}</span>
                </div>
                <div class="flex items-center gap-2">
                  <a href={`/admin/media?edit=${row.id}`} class="btn btn-edit px-4 py-2 text-[13px]">
                    Edytuj
                  </a>
                  <form
                    method="POST"
                    action={actions.deleteMediaLogo}
                    onsubmit="return confirm('Czy na pewno chcesz usunąć ten kafelek?');"
                  >
                    <input type="hidden" name="id" value={row.id} />
                    <button type="submit" class="btn btn-delete px-4 py-2 text-[13px]">
                      Usuń
                    </button>
                  </form>
                </div>
              </div>
            ))
          )}
        </div>
      </div>
    </div>
  </div>
</AdminLayout>
