---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { actions } from 'astro:actions';

const logoutResult = Astro.getActionResult(actions.logout);
if (logoutResult?.data?.success) {
  return Astro.redirect('/admin/login');
}

const tiles = [
  {
    label: "SKLEP",
    href: "/admin/sklep",
    color: "text-blue",
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="h-10 w-10" aria-hidden="true"><path d="M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4z"/><path d="M3 6h18"/><path d="M16 10a4 4 0 01-8 0"/></svg>`,
  },
  {
    label: "Wydarzenia",
    href: "/admin/wydarzenia",
    color: "text-orange",
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="h-10 w-10" aria-hidden="true"><rect x="3" y="4" width="18" height="18"/><path d="M16 2v4M8 2v4M3 10h18"/></svg>`,
  },
  {
    label: "Kawiarnia",
    href: "/admin/kawiarnia",
    color: "text-green",
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="h-10 w-10" aria-hidden="true"><path d="M18 8h1a4 4 0 010 8h-1"/><path d="M2 8h16v9a4 4 0 01-4 4H6a4 4 0 01-4-4V8z"/><path d="M6 1v3M10 1v3M14 1v3"/></svg>`,
  },
  {
    label: "Rezerwacje",
    href: "/admin/rezerwacje",
    color: "text-red",
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="h-10 w-10" aria-hidden="true"><rect x="3" y="5" width="18" height="14"/><path d="M7 15h4"/><path d="M7 11h10"/><path d="M3 9h18"/></svg>`,
  },
];
---

<AdminLayout title="Panel Administratora - MOCna" activeTab="dashboard" centered>
  <div class="admin-dashboard-grid grid w-full max-w-4xl grid-cols-2 gap-5 sm:gap-6 lg:max-w-5xl lg:grid-cols-4">
    {
      tiles.map((tile) => (
        <a href={tile.href} class="admin-dashboard-tile group">
          <span class:list={["mb-4 flex h-14 w-14 items-center justify-center", tile.color]} set:html={tile.icon} />
          <span class="text-fluid-sm font-display font-bold uppercase tracking-[0.12em] text-graphite">
            {tile.label}
          </span>
        </a>
      ))
    }
  </div>
</AdminLayout>
