---
import AdminLayout from '../../layouts/AdminLayout.astro';

const role = Astro.locals.adminRole;
const forbidden = Astro.url.searchParams.get('forbidden');

const allTiles = [
  {
    label: "Sklep",
    href: "/admin/sklep",
    color: "text-blue",
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="h-10 w-10" aria-hidden="true"><path d="M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4z"/><path d="M3 6h18"/><path d="M16 10a4 4 0 01-8 0"/></svg>`,
  },
  {
    label: "Zamówienia",
    href: "/admin/zamowienia",
    color: "text-yellow",
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="h-10 w-10" aria-hidden="true"><path d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2"/><rect x="9" y="3" width="6" height="4" rx="1"/><path d="M9 12h6M9 16h6"/></svg>`,
  },
  {
    label: "Wydarzenia",
    href: "/admin/wydarzenia",
    color: "text-orange",
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="h-10 w-10" aria-hidden="true"><rect x="3" y="4" width="18" height="18"/><path d="M16 2v4M8 2v4M3 10h18"/></svg>`,
  },
  {
    label: "Bilety",
    href: "/admin/bilety",
    color: "text-pink",
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="h-10 w-10" aria-hidden="true"><path d="M2 9a3 3 0 010-6h20a3 3 0 010 6"/><path d="M2 15a3 3 0 000 6h20a3 3 0 000-6"/><path d="M2 12h20"/><path d="M10 3v18"/></svg>`,
  },
  {
    label: "Ludzie",
    href: "/admin/ludzie",
    color: "text-blue",
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="h-10 w-10" aria-hidden="true"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 00-3-3.87"/><path d="M16 3.13a4 4 0 010 7.75"/></svg>`,
  },
  {
    label: "Projekty",
    href: "/admin/projekty",
    color: "text-orange",
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="h-10 w-10" aria-hidden="true"><path d="M4 19.5A2.5 2.5 0 016.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 014 19.5v-15A2.5 2.5 0 016.5 2z"/><path d="M8 7h8M8 11h8M8 15h5"/></svg>`,
  },
  {
    label: "Kawiarnia",
    href: "/admin/kawiarnia",
    color: "text-green",
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="h-10 w-10" aria-hidden="true"><path d="M18 8h1a4 4 0 010 8h-1"/><path d="M2 8h16v9a4 4 0 01-4 4H6a4 4 0 01-4-4V8z"/><path d="M6 1v3M10 1v3M14 1v3"/></svg>`,
  },
  {
    label: "Rezerwacje",
    href: "/admin/rezerwacje",
    color: "text-red",
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="h-10 w-10" aria-hidden="true"><rect x="3" y="5" width="18" height="14"/><path d="M7 15h4"/><path d="M7 11h10"/><path d="M3 9h18"/></svg>`,
  },
];

const tiles = role === 'pracownik'
  ? allTiles.filter(t => !['Sklep', 'Wydarzenia', 'Kawiarnia', 'Ludzie', 'Projekty'].includes(t.label))
  : allTiles.filter(t => !['Zamówienia', 'Bilety', 'Rezerwacje'].includes(t.label));
---

<AdminLayout title="Panel Administratora - MOCna" activeTab="dashboard" centered>
  {forbidden && (
    <div class="mb-8 w-full max-w-5xl rounded-lg bg-red/10 p-4 text-center text-sm text-red lg:max-w-6xl">
      <strong>Brak dostępu.</strong> Twoje konto nie posiada uprawnień do przeglądania tej sekcji.
    </div>
  )}
  <div class="admin-dashboard-grid grid w-full max-w-5xl grid-cols-1 gap-5 xs:grid-cols-2 sm:gap-6 sm:grid-cols-3 lg:max-w-6xl">
    {
      tiles.map((tile) => (
        <a href={tile.href} class="admin-dashboard-tile group">
          <span class:list={["mb-4 flex h-14 w-14 items-center justify-center", tile.color]} set:html={tile.icon} />
          <span class="text-fluid-sm font-display font-bold uppercase tracking-[0.12em] text-graphite">
            {tile.label}
          </span>
        </a>
      ))
    }
  </div>
</AdminLayout>
