---
import BaseLayout from "@layouts/BaseLayout.astro";
import SectionHeading from "@components/SectionHeading.astro";
import CafeGallery from "@components/CafeGallery.astro";
import { getCafeGalleryPhotos } from "../lib/cafe-gallery";

const photos = await getCafeGalleryPhotos();
---
<BaseLayout title="Nasza kawiarnia — MOCna!">
  <div class="home-page">
    <section class="relative scroll-mt-16 pt-10 pb-20 sm:scroll-mt-[4.5rem] sm:pt-12 sm:pb-28">
      <div class="shell">
        <SectionHeading title="<span class='text-blue'>N</span><span class='text-red'>a</span><span class='text-yellow'>s</span><span class='text-green'>za</span> <span class='text-orange'>k</span><span class='text-pink'>a</span><span class='text-blue'>w</span><span class='text-red'>i</span><span class='text-yellow'>a</span><span class='text-green'>rnia</span>" />
        <CafeGallery photos={photos} />
      </div>
    </section>
  </div>
</BaseLayout>
