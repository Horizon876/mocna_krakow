---
import BaseLayout from "@layouts/BaseLayout.astro";
import PageHero from "@components/PageHero.astro";
import SectionHeading from "@components/SectionHeading.astro";
import CafeGallery from "@components/CafeGallery.astro";
import Photo from "@components/Photo.astro";
import { BRAND } from "@data/site";

const menu = [
  { cat: "Espresso bar", items: [["Espresso", "9 zł"], ["Flat white", "15 zł"], ["Cappuccino", "14 zł"], ["Latte", "16 zł"]] },
  { cat: "Slow coffee", items: [["V60 / Drip", "18 zł"], ["Aeropress", "18 zł"], ["Chemex (2 os.)", "28 zł"], ["Cold brew", "16 zł"]] },
  { cat: "Z cukierni Klaudii", items: [["Sernik dnia", "14 zł"], ["Ciasto marchewkowe", "13 zł"], ["Cynamonka", "11 zł"], ["Bezglutenowe brownie", "15 zł"]] },
];
---
<BaseLayout title="Nasza kawiarnia — MOCna!">
  <PageHero
    kicker="Nasza kawiarnia"
    title="Sala, która <span class='text-orange'>oddycha</span> kawą"
    lead="Specialty z najlepszych palarni, domowe wypieki i atmosfera, dla której się wraca. Usiądź — ekspres już się grzeje."
    variant="warm"
  />

  <CafeGallery />

  <section class="py-16">
    <div class="shell">
      <SectionHeading align="center" kicker="Karta" title="Co dziś <span class='text-orange'>parzymy</span>" />
      <div class="mt-10 grid gap-6 lg:grid-cols-3">
        {menu.map((m) => (
          <div class="rounded-[26px] border border-graphite-200 bg-white p-7">
            <h3 class="text-fluid-lg font-display font-bold tracking-tightest text-orange">{m.cat}</h3>
            <ul class="mt-4 divide-y divide-graphite-200">
              {m.items.map(([name, price]) => (
                <li class="flex items-baseline justify-between gap-3 py-3">
                  <span class="text-fluid-sm text-graphite">{name}</span>
                  <span class="font-display font-bold tracking-tightest text-graphite">{price}</span>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
      <p class="mt-6 text-center text-fluid-sm text-graphite-muted">Karta zmienia się sezonowo. Pytaj o ziarno tygodnia ☕</p>
    </div>
  </section>

  <section class="py-12">
    <div class="shell grid items-stretch gap-6 lg:grid-cols-[1.3fr_1fr]">
      <div class="overflow-hidden rounded-[32px] border border-graphite-200">
        <iframe title="Mapa — kawiarnia MOCna!" src={BRAND.mapEmbed} width="100%" height="360" loading="lazy" style="border:0; filter:grayscale(0.25);" referrerpolicy="no-referrer-when-downgrade"></iframe>
      </div>
      <div class="flex flex-col justify-between rounded-[32px] bg-graphite p-8 text-white">
        <div>
          <h3 class="text-fluid-xl font-display font-bold tracking-tightest">Zajrzyj do nas</h3>
          <p class="mt-2 text-fluid-sm text-white/70">{BRAND.address}</p>
          <ul class="mt-6 space-y-2 text-fluid-sm text-white/85">
            {BRAND.hours.map((h) => (
              <li class="flex justify-between border-b border-white/10 pb-2"><span>{h.d}</span><span>{h.h}</span></li>
            ))}
          </ul>
        </div>
        <a href="/rezerwacja" class="btn-orange mt-8 animate-glow">✺ Zarezerwuj stolik</a>
      </div>
    </div>
  </section>
</BaseLayout>
