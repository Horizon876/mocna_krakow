---
import BaseLayout from "@layouts/BaseLayout.astro";
import PageHero from "@components/PageHero.astro";
import { BRAND } from "@data/site";

const times = ["9:00", "10:00", "11:00", "12:00", "13:00", "14:00", "15:00", "16:00", "17:00", "18:00"];
---
<BaseLayout title="Rezerwacja stolika — MOCna!">
  <PageHero
    kicker="Rezerwacja"
    title="Stolik czeka, <span class='text-orange'>ekspres się grzeje</span>"
    lead="Zarezerwuj miejsce w kilka sekund. Potwierdzenie wyślemy mailem — reszta to już tylko aromat świeżej kawy."
    variant="warm"
  />

  <section class="pb-20">
    <div class="shell grid gap-8 lg:grid-cols-[1.1fr_0.9fr]">
      <form id="rezerwacja-form" class="glass grid gap-5 p-8 sm:p-10">
        <div class="grid gap-5 sm:grid-cols-2">
          <label class="grid gap-2">
            <span class="text-fluid-sm font-medium text-graphite">Imię i nazwisko</span>
            <input required name="imie" class="rounded-2xl border border-graphite-200 bg-white px-4 py-3 text-fluid-sm focus:border-orange focus:outline-none" placeholder="Jan Kowalski" />
          </label>
          <label class="grid gap-2">
            <span class="text-fluid-sm font-medium text-graphite">E-mail</span>
            <input required type="email" name="email" class="rounded-2xl border border-graphite-200 bg-white px-4 py-3 text-fluid-sm focus:border-orange focus:outline-none" placeholder="jan@email.pl" />
          </label>
          <label class="grid gap-2">
            <span class="text-fluid-sm font-medium text-graphite">Data</span>
            <input required type="date" name="data" class="rounded-2xl border border-graphite-200 bg-white px-4 py-3 text-fluid-sm focus:border-orange focus:outline-none" />
          </label>
          <label class="grid gap-2">
            <span class="text-fluid-sm font-medium text-graphite">Godzina</span>
            <select name="godzina" class="rounded-2xl border border-graphite-200 bg-white px-4 py-3 text-fluid-sm focus:border-orange focus:outline-none">
              {times.map((t) => <option>{t}</option>)}
            </select>
          </label>
        </div>

        <div>
          <span class="text-fluid-sm font-medium text-graphite">Liczba osób</span>
          <div class="mt-2 flex flex-wrap gap-2">
            {[1, 2, 3, 4, 5, 6].map((n) => (
              <label class="cursor-pointer">
                <input type="radio" name="osoby" value={n} class="peer sr-only" checked={n === 2} />
                <span class="grid h-12 w-12 place-items-center rounded-full border border-graphite-200 text-fluid-sm font-medium transition-colors peer-checked:border-orange peer-checked:bg-orange peer-checked:text-white">{n}{n === 6 ? "+" : ""}</span>
              </label>
            ))}
          </div>
        </div>

        <label class="grid gap-2">
          <span class="text-fluid-sm font-medium text-graphite">Coś jeszcze? (opcjonalnie)</span>
          <textarea name="uwagi" rows="3" class="rounded-2xl border border-graphite-200 bg-white px-4 py-3 text-fluid-sm focus:border-orange focus:outline-none" placeholder="Stolik przy oknie? Urodziny? Damy radę 🎂"></textarea>
        </label>

        <button type="submit" class="btn-orange animate-glow justify-center py-4 text-fluid-lg">Rezerwuję stolik ✺</button>
        <p id="rezerwacja-ok" class="hidden rounded-2xl bg-green/10 p-4 text-center text-fluid-sm font-medium text-green">
          Gotowe! Stolik zarezerwowany — do zobaczenia w MOCnej ☕
        </p>
      </form>

      <aside class="flex flex-col gap-4">
        <div class="rounded-[28px] bg-yellow-cream p-7">
          <h3 class="text-fluid-lg font-display font-bold tracking-tightest">Dobrze wiedzieć</h3>
          <ul class="mt-4 space-y-3 text-fluid-sm text-graphite-soft">
            <li>🐶 Pieski mile widziane — mamy miskę i smaczki.</li>
            <li>♿ Lokal w pełni dostępny, bez progów.</li>
            <li>🌿 Latem otwieramy ogródek.</li>
            <li>💛 Większe grupy? Napisz na {BRAND.email}.</li>
          </ul>
        </div>
        <div class="rounded-[28px] bg-graphite p-7 text-white">
          <h3 class="text-fluid-lg font-display font-bold tracking-tightest">Wolisz zadzwonić?</h3>
          <a href={`tel:${BRAND.phone.replace(/\s/g, "")}`} class="mt-3 inline-block font-display text-fluid-xl font-bold tracking-tightest text-orange-soft">{BRAND.phone}</a>
          <p class="mt-2 text-fluid-sm text-white/70">Odbieramy w godzinach otwarcia.</p>
        </div>
      </aside>
    </div>
  </section>
</BaseLayout>

<script>
  function initForm() {
    const form = document.getElementById("rezerwacja-form") as HTMLFormElement | null;
    const ok = document.getElementById("rezerwacja-ok");
    if (!form) return;
    form.addEventListener("submit", (e) => {
      e.preventDefault();
      ok?.classList.remove("hidden");
      ok?.scrollIntoView({ behavior: "smooth", block: "center" });
      form.querySelector("button")?.setAttribute("disabled", "true");
    });
  }
  initForm();
  document.addEventListener("astro:after-swap", initForm);
</script>
