---
import BaseLayout from "@layouts/BaseLayout.astro";
import TableMap from "@components/TableMap.astro";

const occupiedTables: string[] = [];
---

<BaseLayout title="Rezerwacja stolika — MOCna!">
  <div class="flex min-h-full flex-1 flex-col">

    <section class="flex flex-1 flex-col px-6 py-10 sm:py-14">
      <div class="mx-auto w-full max-w-4xl">

        <!-- Komunikat sukcesu (ukryty do czasu potwierdzenia) -->
        <div id="booking-success" class="hidden rounded-none border border-green/40 bg-green/5 p-6 sm:p-8">
          <div class="flex items-start gap-4">
            <span class="mt-0.5 shrink-0 text-2xl text-green" aria-hidden="true">✓</span>
            <div>
              <h2 class="mb-1 font-display text-xl font-bold tracking-tightest text-graphite">
                Rezerwacja potwierdzona!
              </h2>
              <p id="booking-success-text" class="text-graphite-muted"></p>
              <a href="/rezerwacja" class="btn btn-orange mt-5 inline-block">
                Zarezerwuj kolejny stolik
              </a>
            </div>
          </div>
        </div>

        <!-- Kroki rezerwacji (mapa + formularz) -->
        <div id="booking-flow">
          <TableMap occupiedTables={occupiedTables} />

          <form
            id="booking-form"
            class="mt-8 hidden border border-graphite-200 bg-white p-6 sm:p-8"
            novalidate
          >
            <input type="hidden" name="tableId"          id="form-table-id"/>
            <input type="hidden" name="reservationDate"  id="form-date"/>
            <input type="hidden" name="reservationTime"  id="form-time"/>

            <h2 class="mb-6 text-xl font-display font-bold tracking-tightest text-graphite">
              Twoje dane
            </h2>

            <!-- Komunikat błędu wewnątrz formularza -->
            <div
              id="form-error"
              role="alert"
              class="mb-5 hidden rounded-none border border-red/40 bg-red/5 p-4 text-sm text-red"
            ></div>

            <div class="grid gap-4 sm:grid-cols-2">
              <div>
                <label class="field-label mb-1" for="first-name">Imię</label>
                <input
                  type="text"
                  id="first-name"
                  name="firstName"
                  class="field-input"
                  placeholder="np. Anna"
                  required
                />
              </div>
              <div>
                <label class="field-label mb-1" for="last-name">Nazwisko</label>
                <input
                  type="text"
                  id="last-name"
                  name="lastName"
                  class="field-input"
                  placeholder="np. Kowalska"
                  required
                />
              </div>
              <div>
                <label class="field-label mb-1" for="email">E-mail</label>
                <input
                  type="email"
                  id="email"
                  name="email"
                  class="field-input"
                  placeholder="anna@przykład.pl"
                  required
                />
              </div>
              <div>
                <label class="field-label mb-1" for="phone">Telefon</label>
                <input
                  type="tel"
                  id="phone"
                  name="phone"
                  class="field-input"
                  placeholder="+48 123 456 789"
                />
              </div>
              <div class="sm:col-span-2">
                <label class="field-label mb-1" for="notes">Uwagi (opcjonalnie)</label>
                <textarea
                  id="notes"
                  name="notes"
                  rows="3"
                  class="field-input resize-none"
                  placeholder="Alergie, okazja specjalna, życzenia…"
                ></textarea>
              </div>
            </div>

            <div class="mt-6 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
              <p class="text-sm text-graphite-muted">
                Potwierdzenie rezerwacji wyślemy na podany e-mail.
              </p>
              <button type="submit" id="form-submit-btn" class="btn btn-orange sm:w-auto">
                Zarezerwuj stolik →
              </button>
            </div>
          </form>
        </div>

      </div>
    </section>
  </div>
</BaseLayout>

<script src="../scripts/reservation.ts"></script>
