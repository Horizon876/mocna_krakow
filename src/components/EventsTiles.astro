---
import SectionHeading from "@components/SectionHeading.astro";
import { EVENT_KINDS, COLORS } from "@data/site";

// Asymetryczna siatka – każdy kafel ma inny „rozstaw”.
const spans = [
  "sm:col-span-3 lg:row-span-2",
  "sm:col-span-3",
  "sm:col-span-2",
  "sm:col-span-2",
  "sm:col-span-2 lg:col-span-6",
];

// SVG icons indeksowane jak EVENT_KINDS: koncerty, warsztaty, szkolenia, wsparcie, spotkania
const eventIcons = [
  `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2a3 3 0 013 3v7a3 3 0 01-6 0V5a3 3 0 013-3z"/><path d="M19 10v2a7 7 0 01-14 0v-2"/><line x1="12" y1="19" x2="12" y2="23"/><line x1="8" y1="23" x2="16" y2="23"/></svg>`,
  `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2C6.48 2 2 6.48 2 12c0 5.52 4.48 10 10 10 .83 0 1.5-.67 1.5-1.5 0-.39-.15-.74-.39-1.01C12.88 19.23 12.73 18.88 12.73 18.5c0-.83.67-1.5 1.5-1.5H16c2.76 0 5-2.24 5-5 0-4.42-4.03-8-9-8z"/><circle cx="7" cy="12" r="1" fill="currentColor" stroke="none"/><circle cx="9.5" cy="7.5" r="1" fill="currentColor" stroke="none"/><circle cx="14.5" cy="7.5" r="1" fill="currentColor" stroke="none"/><circle cx="17" cy="12" r="1" fill="currentColor" stroke="none"/></svg>`,
  `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 10 12 2 2 10 12 18 22 10"/><polyline points="6 12 6 17 12 20 18 17 18 12"/></svg>`,
  `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 00-3-3.87M16 3.13a4 4 0 010 7.75"/></svg>`,
  `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round"><path d="M2 3h6a4 4 0 014 4v14a3 3 0 00-3-3H2z"/><path d="M22 3h-6a4 4 0 00-4 4v14a3 3 0 013-3h7z"/></svg>`,
];
---
<section class="relative py-20 sm:py-28">
  <div class="shell">
    <div class="flex flex-wrap items-end justify-between gap-6">
      <SectionHeading
        kicker="Aktualne wydarzenia"
        title="Dzieje się u nas <span class='text-orange'>cały czas</span>"
      />
      <a href="/wydarzenia" class="btn-outline">Cały kalendarz →</a>
    </div>

    <div class="mt-10 grid grid-cols-1 gap-4 sm:grid-cols-6">
      {EVENT_KINDS.map((e, i) => (
        <a
          href={e.href}
          class:list={[
            "event-tile group relative flex min-h-[180px] flex-col justify-between overflow-hidden rounded-[28px] border border-graphite-200 bg-white p-6 transition-all duration-500 ease-organic hover:-translate-y-1.5 hover:border-transparent",
            spans[i],
          ]}
          style={`--c:${COLORS[e.color]}`}
        >
          <span class="flex h-10 w-10 items-center justify-center text-graphite-soft transition-all duration-500 group-hover:scale-110 group-hover:text-white"><Fragment set:html={eventIcons[i]} /></span>
          <div>
            <h3 class="text-fluid-lg font-display font-bold tracking-tightest transition-colors duration-500 group-hover:text-white">
              {e.title}
            </h3>
            <p class="mt-1 text-fluid-sm text-graphite-muted transition-colors duration-500 group-hover:text-white/85">
              {e.desc}
            </p>
          </div>
          <span class="mt-4 inline-flex items-center gap-1.5 text-fluid-sm font-semibold text-orange transition-colors duration-500 group-hover:text-white">
            Kup bilet
            <svg class="h-3.5 w-3.5 transition-transform duration-300 group-hover:translate-x-1" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M2.5 7h9M8 3.5 11.5 7 8 10.5"/>
            </svg>
          </span>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  /* Gładka zmiana tła na kolor z palety przy hoverze */
  .event-tile::before {
    content: "";
    position: absolute;
    inset: 0;
    background: var(--c);
    opacity: 0;
    transition: opacity 0.5s cubic-bezier(0.22, 1, 0.36, 1);
    z-index: 0;
  }
  .event-tile:hover::before {
    opacity: 1;
  }
  .event-tile > * {
    position: relative;
    z-index: 1;
  }
</style>
