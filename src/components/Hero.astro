---
// Hero.astro - TailGrids Header Component
---

<header class="w-full bg-white font-sans text-gray-700">
  <!-- Top Bar (Desktop Only) -->
  <div class="hidden lg:block border-b border-gray-100">
    <div class="container mx-auto px-4 flex justify-between items-center py-2.5 text-[13px] text-[#637381]">
      <ul class="flex items-center space-x-6">
        <li><a href="#" class="hover:text-[#3056D3] transition-colors">About Us</a></li>
        <li><a href="#" class="hover:text-[#3056D3] transition-colors">Order Tracking</a></li>
        <li><a href="#" class="hover:text-[#3056D3] transition-colors">Contact Us</a></li>
        <li><a href="#" class="hover:text-[#3056D3] transition-colors">FAQs</a></li>
      </ul>
      <ul class="flex items-center space-x-6">
        <li class="flex items-center gap-1.5 cursor-pointer hover:text-[#3056D3] transition-colors">
          English
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
        </li>
        <li class="flex items-center gap-1.5 cursor-pointer hover:text-[#3056D3] transition-colors">
          USD
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
        </li>
      </ul>
    </div>
  </div>

  <!-- Main Navbar -->
  <div class="border-b border-gray-100 py-4 lg:py-6">
    <div class="container mx-auto px-4 flex flex-col lg:flex-row lg:items-center justify-between gap-4 lg:gap-8">
      
      <!-- Top Row Mobile: Logo & Mobile Icons -->
      <div class="flex items-center justify-between">
        <!-- Logo -->
        <a href="/" class="flex items-center gap-2.5">
          <svg width="36" height="36" viewBox="0 0 36 36" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M18 36C27.9411 36 36 27.9411 36 18C36 8.05887 27.9411 0 18 0C8.05887 0 0 8.05887 0 18C0 27.9411 8.05887 36 18 36Z" fill="white"/>
            <path d="M18 6.54541C11.6859 6.54541 6.54541 11.6859 6.54541 18C6.54541 24.3141 11.6859 29.4545 18 29.4545C24.3141 29.4545 29.4545 24.3141 29.4545 18H22.9091C22.9091 20.7077 20.7077 22.9091 18 22.9091C15.2923 22.9091 13.0909 20.7077 13.0909 18C13.0909 15.2923 15.2923 13.0909 18 13.0909C20.7077 13.0909 22.9091 15.2923 22.9091 18H29.4545C29.4545 11.6859 24.3141 6.54541 18 6.54541Z" fill="#3056D3"/>
          </svg>
          <span class="text-[26px] font-bold text-[#212B36] tracking-tight">TailGrids</span>
        </a>
        
        <!-- Mobile Actions -->
        <div class="flex lg:hidden items-center gap-4">
          <button class="relative text-[#212B36] hover:text-[#3056D3]">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"></path></svg>
            <span class="absolute -top-1.5 -right-1.5 bg-[#3056D3] text-white text-[10px] font-bold w-4 h-4 rounded-full flex items-center justify-center">1</span>
          </button>
          <button class="text-[#212B36] hover:text-[#3056D3]">
            <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path></svg>
          </button>
        </div>
      </div>

      <!-- Search Bar -->
      <div class="flex w-full lg:max-w-[600px] xl:max-w-[700px] items-center border border-gray-200 rounded-md overflow-hidden bg-white mt-2 lg:mt-0 order-3 lg:order-none focus-within:border-[#3056D3] transition-colors">
        <button class="hidden sm:flex items-center gap-2 px-5 py-3.5 bg-[#F4F7FF] text-[#637381] text-[15px] font-medium border-r border-gray-200 hover:bg-gray-100 transition-colors whitespace-nowrap">
          All Categories 
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
        </button>
        <input type="text" placeholder="I'm shopping for..." class="flex-1 px-5 py-3.5 outline-none text-[15px] text-[#212B36] w-full placeholder-[#637381]" />
        <button class="bg-[#3056D3] text-white px-7 py-3.5 hover:bg-blue-800 transition-colors flex items-center justify-center">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
        </button>
      </div>

      <!-- Desktop Actions -->
      <div class="hidden lg:flex items-center gap-6 xl:gap-8 order-2 lg:order-none">
        <!-- Phone -->
        <div class="hidden xl:flex items-center gap-3">
          <div class="w-12 h-12 rounded-full bg-[#F4F7FF] flex items-center justify-center text-[#637381]">
             <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path></svg>
          </div>
          <div>
            <p class="text-[14px] text-[#637381] font-medium leading-none mb-1.5">Need Help?</p>
            <p class="text-[16px] font-bold text-[#212B36] leading-none">+001 123 456 789</p>
          </div>
        </div>

        <!-- Icons -->
        <div class="flex items-center gap-4">
          <button class="w-12 h-12 rounded-full bg-[#F4F7FF] flex items-center justify-center text-[#212B36] hover:text-[#3056D3] transition-colors relative">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path></svg>
          </button>
          <button class="w-12 h-12 rounded-full bg-[#F4F7FF] flex items-center justify-center text-[#212B36] hover:text-[#3056D3] transition-colors relative">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"></path></svg>
            <span class="absolute -top-1 -right-1 bg-[#3056D3] text-white text-[11px] font-bold w-5 h-5 rounded-full flex items-center justify-center border-2 border-white">1</span>
          </button>
          <button class="w-12 h-12 rounded-full bg-[#F4F7FF] flex items-center justify-center text-[#212B36] hover:text-[#3056D3] transition-colors relative">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"></path></svg>
            <span class="absolute -top-1 -right-1 bg-[#3056D3] text-white text-[11px] font-bold w-5 h-5 rounded-full flex items-center justify-center border-2 border-white">1</span>
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- Bottom Nav & Hero Section Wrapper -->
  <div class="container mx-auto px-4">
    
    <!-- Navigation Bar -->
    <div class="py-4 flex items-center gap-8">
      <!-- All Categories Button (Desktop) -->
      <button class="hidden lg:flex w-[260px] bg-[#3056D3] text-white px-6 py-3.5 rounded-md items-center justify-between font-medium text-[15px] hover:bg-blue-800 transition-colors flex-shrink-0">
        <div class="flex items-center gap-3">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path></svg>
          All categories
        </div>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
      </button>

      <!-- Horizontal Links -->
      <ul class="hidden lg:flex flex-1 items-center space-x-8 text-[#637381] font-medium text-[15px]">
        <li><a href="#" class="text-[#3056D3]">Mens</a></li>
        <li><a href="#" class="hover:text-[#3056D3] transition-colors">Womens</a></li>
        <li><a href="#" class="hover:text-[#3056D3] transition-colors">Kids</a></li>
        <li><a href="#" class="hover:text-[#3056D3] transition-colors">Electronic Items</a></li>
        <li><a href="#" class="hover:text-[#3056D3] transition-colors">Kitchen Accessories</a></li>
        <li><a href="#" class="hover:text-[#3056D3] transition-colors">News & Blogs</a></li>
        <li><a href="#" class="hover:text-[#3056D3] transition-colors">Contact Us</a></li>
      </ul>
      
      <!-- Mobile Categories Toggle -->
      <button class="lg:hidden flex items-center gap-2 text-[#3056D3] font-medium text-[15px]">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path></svg>
        Categories
      </button>
    </div>

    <!-- Hero Area with Menu Options -->
    <div class="pb-12 mt-2 w-full max-w-[1060px]">
      
      <!-- Combined Mega Menu Container -->
      <div class="hidden lg:flex w-full bg-white border border-gray-100 rounded-lg shadow-[0_4px_25px_-5px_rgba(0,0,0,0.05)] min-h-[380px] overflow-hidden">
        
        <!-- Left Sidebar Menu -->
        <div class="w-[260px] border-r border-gray-100 bg-white flex-shrink-0">
          <ul class="py-3">
            <li><a href="#" class="block px-6 py-3.5 text-[15px] text-[#637381] hover:text-[#3056D3] transition-colors">Arts & Crafts</a></li>
            <li>
              <a href="#" class="flex items-center justify-between px-6 py-3.5 text-[15px] text-[#3056D3] font-medium bg-[#F4F7FF]">
                Fashion
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
              </a>
            </li>
            <li><a href="#" class="block px-6 py-3.5 text-[15px] text-[#637381] hover:text-[#3056D3] transition-colors">Bages & Shoes</a></li>
            <li><a href="#" class="block px-6 py-3.5 text-[15px] text-[#637381] hover:text-[#3056D3] transition-colors">Jewelry & Watch</a></li>
            <li><a href="#" class="block px-6 py-3.5 text-[15px] text-[#637381] hover:text-[#3056D3] transition-colors">Beauty & Health</a></li>
            <li><a href="#" class="block px-6 py-3.5 text-[15px] text-[#637381] hover:text-[#3056D3] transition-colors">Electronics</a></li>
          </ul>
        </div>

        <!-- Mega Menu Content -->
        <div class="flex-1 p-8 flex gap-8 bg-white">
          <div class="flex-1 grid grid-cols-2 gap-8">
            <!-- Column 1 -->
            <div>
              <h3 class="font-bold text-[#212B36] text-[16px] mb-6">New Arrivals</h3>
              <ul class="space-y-4">
                <li><a href="#" class="text-[15px] text-[#637381] hover:text-[#3056D3] transition-colors">Dressess</a></li>
                <li><a href="#" class="text-[15px] text-[#3056D3] font-medium">Jackets</a></li>
                <li><a href="#" class="text-[15px] text-[#637381] hover:text-[#3056D3] transition-colors">Sweatshirts</a></li>
                <li><a href="#" class="text-[15px] text-[#637381] hover:text-[#3056D3] transition-colors">Tops & Tees</a></li>
                <li><a href="#" class="text-[15px] text-[#637381] hover:text-[#3056D3] transition-colors">Party Dressess</a></li>
                <li><a href="#" class="text-[15px] text-[#637381] hover:text-[#3056D3] transition-colors">Electronics</a></li>
              </ul>
            </div>
            <!-- Column 2 -->
            <div>
              <h3 class="font-bold text-[#212B36] text-[16px] mb-6">Trending</h3>
              <ul class="space-y-4">
                <li><a href="#" class="text-[15px] text-[#637381] hover:text-[#3056D3] transition-colors">Pants</a></li>
                <li><a href="#" class="text-[15px] text-[#637381] hover:text-[#3056D3] transition-colors">Accessories</a></li>
                <li><a href="#" class="text-[15px] text-[#637381] hover:text-[#3056D3] transition-colors">Tops & Tees</a></li>
                <li><a href="#" class="text-[15px] text-[#637381] hover:text-[#3056D3] transition-colors">Casual Shorts</a></li>
                <li><a href="#" class="text-[15px] text-[#637381] hover:text-[#3056D3] transition-colors">Jeans</a></li>
                <li><a href="#" class="text-[15px] text-[#637381] hover:text-[#3056D3] transition-colors">Electronics</a></li>
              </ul>
            </div>
          </div>
          <!-- Banner -->
          <div class="w-[300px] bg-[#8B9DF2] rounded-lg p-8 flex flex-col justify-center items-center text-center relative overflow-hidden text-white flex-shrink-0">
            <!-- Simulated Chair image background using subtle SVG shapes -->
            <svg class="absolute bottom-0 left-1/2 transform -translate-x-1/2 w-56 h-56 opacity-20 pointer-events-none text-white translate-y-6" viewBox="0 0 100 100" fill="currentColor">
               <polygon points="30,50 70,50 80,80 20,80" />
               <polygon points="40,20 60,20 65,50 35,50" />
               <line x1="30" y1="50" x2="20" y2="100" stroke="currentColor" stroke-width="2"/>
               <line x1="70" y1="50" x2="80" y2="100" stroke="currentColor" stroke-width="2"/>
               <line x1="35" y1="50" x2="40" y2="100" stroke="currentColor" stroke-width="2"/>
               <line x1="65" y1="50" x2="60" y2="100" stroke="currentColor" stroke-width="2"/>
            </svg>
            
            <div class="relative z-10 flex flex-col items-center mt-2">
              <h3 class="text-[44px] font-bold leading-none mb-2 drop-shadow-sm">50%</h3>
              <p class="text-[20px] font-semibold mb-6">Flat Discount</p>
              <a href="#" class="inline-block bg-[#3056D3] hover:bg-blue-800 text-white text-[15px] font-medium px-8 py-2.5 rounded-[4px] transition-colors shadow-sm">Shop Now</a>
            </div>
          </div>
        </div>

      </div>

    </div>
  </div>
</header>
