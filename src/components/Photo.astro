---
// Fotografia w organicznej masce. Dopóki klient nie wgra zdjęć, renderuje
// markowy placeholder w kolorach palety (czytelny, „zaprojektowany”, nie zepsuty).
// Aby użyć prawdziwego zdjęcia: przekaż `src` (np. "/photos/zespol.jpg").
interface Props {
  src?: string;
  alt: string;
  label?: string;
  emoji?: string;
  icon?: string; // SVG string — nadpisuje emoji gdy podany
  color?: string; // hex
  mask?: "blob" | "blob2" | "wing" | "rounded";
  ratio?: string; // np. "4/5"
  class?: string;
}
const {
  src,
  alt,
  label,
  emoji = "📷",
  icon,
  color = "#f39200",
  mask = "blob",
  ratio = "4/5",
  class: className = "",
} = Astro.props;

const maskClass = {
  blob: "rounded-blob",
  blob2: "rounded-blob-2",
  wing: "clip-wing",
  rounded: "rounded-[32px]",
}[mask];
---
<figure
  class:list={["relative overflow-hidden", maskClass, className]}
  style={`aspect-ratio:${ratio}`}
>
  {src ? (
    <img src={src} alt={alt} class="h-full w-full object-cover" loading="lazy" />
  ) : (
    <div
      class="relative grid h-full w-full place-items-center"
      style={`background:
        radial-gradient(120% 120% at 20% 10%, ${color}33 0%, transparent 60%),
        radial-gradient(120% 120% at 90% 90%, ${color}55 0%, transparent 55%),
        ${color}1f`}
      role="img"
      aria-label={alt}
    >
      {icon ? (
        <span class="flex h-16 w-16 items-center justify-center opacity-70 sm:h-20 sm:w-20"><Fragment set:html={icon} /></span>
      ) : (
        <span class="text-5xl opacity-80 sm:text-6xl">{emoji}</span>
      )}
      {label && (
        <figcaption class="absolute bottom-4 left-4 right-4 text-fluid-sm font-medium text-graphite/70">
          {label}
        </figcaption>
      )}
      <span
        class="pointer-events-none absolute inset-0 mix-blend-multiply opacity-[0.07]"
        style="background-image:url('/brand/pattern.png'); background-size:160px;"
      ></span>
    </div>
  )}
</figure>
