---
import SectionHeading from "@components/SectionHeading.astro";
import Photo from "@components/Photo.astro";

const shots = [
  { alt: "Ekspres ciśnieniowy w akcji", icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8h1a4 4 0 010 8h-1"/><path d="M2 8h16v9a4 4 0 01-4 4H6a4 4 0 01-4-4V8z"/><path d="M6 1v3M10 1v3M14 1v3"/></svg>`, color: "#f39200", label: "Ekspres", mask: "blob", span: "sm:col-span-2 sm:row-span-2", ratio: "1/1" },
  { alt: "Domowe ciasta na ladzie", icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-8a2 2 0 00-2-2H6a2 2 0 00-2 2v8"/><path d="M4 16s.5-1 2-1 2.5 2 4 2 1.5-2 3-2 2.5 2 4 2 2-1 2-1"/><path d="M2 21h20"/><path d="M7 11V8a5 5 0 0110 0v3"/></svg>`, color: "#e8afcd", label: "Ciasta", mask: "rounded", span: "", ratio: "4/3" },
  { alt: "Bar i baristka", icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round"><path d="M6 13.87A4 4 0 017.41 6a5.11 5.11 0 019.18 0A4 4 0 0118 13.87V21H6v-7.13z"/><path d="M6 17h12"/></svg>`, color: "#2c5ea9", label: "Bar", mask: "rounded", span: "", ratio: "4/3" },
  { alt: "Zielony ogródek kawiarni", icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round"><path d="M2 22c0 0 7.5-7.5 7.5-14.5C9.5 4.5 7 2 7 2s3 1 5 3c3 3 4 7 1 11M2 22s5-5 9-9"/></svg>`, color: "#00955e", label: "Ogródek", mask: "rounded", span: "sm:col-span-2", ratio: "16/7" },
  { alt: "Goście podczas wydarzenia", icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18V5l12-2v13"/><circle cx="6" cy="18" r="3"/><circle cx="18" cy="16" r="3"/></svg>`, color: "#de3c42", label: "Wydarzenia", mask: "rounded", span: "", ratio: "4/3" },
  { alt: "Uśmiechnięci ludzie przy stoliku", icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 00-3-3.87M16 3.13a4 4 0 010 7.75"/></svg>`, color: "#ffde00", label: "Ludzie", mask: "rounded", span: "", ratio: "4/3" },
];
---
<section class="relative bg-graphite-100 py-20 sm:py-28">
  <div class="shell">
    <div class="flex flex-wrap items-end justify-between gap-6">
      <SectionHeading
        kicker="Nasza kawiarnia"
        title="Wejdź — <span class='text-orange'>poczuj</span> atmosferę"
      >
        <p class="mt-3 max-w-md text-fluid-sm text-graphite-soft">
          Zapach świeżo zmielonej kawy, gwar rozmów i światło wpadające do ogródka.
        </p>
      </SectionHeading>
      <a href="/kawiarnia" class="btn-ink group">
        <span class="grid h-5 w-5 place-items-center rounded-full bg-white/20 transition-transform duration-300 group-hover:scale-110">
          <svg class="h-3 w-3" viewBox="0 0 10 10" fill="currentColor" aria-hidden="true"><path d="M3 2l5 3-5 3V2z"/></svg>
        </span>
        Wirtualny spacer 360°
      </a>
    </div>

    <div class="mt-10 grid auto-rows-[1fr] grid-cols-2 gap-4 sm:grid-cols-4">
      {shots.map((s) => (
        <div class:list={["transition-transform duration-500 hover:-translate-y-1", s.span]}>
          <Photo alt={s.alt} icon={s.icon} color={s.color} label={s.label} mask={s.mask} ratio={s.ratio} class="h-full" />
        </div>
      ))}
    </div>
  </div>
</section>
