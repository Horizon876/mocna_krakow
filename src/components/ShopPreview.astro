---
import SectionHeading from "@components/SectionHeading.astro";
import { PRODUCTS, COLORS } from "@data/site";
const featured = PRODUCTS.slice(0, 4);

// SVG icons dla 4 wyróżnionych produktów (kawa, voucher, kubek, świeca)
const productIcons = [
  // kawa — filiżanka
  `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8h1a4 4 0 010 8h-1"/><path d="M2 8h16v9a4 4 0 01-4 4H6a4 4 0 01-4-4V8z"/><path d="M6 1v3M10 1v3M14 1v3"/></svg>`,
  // voucher — prezent
  `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 12 20 22 4 22 4 12"/><rect x="2" y="7" width="20" height="5"/><line x1="12" y1="22" x2="12" y2="7"/><path d="M12 7H7.5a2.5 2.5 0 010-5C11 2 12 7 12 7z"/><path d="M12 7h4.5a2.5 2.5 0 000-5C13 2 12 7 12 7z"/></svg>`,
  // kubek ceramiczny — kubek
  `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8h1a4 4 0 010 8h-1"/><path d="M2 8h16v9a4 4 0 01-4 4H6a4 4 0 01-4-4V8z"/></svg>`,
  // świeca sojowa — płomień
  `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2C8 7 6 10 6 14a6 6 0 0012 0c0-4-2-7-6-12z"/><path d="M12 8c-1.5 2.5-2 4.5-2 6a2 2 0 004 0c0-1.5-.5-3.5-2-6z"/></svg>`,
];
---
<section class="relative bg-graphite-100 py-20 sm:py-28">
  <div class="shell">
    <div class="flex flex-wrap items-end justify-between gap-6">
      <SectionHeading
        kicker="Sklep MOCnej"
        title="Zabierz kawałek MOCy <span class='text-orange'>do domu</span>"
      >
        <p class="mt-3 max-w-md text-fluid-sm text-graphite-soft">
          Czysto, minimalistycznie i z sercem. Każdy zakup wspiera miejsca pracy.
        </p>
      </SectionHeading>
      <a href="/sklep" class="btn-orange">Wejdź do sklepu →</a>
    </div>

    <div class="mt-10 grid grid-cols-2 gap-4 lg:grid-cols-4">
      {featured.map((p, i) => (
        <a href="/sklep" class="group relative flex flex-col overflow-hidden rounded-[24px] border border-white bg-white transition-all duration-500 hover:-translate-y-1 hover:shadow-soft">
          <div
            class="grid aspect-square place-items-center"
            style={`background:${COLORS[p.color]}18`}
          >
            <span class="flex h-14 w-14 items-center justify-center transition-transform duration-500 group-hover:scale-110" style={`color:${COLORS[p.color]}`}>
              <Fragment set:html={productIcons[i]} />
            </span>
          </div>
          <div class="flex flex-1 flex-col p-5">
            <span class="text-xs font-medium uppercase tracking-[0.14em]" style={`color:${COLORS[p.color]}`}>{p.tag}</span>
            <h3 class="mt-1 text-fluid-sm font-semibold leading-snug text-graphite">{p.name}</h3>
            <p class="mt-auto pt-3 font-display text-fluid-lg font-bold tracking-tightest text-graphite">{p.price}</p>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>
