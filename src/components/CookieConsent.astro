---
/** Pasek zgody na cookies — styl marki MOCna!, responsywny na mobile. */
---
<div
  id="cookie-consent"
  class="cookie-consent hidden"
  role="dialog"
  aria-labelledby="cookie-consent-title"
  aria-describedby="cookie-consent-desc"
  aria-hidden="true"
>
  <div class="cookie-consent__inner shell">
    <div class="cookie-consent__accent" aria-hidden="true"></div>

    <div class="cookie-consent__body">
      <div class="cookie-consent__icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" class="h-6 w-6 sm:h-7 sm:w-7" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 2a10 10 0 1 0 10 10 4 4 0 0 1-5-5 4 4 0 0 1-5-5" />
          <path d="M8.5 8.5v.01" />
          <path d="M16 15.5v.01" />
          <path d="M12 12v.01" />
          <path d="M7 14v.01" />
        </svg>
      </div>

      <div class="cookie-consent__text">
        <p id="cookie-consent-title" class="cookie-consent__title">
          Pliki cookies
        </p>
        <p id="cookie-consent-desc" class="cookie-consent__desc">
          Używamy niezbędnych plików cookies, aby koszyk, rezerwacje i podstawowe funkcje serwisu działały poprawnie.
          Szczegóły znajdziesz w
          <a href="/polityka-prywatnosci#cookies" class="cookie-consent__link">polityce prywatności</a>.
        </p>
      </div>

      <div class="cookie-consent__actions">
        <a href="/polityka-prywatnosci#cookies" class="cookie-consent__secondary btn-outline">
          Więcej informacji
        </a>
        <button type="button" id="cookie-consent-accept" class="cookie-consent__primary btn-orange">
          Akceptuję
        </button>
      </div>
    </div>
  </div>
</div>

<script>
  import { initCookieConsent } from "../scripts/cookie-consent";
  initCookieConsent();
  document.addEventListener("astro:page-load", initCookieConsent);
</script>

<style>
  .cookie-consent {
    position: fixed;
    inset-inline: 0;
    bottom: 0;
    z-index: 55;
    pointer-events: none;
    padding-inline: 0;
    padding-bottom: max(0.75rem, env(safe-area-inset-bottom, 0px));
    animation: cookie-rise 0.55s cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  .cookie-consent__inner {
    pointer-events: auto;
    max-width: 1320px;
    padding-inline: 1rem;
  }

  @media (min-width: 640px) {
    .cookie-consent__inner {
      padding-inline: 2rem;
    }
  }

  @media (min-width: 1024px) {
    .cookie-consent__inner {
      padding-inline: 3rem;
    }
  }

  .cookie-consent__body {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    border: 1px solid #e7e6e4;
    background: rgba(255, 248, 240, 0.97);
    padding: 1rem 1rem 1.125rem;
    box-shadow:
      0 -4px 24px -8px rgba(51, 51, 51, 0.12),
      0 8px 32px -12px rgba(44, 94, 169, 0.18);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    position: relative;
    overflow: hidden;
  }

  @media (min-width: 640px) {
    .cookie-consent__body {
      flex-direction: row;
      align-items: center;
      gap: 1.25rem;
      padding: 1.125rem 1.25rem 1.125rem 1rem;
    }
  }

  .cookie-consent__accent {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 4px;
    background: var(--mocna-blue);
  }

  .cookie-consent__icon {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    color: var(--mocna-blue);
    background: rgba(44, 94, 169, 0.1);
    border: 1px solid rgba(44, 94, 169, 0.15);
  }

  @media (min-width: 640px) {
    .cookie-consent__icon {
      width: 3rem;
      height: 3rem;
      margin-left: 0.25rem;
    }
  }

  .cookie-consent__text {
    flex: 1;
    min-width: 0;
    padding-left: 0.25rem;
  }

  .cookie-consent__title {
    font-family: "Clash Display", system-ui, sans-serif;
    font-weight: 700;
    font-size: clamp(1rem, 2.5vw, 1.125rem);
    letter-spacing: -0.02em;
    color: var(--mocna-graphite);
    line-height: 1.2;
  }

  .cookie-consent__desc {
    margin-top: 0.375rem;
    font-size: clamp(0.8125rem, 2.2vw, 0.9375rem);
    line-height: 1.55;
    color: #5c5c5c;
  }

  .cookie-consent__link {
    color: var(--mocna-blue);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 2px;
    transition: color 0.2s ease;
  }

  .cookie-consent__link:hover {
    color: #244d8f;
  }

  .cookie-consent__actions {
    display: flex;
    flex-direction: column-reverse;
    gap: 0.625rem;
    width: 100%;
    flex-shrink: 0;
  }

  @media (min-width: 640px) {
    .cookie-consent__actions {
      flex-direction: row;
      width: auto;
      gap: 0.75rem;
    }
  }

  .cookie-consent__primary,
  .cookie-consent__secondary {
    width: 100%;
    justify-content: center;
    white-space: nowrap;
    padding-block: 0.75rem;
    font-size: 0.875rem;
  }

  @media (min-width: 640px) {
    .cookie-consent__primary,
    .cookie-consent__secondary {
      width: auto;
      min-width: 8.5rem;
      padding-inline: 1.25rem;
    }
  }

  .cookie-consent__secondary:hover {
    transform: translateY(-2px);
  }

  :global(body.cookie-consent-open) {
    padding-bottom: var(--cookie-banner-offset, 0px);
  }

  @keyframes cookie-rise {
    from {
      opacity: 0;
      transform: translateY(100%);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  :global(html[data-motion="lite"]) .cookie-consent,
  :global(html[data-motion="reduced"]) .cookie-consent {
    animation: none;
  }
</style>
