---
import SectionHeading from "@components/SectionHeading.astro";
import { MEDIA, COLORS } from "@data/site";
---
<section class="relative py-20 sm:py-28">
  <div class="shell">
    <SectionHeading
      align="center"
      kicker="W mediach"
      title="Mówią o nas <span class='text-orange'>głośno</span>"
    />

    <div class="mt-12 grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-6">
      {MEDIA.map((m) => (
        <a
          href={m.href}
          target="_blank"
          rel="noopener"
          title={m.title}
          class="media-logo group relative grid aspect-[3/2] place-items-center overflow-hidden rounded-2xl border border-graphite-200 bg-white p-4 text-center transition-all duration-500 hover:-translate-y-1 hover:shadow-soft"
          style={`--c:${COLORS[m.accent]}`}
        >
          <span class="font-display text-fluid-sm font-bold leading-tight tracking-tightest text-graphite-muted transition-colors duration-500 group-hover:text-[color:var(--c)]">
            {m.outlet}
          </span>
          <span class="pointer-events-none absolute inset-x-4 bottom-3 text-[10px] leading-snug text-graphite-muted opacity-0 transition-opacity duration-500 group-hover:opacity-100">
            {m.title}
          </span>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .media-logo {
    filter: grayscale(1);
  }
  .media-logo:hover {
    filter: grayscale(0);
    border-color: var(--c);
  }
</style>
