---
import BrandBlobs from "@components/BrandBlobs.astro";
interface Props {
  kicker?: string;
  title: string;
  lead?: string;
  variant?: "hero" | "soft" | "warm" | "cool";
  animated?: boolean;
}
const { kicker, title, lead, variant = "soft", animated = true } = Astro.props;
---
<section class="relative overflow-hidden pt-8 pb-4 sm:pt-12 sm:pb-6">
  <BrandBlobs variant={variant} animated={animated} />
  <div class="shell relative">
    {kicker && <span class="kicker">{kicker}</span>}
    <h1 class="text-fluid-hero font-display font-bold leading-tighter tracking-tightest text-balance" set:html={title} />
    {lead && <p class="mt-6 text-fluid-lg font-light leading-relaxed text-graphite-soft text-pretty max-w-3xl">{lead}</p>}
    <slot />
  </div>
</section>
