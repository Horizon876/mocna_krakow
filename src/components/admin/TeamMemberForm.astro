---
import { actions, isInputError } from 'astro:actions';

interface Props {
  member?: {
    id: string;
    name: string;
    description: string;
    slug: string;
    photoUrl: string | null;
    photoPosition: string | null;
    accent: string;
    sortOrder: number;
  };
}

const { member } = Astro.props;
const isEdit = !!member;

const resultCreate = Astro.getActionResult(actions.createTeamMember);
const resultUpdate = Astro.getActionResult(actions.updateTeamMember);
const result = isEdit ? resultUpdate : resultCreate;
const inputError = result?.error && isInputError(result.error) ? result.error : null;

const action = isEdit ? actions.updateTeamMember : actions.createTeamMember;
const initialPhoto = member?.photoUrl || '';
const initialPosition = member?.photoPosition || '50% 50%';
---

<form method="POST" action={action} enctype="multipart/form-data" class="space-y-5" id="team-member-form">
  {isEdit && <input type="hidden" name="id" value={member.id} />}
  {isEdit && member.photoUrl && <input type="hidden" name="existingPhotoUrl" value={member.photoUrl} />}

  {result?.error && (
    <div class="alert-error">
      <span aria-hidden="true">⚠</span> Wystąpił błąd podczas zapisywania. Sprawdź poprawność danych.
    </div>
  )}
  {result?.data?.success && (
    <div class="alert-success">
      <span aria-hidden="true">✓</span> Osoba została pomyślnie zapisana!
    </div>
  )}

  <div class="space-y-1.5">
    <label for="name" class="field-label">Imię i nazwisko</label>
    <input type="text" id="name" name="name" value={member?.name || ''} required class="field-input" placeholder="np. Kasia Kubicka" />
    {inputError?.fields.name && (
      <p class="mt-1 text-xs font-medium text-red">{inputError.fields.name[0]}</p>
    )}
  </div>

  <div class="space-y-1.5">
    <label for="description" class="field-label">Opis</label>
    <textarea id="description" name="description" rows="4" required class="field-input" placeholder="Krótki opis osoby wyświetlany na kafelku...">{member?.description || ''}</textarea>
    {inputError?.fields.description && (
      <p class="mt-1 text-xs font-medium text-red">{inputError.fields.description[0]}</p>
    )}
  </div>

  <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
    <div class="space-y-1.5">
      <label for="accent" class="field-label">Kolor akcentu</label>
      <select id="accent" name="accent" class="field-input cursor-pointer appearance-none">
        <option value="blue" selected={member?.accent === 'blue' || !member}>Niebieski</option>
        <option value="red" selected={member?.accent === 'red'}>Czerwony</option>
        <option value="green" selected={member?.accent === 'green'}>Zielony</option>
        <option value="orange" selected={member?.accent === 'orange'}>Pomarańczowy</option>
        <option value="pink" selected={member?.accent === 'pink'}>Różowy</option>
        <option value="yellow" selected={member?.accent === 'yellow'}>Żółty</option>
        <option value="graphite" selected={member?.accent === 'graphite'}>Grafitowy</option>
      </select>
    </div>
    <div class="space-y-1.5">
      <label for="sortOrder" class="field-label">Kolejność</label>
      <input type="number" id="sortOrder" name="sortOrder" value={member?.sortOrder ?? ''} min="0" class="field-input" placeholder="np. 0" />
      <p class="text-xs text-graphite-muted">Mniejsza liczba = wyżej na liście</p>
    </div>
  </div>

  <div class="space-y-1.5">
    <label for="slug" class="field-label">Slug (opcjonalnie)</label>
    <input type="text" id="slug" name="slug" value={member?.slug || ''} class="field-input" placeholder="np. kasia-kubicka" />
    <p class="text-xs text-graphite-muted">Jeśli puste, wygenerujemy z imienia</p>
  </div>

  <!-- Zdjęcie + kadrowanie -->
  <div class="space-y-3" id="photo-cropper" data-initial-src={initialPhoto} data-initial-pos={initialPosition}>
    <div class="flex items-center justify-between gap-3">
      <label class="field-label mb-0" for="imageFile">Zdjęcie i kadrowanie</label>
      <button type="button" id="crop-reset" class="text-xs font-semibold uppercase tracking-wider text-blue hover:text-blue/80 disabled:opacity-40 disabled:pointer-events-none" disabled={!initialPhoto}>
        Resetuj kadr
      </button>
    </div>

    <input type="hidden" id="photoPosition" name="photoPosition" value={initialPosition} />

    <div
      id="crop-stage"
      class="photo-crop-stage relative mx-auto aspect-square w-full max-w-[280px] overflow-hidden border border-graphite-200 bg-graphite-100 select-none"
      role="img"
      aria-label="Podgląd kadrowania zdjęcia. Przeciągnij, aby zmienić kadr."
    >
      <img
        id="crop-preview"
        src={initialPhoto || undefined}
        alt=""
        class="pointer-events-none absolute inset-0 h-full w-full object-cover"
        style={`object-position: ${initialPosition};`}
        draggable="false"
      />
      <div id="crop-empty" class:list={["absolute inset-0 flex flex-col items-center justify-center gap-2 px-6 text-center", initialPhoto && "hidden"]}>
        <svg class="h-10 w-10 text-graphite-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
          <rect x="3" y="3" width="18" height="18" />
          <circle cx="8.5" cy="8.5" r="1.5" />
          <path d="M21 15l-5-5L5 21" />
        </svg>
        <p class="text-sm text-graphite-muted">Wybierz zdjęcie poniżej</p>
      </div>
      <div id="crop-hint" class:list={["pointer-events-none absolute inset-x-0 bottom-0 bg-gradient-to-t from-graphite/70 to-transparent px-3 pb-3 pt-8 text-center text-[11px] font-medium uppercase tracking-wider text-white", !initialPhoto && "hidden"]}>
        Przeciągnij, aby wykadrować
      </div>
      <div id="crop-crosshair" class:list={["pointer-events-none absolute left-1/2 top-1/2 h-5 w-5 -translate-x-1/2 -translate-y-1/2", !initialPhoto && "hidden"]} aria-hidden="true">
        <span class="absolute inset-x-0 top-1/2 h-px -translate-y-1/2 bg-white/80"></span>
        <span class="absolute inset-y-0 left-1/2 w-px -translate-x-1/2 bg-white/80"></span>
        <span class="absolute left-1/2 top-1/2 h-2 w-2 -translate-x-1/2 -translate-y-1/2 rounded-full border border-white bg-blue/90 shadow-sm"></span>
      </div>
    </div>

    <div id="crop-controls" class:list={["space-y-3", !initialPhoto && "opacity-40 pointer-events-none"]}>
      <div class="grid grid-cols-3 gap-2">
        <button type="button" data-preset="50% 20%" class="crop-preset btn btn-outline !rounded-none px-2 py-2 text-[12px]">Góra</button>
        <button type="button" data-preset="50% 50%" class="crop-preset btn btn-outline !rounded-none px-2 py-2 text-[12px]">Środek</button>
        <button type="button" data-preset="50% 80%" class="crop-preset btn btn-outline !rounded-none px-2 py-2 text-[12px]">Dół</button>
      </div>

      <div class="space-y-1.5">
        <div class="flex items-center justify-between">
          <label for="crop-y" class="text-xs font-medium text-graphite-muted">Pion</label>
          <span id="crop-y-label" class="text-xs tabular-nums text-graphite-muted">50%</span>
        </div>
        <input type="range" id="crop-y" min="0" max="100" step="1" value="50" class="crop-range w-full" />
      </div>

      <div class="space-y-1.5">
        <div class="flex items-center justify-between">
          <label for="crop-x" class="text-xs font-medium text-graphite-muted">Poziom</label>
          <span id="crop-x-label" class="text-xs tabular-nums text-graphite-muted">50%</span>
        </div>
        <input type="range" id="crop-x" min="0" max="100" step="1" value="50" class="crop-range w-full" />
      </div>
    </div>

    <div class="space-y-1.5">
      <label for="imageFile" class="field-label">Wybierz plik (JPG, PNG, WebP)</label>
      <input type="file" id="imageFile" name="imageFile" accept="image/png,image/jpeg,image/webp,image/gif" class="field-input" />
      <p id="file-name" class="text-xs text-graphite-muted">{initialPhoto ? 'Obecne zdjęcie — możesz wymienić' : ''}</p>
    </div>
  </div>

  <button type="submit" class="btn btn-orange mt-8 w-full">
    {isEdit ? 'Zapisz zmiany' : 'Dodaj osobę'}
  </button>
  {isEdit && (
    <a href="/admin/ludzie" class="btn btn-outline mt-3 block w-full justify-center text-center">
      Anuluj edycję
    </a>
  )}
</form>

<style>
  .photo-crop-stage {
    cursor: grab;
    touch-action: none;
  }
  .photo-crop-stage.is-dragging {
    cursor: grabbing;
  }
  .photo-crop-stage.is-empty {
    cursor: default;
  }
  .crop-range {
    -webkit-appearance: none;
    appearance: none;
    height: 4px;
    border-radius: 0;
    background: #e5e2dc;
    outline: none;
  }
  .crop-range::-webkit-slider-thumb {
    -webkit-appearance: none;
    appearance: none;
    width: 16px;
    height: 16px;
    border-radius: 9999px;
    background: var(--mocna-blue);
    border: 2px solid #fff;
    box-shadow: 0 0 0 1px rgba(51, 51, 51, 0.15);
    cursor: pointer;
  }
  .crop-range::-moz-range-thumb {
    width: 16px;
    height: 16px;
    border-radius: 9999px;
    background: var(--mocna-blue);
    border: 2px solid #fff;
    box-shadow: 0 0 0 1px rgba(51, 51, 51, 0.15);
    cursor: pointer;
  }
  .crop-preset.is-active {
    border-color: var(--mocna-blue);
    color: var(--mocna-blue);
    background: color-mix(in srgb, var(--mocna-blue) 8%, white);
  }
</style>

<script>
  const KEYWORDS = {
    left: 0,
    center: 50,
    right: 100,
    top: 0,
    bottom: 100,
  };

  function parsePos(raw) {
    if (!raw || !String(raw).trim()) return { x: 50, y: 50 };
    const parts = String(raw).trim().split(/\s+/);
    const toNum = (token, fallback) => {
      if (token.endsWith('%')) {
        const n = parseFloat(token);
        return Number.isFinite(n) ? Math.min(100, Math.max(0, n)) : fallback;
      }
      if (token in KEYWORDS) return KEYWORDS[token];
      return fallback;
    };
    if (parts.length === 1) {
      return { x: 50, y: toNum(parts[0], 50) };
    }
    return { x: toNum(parts[0], 50), y: toNum(parts[1], 50) };
  }

  function formatPos(pos) {
    return `${Math.round(pos.x)}% ${Math.round(pos.y)}%`;
  }

  function setupPhotoCropper() {
    const root = document.getElementById('photo-cropper');
    const form = document.getElementById('team-member-form');
    if (!root || !form || root.dataset.bound === '1') return;
    root.dataset.bound = '1';

    const stage = document.getElementById('crop-stage');
    const preview = document.getElementById('crop-preview');
    const empty = document.getElementById('crop-empty');
    const hint = document.getElementById('crop-hint');
    const crosshair = document.getElementById('crop-crosshair');
    const controls = document.getElementById('crop-controls');
    const hidden = document.getElementById('photoPosition');
    const fileInput = document.getElementById('imageFile');
    const fileName = document.getElementById('file-name');
    const resetBtn = document.getElementById('crop-reset');
    const rangeX = document.getElementById('crop-x');
    const rangeY = document.getElementById('crop-y');
    const labelX = document.getElementById('crop-x-label');
    const labelY = document.getElementById('crop-y-label');
    const presets = Array.from(root.querySelectorAll('.crop-preset'));

    let pos = parsePos(root.dataset.initialPos || hidden.value);
    let hasPhoto = Boolean(root.dataset.initialSrc);
    let objectUrl = null;
    let dragging = false;
    let lastPointer = null;

    function setHasPhoto(next) {
      hasPhoto = next;
      empty.classList.toggle('hidden', next);
      hint.classList.toggle('hidden', !next);
      crosshair.classList.toggle('hidden', !next);
      controls.classList.toggle('opacity-40', !next);
      controls.classList.toggle('pointer-events-none', !next);
      stage.classList.toggle('is-empty', !next);
      resetBtn.disabled = !next;
    }

    function applyPos(next, syncRanges = true) {
      pos = {
        x: Math.min(100, Math.max(0, next.x)),
        y: Math.min(100, Math.max(0, next.y)),
      };
      const formatted = formatPos(pos);
      hidden.value = formatted;
      preview.style.objectPosition = formatted;
      if (syncRanges) {
        rangeX.value = String(Math.round(pos.x));
        rangeY.value = String(Math.round(pos.y));
      }
      labelX.textContent = `${Math.round(pos.x)}%`;
      labelY.textContent = `${Math.round(pos.y)}%`;

      presets.forEach((btn) => {
        const preset = parsePos(btn.dataset.preset);
        const active =
          Math.abs(preset.x - pos.x) < 1 && Math.abs(preset.y - pos.y) < 1;
        btn.classList.toggle('is-active', active);
      });
    }

    function showSrc(src) {
      if (!src) {
        preview.removeAttribute('src');
        setHasPhoto(false);
        return;
      }
      preview.src = src;
      setHasPhoto(true);
    }

    applyPos(pos);
    setHasPhoto(hasPhoto);

    rangeX.addEventListener('input', () => {
      applyPos({ x: Number(rangeX.value), y: pos.y }, false);
      labelX.textContent = `${rangeX.value}%`;
    });
    rangeY.addEventListener('input', () => {
      applyPos({ x: pos.x, y: Number(rangeY.value) }, false);
      labelY.textContent = `${rangeY.value}%`;
    });

    presets.forEach((btn) => {
      btn.addEventListener('click', () => {
        applyPos(parsePos(btn.dataset.preset));
      });
    });

    resetBtn.addEventListener('click', () => {
      applyPos({ x: 50, y: 50 });
    });

    fileInput.addEventListener('change', () => {
      const file = fileInput.files?.[0];
      if (!file) return;
      const form = document.getElementById('team-member-form');
      const scrollParent = form?.closest('.admin-crud-body');
      const prevScroll = scrollParent ? scrollParent.scrollTop : 0;
      if (objectUrl) URL.revokeObjectURL(objectUrl);
      objectUrl = URL.createObjectURL(file);
      showSrc(objectUrl);
      fileName.textContent = file.name;
      applyPos({ x: 50, y: 50 });
      fileInput.blur();
      requestAnimationFrame(() => {
        if (scrollParent) scrollParent.scrollTop = prevScroll;
      });
    });

    const onPointerDown = (e) => {
      if (!hasPhoto) return;
      dragging = true;
      lastPointer = { x: e.clientX, y: e.clientY };
      stage.classList.add('is-dragging');
      stage.setPointerCapture(e.pointerId);
    };

    const onPointerMove = (e) => {
      if (!dragging || !lastPointer || !hasPhoto) return;
      const rect = stage.getBoundingClientRect();
      const dx = e.clientX - lastPointer.x;
      const dy = e.clientY - lastPointer.y;
      lastPointer = { x: e.clientX, y: e.clientY };
      const sensX = 100 / Math.max(rect.width, 1);
      const sensY = 100 / Math.max(rect.height, 1);
      applyPos({
        x: pos.x - dx * sensX,
        y: pos.y - dy * sensY,
      });
    };

    const onPointerUp = (e) => {
      if (!dragging) return;
      dragging = false;
      lastPointer = null;
      stage.classList.remove('is-dragging');
      try {
        stage.releasePointerCapture(e.pointerId);
      } catch {
        /* ignore */
      }
    };

    stage.addEventListener('pointerdown', onPointerDown);
    stage.addEventListener('pointermove', onPointerMove);
    stage.addEventListener('pointerup', onPointerUp);
    stage.addEventListener('pointercancel', onPointerUp);

    form.addEventListener('submit', () => {
      const btn = form.querySelector('button[type="submit"]');
      if (btn) {
        btn.innerHTML = '<span class="inline-block mr-2 h-4 w-4 animate-spin rounded-full border-2 border-white/40 border-t-white"></span> Przetwarzanie...';
        btn.classList.add('opacity-70', 'cursor-not-allowed', 'pointer-events-none');
      }
    });
  }

  setupPhotoCropper();
  document.addEventListener('astro:page-load', setupPhotoCropper);
</script>
