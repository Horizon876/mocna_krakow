---
import { actions, isInputError } from 'astro:actions';

interface Props {
  item?: {
    id: string;
    name: string;
    logoUrl: string | null;
    href: string | null;
    sortOrder: number;
  };
}

const { item } = Astro.props;
const isEdit = !!item;

const resultCreate = Astro.getActionResult(actions.createMediaLogo);
const resultUpdate = Astro.getActionResult(actions.updateMediaLogo);
const result = isEdit ? resultUpdate : resultCreate;
const inputError = result?.error && isInputError(result.error) ? result.error : null;
const action = isEdit ? actions.updateMediaLogo : actions.createMediaLogo;
---

<form method="POST" action={action} enctype="multipart/form-data" class="space-y-5" id="media-logo-form">
  {isEdit && <input type="hidden" name="id" value={item.id} />}
  {isEdit && item.logoUrl && <input type="hidden" name="existingLogoUrl" value={item.logoUrl} />}

  {result?.error && (
    <div class="alert-error">
      <span aria-hidden="true">⚠</span> Wystąpił błąd podczas zapisywania. Sprawdź poprawność danych.
    </div>
  )}
  {result?.data?.success && (
    <div class="alert-success">
      <span aria-hidden="true">✓</span> Kafelek został zapisany!
    </div>
  )}

  <div class="space-y-1.5">
    <label for="name" class="field-label">Nazwa mediów</label>
    <input type="text" id="name" name="name" value={item?.name || ''} required class="field-input" placeholder="np. TVP 3 Kraków" />
    {inputError?.fields.name && (
      <p class="mt-1 text-xs font-medium text-red">{inputError.fields.name[0]}</p>
    )}
  </div>

  <div class="space-y-1.5">
    <label for="href" class="field-label">Link (opcjonalnie)</label>
    <input type="url" id="href" name="href" value={item?.href || ''} class="field-input" placeholder="https://..." />
    <p class="text-xs text-graphite-muted">Adres artykułu / materiału — kafelek będzie klikalny</p>
  </div>

  <div class="space-y-1.5">
    <label for="sortOrder" class="field-label">Kolejność</label>
    <input type="number" id="sortOrder" name="sortOrder" value={item?.sortOrder ?? ''} min="0" class="field-input" placeholder="np. 0" />
    <p class="text-xs text-graphite-muted">Mniejsza liczba = wcześniej na liście</p>
  </div>

  <div class="space-y-1.5">
    <label for="imageFile" class="field-label">Logo</label>
    {item?.logoUrl && (
      <div class="mb-3 flex h-24 w-24 items-center justify-center border border-graphite-200 bg-white p-2">
        <img src={item.logoUrl} alt="" class="max-h-full max-w-full object-contain" />
      </div>
    )}
    <input
      type="file"
      id="imageFile"
      name="imageFile"
      accept="image/png,image/jpeg,image/webp,image/gif"
      class="field-input"
      required={!isEdit && !item?.logoUrl}
    />
    <p class="text-xs text-graphite-muted">
      {item?.logoUrl ? 'Obecne logo — możesz wymienić' : 'PNG, JPG, WebP lub GIF'}
    </p>
  </div>

  <button type="submit" class="btn btn-orange mt-8 w-full">
    {isEdit ? 'Zapisz zmiany' : 'Dodaj kafelek'}
  </button>
  {isEdit && (
    <a href="/admin/media" class="btn btn-outline mt-3 block w-full justify-center text-center">
      Anuluj edycję
    </a>
  )}
</form>

<script>
  function setupForm() {
    const form = document.getElementById('media-logo-form');
    if (!form || form.dataset.bound === '1') return;
    form.dataset.bound = '1';
    form.addEventListener('submit', () => {
      const btn = form.querySelector('button[type="submit"]');
      if (btn) {
        btn.innerHTML = '<span class="inline-block mr-2 h-4 w-4 animate-spin rounded-full border-2 border-white/40 border-t-white"></span> Przetwarzanie...';
        btn.classList.add('opacity-70', 'cursor-not-allowed', 'pointer-events-none');
      }
    });
  }
  setupForm();
  document.addEventListener('astro:page-load', setupForm);
</script>
