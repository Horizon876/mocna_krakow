---
import { actions } from 'astro:actions';

interface Props {
  product?: {
    id: string;
    name: string;
    description: string | null;
    price: number;
    imageUrl: string | null;
    availabilityStatus: string | null;
  };
}

const { product } = Astro.props;
const isEdit = !!product;

const resultCreate = Astro.getActionResult(actions.createProduct);
const resultUpdate = Astro.getActionResult(actions.updateProduct);
const result = isEdit ? resultUpdate : resultCreate;

const action = isEdit ? actions.updateProduct : actions.createProduct;
---

<form method="POST" action={action} enctype="multipart/form-data" class="space-y-5" id="product-form">
  {isEdit && <input type="hidden" name="id" value={product.id} />}
  {isEdit && product.imageUrl && <input type="hidden" name="existingImageUrl" value={product.imageUrl} />}

  {result?.error && (
    <div class="alert-error">
      <span aria-hidden="true">⚠</span> Wystąpił błąd podczas zapisywania produktu. Sprawdź poprawność danych.
    </div>
  )}
  {result?.data?.success && (
    <div class="alert-success">
      <span aria-hidden="true">✓</span> Produkt został pomyślnie zapisany!
    </div>
  )}

  <div class="space-y-1.5">
    <label for="name" class="field-label">Nazwa produktu</label>
    <input type="text" id="name" name="name" value={product?.name || ''} required class="field-input" placeholder="np. Kawa MOCna Espresso" />
    {result?.error && 'name' in result.error.fields && (
      <p class="mt-1 text-xs font-medium text-red">{result.error.fields.name?.[0]}</p>
    )}
  </div>

  <div class="space-y-1.5">
    <label for="description" class="field-label">Opis</label>
    <textarea id="description" name="description" rows="3" class="field-input" placeholder="Krótki opis produktu...">{product?.description || ''}</textarea>
  </div>

  <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
    <div class="space-y-1.5">
      <label for="price" class="field-label">Cena (w groszach)</label>
      <input type="number" id="price" name="price" value={product?.price || ''} required min="0" class="field-input" placeholder="np. 1500 (15,00 PLN)" />
      {result?.error && 'price' in result.error.fields && (
        <p class="mt-1 text-xs font-medium text-red">{result.error.fields.price?.[0]}</p>
      )}
    </div>

    <div class="space-y-1.5">
      <label for="availabilityStatus" class="field-label">Status</label>
      <select id="availabilityStatus" name="availabilityStatus" class="field-input cursor-pointer appearance-none">
        <option value="available" selected={product?.availabilityStatus === 'available' || !product}>Dostępny</option>
        <option value="unavailable" selected={product?.availabilityStatus === 'unavailable'}>Niedostępny</option>
      </select>
    </div>
  </div>

  <div class="space-y-1.5">
    <label class="field-label">Zdjęcie produktu</label>

    <div id="dropzone" class="relative cursor-pointer overflow-hidden border-2 border-dashed border-graphite-200 bg-white/80 p-8 text-center">
      <input type="file" id="imageFile" name="imageFile" accept="image/*" class="absolute inset-0 z-10 h-full w-full cursor-pointer opacity-0" />

      <div id="preview-container" class={product?.imageUrl ? '' : 'hidden'}>
        <img id="image-preview" src={product?.imageUrl || ''} alt="Podgląd" class="mx-auto mb-4 max-h-48 object-contain" />
        <p class="text-sm font-medium text-graphite-muted">Kliknij lub przeciągnij, aby zmienić zdjęcie</p>
      </div>

      <div id="placeholder" class={product?.imageUrl ? 'hidden' : ''}>
        <div class="mx-auto mb-4 flex h-16 w-16 items-center justify-center bg-graphite/5 text-3xl">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="h-8 w-8 text-blue" aria-hidden="true">
            <path d="M23 19a2 2 0 01-2 2H3a2 2 0 01-2-2V8a2 2 0 012-2h4l2-3h6l2 3h4a2 2 0 012 2z"/>
            <circle cx="12" cy="13" r="4"/>
          </svg>
        </div>
        <p class="mb-1 font-medium text-graphite">Przeciągnij zdjęcie i upuść tutaj</p>
        <p class="text-sm text-graphite-muted">lub <span class="font-bold text-blue">przeglądaj pliki</span></p>
      </div>
    </div>
  </div>

  <button type="submit" class="btn btn-orange mt-8 w-full">
    {isEdit ? 'Zapisz zmiany' : 'Dodaj produkt'}
  </button>
  {isEdit && (
    <a href="/admin/sklep" class="btn btn-outline mt-3 block w-full justify-center text-center">
      Anuluj edycję
    </a>
  )}
</form>

<script>
  function setupForm() {
    const form = document.getElementById('product-form') as HTMLFormElement;
    if (!form) return;

    form.addEventListener('submit', () => {
      const btn = form.querySelector('button[type="submit"]') as HTMLButtonElement;
      if (btn) {
        btn.innerHTML = '<span class="inline-block mr-2 h-4 w-4 animate-spin rounded-full border-2 border-white/40 border-t-white"></span> Przetwarzanie...';
        btn.classList.add('opacity-70', 'cursor-not-allowed', 'pointer-events-none');
      }
    });

    const fileInput = document.getElementById('imageFile') as HTMLInputElement;
    const previewContainer = document.getElementById('preview-container');
    const imagePreview = document.getElementById('image-preview') as HTMLImageElement;
    const placeholder = document.getElementById('placeholder');
    const dropzone = document.getElementById('dropzone');

    if (!fileInput || !previewContainer || !imagePreview || !placeholder || !dropzone) return;

    ['dragenter', 'dragover', 'dragleave', 'drop'].forEach(eventName => {
      dropzone.addEventListener(eventName, preventDefaults, false);
    });

    function preventDefaults(e: Event) {
      e.preventDefault();
      e.stopPropagation();
    }

    ['dragenter', 'dragover'].forEach(eventName => {
      dropzone.addEventListener(eventName, () => {
        dropzone.classList.add('border-blue', 'bg-blue/10');
      }, false);
    });

    ['dragleave', 'drop'].forEach(eventName => {
      dropzone.addEventListener(eventName, () => {
        dropzone.classList.remove('border-blue', 'bg-blue/10');
      }, false);
    });

    fileInput.addEventListener('change', function() {
      if (this.files && this.files[0]) {
        const reader = new FileReader();

        reader.onload = function(e) {
          if (e.target?.result) {
            imagePreview.src = e.target.result as string;
            previewContainer.classList.remove('hidden');
            placeholder.classList.add('hidden');
          }
        }

        reader.readAsDataURL(this.files[0]);
      }
    });
  }

  setupForm();
  document.addEventListener('astro:page-load', setupForm);
</script>
