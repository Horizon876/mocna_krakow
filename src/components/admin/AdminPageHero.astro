---
interface Props {
  kicker?: string;
  title: string;
  lead?: string;
}
const { kicker = "Panel administratora", title, lead } = Astro.props;
---
<header class="pb-10 sm:pb-14">
  <span class="kicker">{kicker}</span>
  <h1
    class="text-fluid-2xl font-display font-bold leading-tighter tracking-tightest text-balance text-brand-gradient"
    set:html={title}
  />
  {lead && (
    <p class="mt-4 max-w-2xl text-fluid-lg font-light leading-relaxed text-graphite-soft text-pretty">
      {lead}
    </p>
  )}
  <slot />
</header>
