---
import SectionHeading from "@components/SectionHeading.astro";
import BrandBlobs from "@components/BrandBlobs.astro";

const cards = [
  {
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round"><path d="M20.84 4.61a5.5 5.5 0 00-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 00-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 000-7.78z"/></svg>`,
    iconColor: "text-orange",
    title: "Darowizna",
    desc: "Jednorazowo lub cyklicznie — każda złotówka to realne wsparcie miejsc pracy.",
    cta: "Przekaż darowiznę",
    href: "/wesprzyj#darowizna",
    glow: false,
  },
  {
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>`,
    iconColor: "text-blue",
    title: "Patronite",
    desc: "Zostań stałym patronem MOCnej i bądź częścią tej historii każdego miesiąca.",
    cta: "Zostań patronem",
    href: "/wesprzyj#patronite",
    glow: false,
  },
  {
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8h1a4 4 0 010 8h-1"/><path d="M2 8h16v9a4 4 0 01-4 4H6a4 4 0 01-4-4V8z"/><path d="M6 1v3M10 1v3M14 1v3"/></svg>`,
    iconColor: "text-orange",
    title: "Kawa zawieszona",
    desc: "Kup kawę dla kogoś, kogo nie stać. Mała filiżanka, wielki gest.",
    cta: "Zawieś kawę",
    href: "/wesprzyj#zawieszona",
    glow: true,
  },
];
---
<section class="relative overflow-hidden py-20 sm:py-28">
  <BrandBlobs variant="warm" />
  <div class="shell relative">
    <SectionHeading
      align="center"
      kicker="Wesprzyj MOCną!"
      title="Twój gest <span class='text-orange'>tworzy</span> miejsca pracy"
    />

    <div class="mt-12 grid gap-5 lg:grid-cols-3">
      {cards.map((c) => (
        <article
          class:list={[
            "glass relative flex flex-col p-8 transition-transform duration-500 hover:-translate-y-1.5",
            c.glow && "animate-glow border-orange/40",
          ]}
        >
          {c.glow && (
            <span class="absolute right-6 top-6 rounded-full bg-orange px-3 py-1 text-xs font-medium text-white">
              Najpopularniejsze
            </span>
          )}
          <span class:list={["flex h-12 w-12 items-center justify-center", c.iconColor]}><Fragment set:html={c.icon} /></span>
          <h3 class="mt-5 text-fluid-xl font-display font-bold tracking-tightest">{c.title}</h3>
          <p class="mt-3 flex-1 text-fluid-sm leading-relaxed text-graphite-soft">{c.desc}</p>
          <a href={c.href} class:list={["mt-7", c.glow ? "btn-orange" : "btn-outline"]}>{c.cta}</a>
        </article>
      ))}
    </div>

    <div class="mt-12 text-center">
      <a href="/wesprzyj" class="btn-orange animate-glow inline-flex items-center gap-3 px-9 py-4 text-fluid-lg">
        <svg class="h-5 w-5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M20.84 4.61a5.5 5.5 0 00-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 00-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 000-7.78z"/>
        </svg>
        Pomagam tworzyć miejsca pracy
      </a>
    </div>
  </div>
</section>
