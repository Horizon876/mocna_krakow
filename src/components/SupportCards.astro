---
import SectionHeading from "@components/SectionHeading.astro";
import BrandBlobs from "@components/BrandBlobs.astro";

const cards = [
  {
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round"><path d="M20.84 4.61a5.5 5.5 0 00-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 00-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 000-7.78z"/></svg>`,
    iconColor: "text-blue",
    title: "Darowizna",
    titleColor: "text-blue",
    desc: "Jednorazowo lub cyklicznie — każda złotówka to realne wsparcie miejsc pracy.",
    cta: "Przekaż darowiznę",
    ctaClass: "btn border-blue bg-blue text-white hover:border-[#244d8f] hover:bg-[#244d8f]",
    href: "/#wesprzyj-nas",
  },
  {
    logo: "/photos/patronite.png",
    logoAlt: "Patronite",
    title: "Patronite",
    titleColor: "text-red",
    desc: "Zostań stałym patronem MOCnej i bądź częścią tej historii każdego miesiąca.",
    cta: "Zostań patronem",
    ctaClass: "btn border-red bg-red text-white hover:border-[#c42f35] hover:bg-[#c42f35]",
    href: "/#wesprzyj-nas",
  },
  {
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8h1a4 4 0 010 8h-1"/><path d="M2 8h16v9a4 4 0 01-4 4H6a4 4 0 01-4-4V8z"/><path d="M6 1v3M10 1v3M14 1v3"/></svg>`,
    iconColor: "text-orange",
    title: "Kawa zawieszona",
    titleColor: "text-orange",
    titleClass: "whitespace-nowrap",
    desc: "Kup kawę dla kogoś, kogo nie stać. Mała filiżanka, wielki gest.",
    cta: "Zawieś kawę",
    ctaClass: "btn border-orange bg-orange text-white hover:border-orange-ink hover:bg-orange-ink",
    href: "/#wesprzyj-nas",
  },
];
---
<section id="wesprzyj-nas" class="relative scroll-mt-16 overflow-hidden py-20 sm:scroll-mt-[4.5rem] sm:py-28">
  <BrandBlobs variant="warm" />
  <div class="shell relative">
    <SectionHeading
      align="center"
      title="<span class='text-blue'>W</span><span class='text-red'>e</span><span class='text-yellow'>s</span><span class='text-green'>przyj</span> <span class='text-orange'>nas</span>"
    />

    <div class="mt-12 grid gap-5 lg:grid-cols-3">
      {cards.map((c) => (
        <article class="relative flex flex-col border border-graphite-200 bg-white p-8">
          {c.logo ? (
            <img
              src={c.logo}
              alt={c.logoAlt ?? c.title}
              class="h-12 w-auto max-w-[8rem] object-contain object-left"
              loading="lazy"
            />
          ) : (
            <span class:list={["flex h-12 w-12 items-center justify-center", c.iconColor]}>
              <Fragment set:html={c.icon} />
            </span>
          )}
          <h3 class:list={["mt-5 text-fluid-xl font-display font-bold tracking-tightest", c.titleColor, c.titleClass]}>{c.title}</h3>
          <p class="mt-3 flex-1 text-fluid-sm leading-relaxed text-graphite-soft">{c.desc}</p>
          <a href={c.href} class:list={[c.ctaClass, "mt-7"]}>{c.cta}</a>
        </article>
      ))}
    </div>
  </div>
</section>
