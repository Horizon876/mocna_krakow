---
import { BRAND } from "@data/site";

const path = Astro.url.pathname;

/** Aktywny link: na stronie głównej rozróżnia wierzchołek (/) od sekcji z kotwicą. */
const isActive = (href: string) => {
  const [hrefPath, hrefHash] = href.split("#");
  const base = hrefPath || "/";

  if (base === "/") {
    if (path !== "/") return false;
    return !hrefHash;
  }

  return path === base || path.startsWith(`${base}/`);
};

const oNas = [
  { label: "O MOCnej!", href: "/#poznaj-mocna" },
  { label: "W mediach", href: "/#mocna-w-mediach" },
  { label: "Wolontariat", href: "/wolontariat" },
  { label: "Projekty", href: "/projekty" },
];

const oferta = [
  { label: "Szkolenia", href: "/szkolenia" },
  { label: "Catering", href: "/catering" },
  { label: "Wydarzenia", href: "/wydarzenia" },
];

const isONasActive = oNas.some((l) => isActive(l.href));
const isOfertaActive = oferta.some((l) => isActive(l.href));

const oNasPaths = oNas.map((l) => l.href).join(",");
const ofertaPaths = oferta.map((l) => l.href).join(",");

const navLinkBase =
  "nav-link relative inline-flex items-center px-3 py-1.5 text-[13px] font-medium leading-none tracking-[-0.01em] transition-colors duration-200";

const navLinkClass = (active: boolean) =>
  [
    navLinkBase,
    "nav-item",
    active ? "is-nav-active text-blue" : "text-graphite-muted hover:text-graphite",
  ] as const;

const navGroupTriggerClass = (active: boolean) =>
  [
    navLinkBase,
    "nav-item nav-group-trigger cursor-pointer gap-1 border-0 bg-transparent font-[inherit] appearance-none",
    active ? "is-nav-active text-blue" : "text-graphite-muted hover:text-graphite",
  ] as const;

const navUnderlineClass = (active: boolean) =>
  ["nav-underline absolute inset-x-3 -bottom-px h-[1.5px] bg-blue transition-opacity duration-200", active ? "opacity-100" : "opacity-0"] as const;

const navCtaBase =
  "nav-cta flex h-[2.125rem] w-auto shrink-0 items-center justify-center gap-1.5 box-border px-2.5 text-[13px] leading-none font-medium tracking-[-0.01em] transition-colors duration-200";

const dropdownItemClass = (active: boolean) =>
  [
    "dropdown-item block px-3.5 py-2.5 text-[13px] font-medium tracking-[-0.01em] transition-colors duration-150",
    active ? "is-nav-active text-blue" : "text-graphite hover:text-graphite",
  ] as const;

const mobileLinkClass = (active: boolean) =>
  [
    "nav-mobile-link rounded-[16px] px-4 py-3.5 text-[14px] font-semibold leading-tight transition-colors",
    active ? "is-nav-active bg-blue/10 text-blue" : "bg-graphite-100 text-graphite hover:bg-graphite-200",
  ] as const;

const mobileTileClass = (active: boolean) =>
  [
    "nav-mobile-link rounded-[16px] border px-4 py-3 text-[13px] font-semibold transition-colors",
    active
      ? "is-nav-active border-blue/30 bg-blue/8 text-blue"
      : "border-graphite-200 text-graphite hover:border-blue/20",
  ] as const;

const mobileTileSmClass = (active: boolean) =>
  [
    "nav-mobile-link rounded-[16px] border px-2 py-3.5 text-center text-[12px] font-semibold leading-tight transition-colors",
    active
      ? "is-nav-active border-blue/30 bg-blue/8 text-blue"
      : "border-graphite-200 text-graphite hover:border-blue/20",
  ] as const;
---

<header
  id="site-header"
  class="fixed inset-x-0 top-0 z-50 overflow-visible"
  transition:persist
>
  <!-- Top bar: białe tło na górze; po scroll pseudo-element dodaje frosted glass -->
  <div id="nav-inner" class="overflow-visible border-b border-graphite-200/40 bg-white">
    <div class="shell">
      <nav
        class="flex h-16 items-center justify-between gap-4 overflow-visible sm:h-[4.5rem]"
        aria-label="Menu główne"
      >

        <!-- Logo: większe niż pasek, wystaje góra/dół — wysokość nav bez zmian -->
        <a
          href="/"
          class="logo-anchor group relative block shrink-0"
          aria-label="MOCna! – strona główna"
        >
          <span class="block h-16 w-[8.5rem] sm:h-[4.5rem] sm:w-[11.5rem]" aria-hidden="true"></span>
          <img
            src="/brand/logo-kolor.svg"
            alt="MOCna!"
            class="logo-img absolute left-0 top-1/2 w-auto max-w-none transition-opacity duration-300 group-hover:opacity-85"
          />
        </a>

        <!-- ── Desktop links (lg+) ── -->
        <ul class="hidden items-center gap-0.5 lg:flex" role="list">

          <!-- Strona główna -->
          <li>
            <a
              href="/"
              data-nav-href="/"
              aria-current={isActive("/") ? "page" : undefined}
              class:list={navLinkClass(isActive("/"))}
            >
              Strona główna
              <span class:list={navUnderlineClass(isActive("/"))}></span>
            </a>
          </li>

          <!-- O nas -->
          <li class="relative" data-dropdown data-nav-group data-nav-paths={oNasPaths}>
            <button
              type="button"
              aria-expanded="false"
              aria-haspopup="true"
              class:list={navGroupTriggerClass(isONasActive)}
            >
              O nas
              <span class:list={navUnderlineClass(isONasActive)}></span>
              <svg class="chevron h-3 w-3 transition-transform duration-200" viewBox="0 0 10 10" fill="none" aria-hidden="true">
                <path d="M2 3.5L5 6.5L8 3.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </button>
            <div class="dropdown-panel absolute left-0 top-full z-50 min-w-[12rem] border border-graphite-200/50 bg-white py-1" role="menu">
              {oNas.map((item) => (
                <a href={item.href} data-nav-href={item.href} role="menuitem" class:list={dropdownItemClass(isActive(item.href))}>
                  {item.label}
                </a>
              ))}
            </div>
          </li>

          <!-- Oferta -->
          <li class="relative" data-dropdown data-nav-group data-nav-paths={ofertaPaths}>
            <button
              type="button"
              aria-expanded="false"
              aria-haspopup="true"
              class:list={navGroupTriggerClass(isOfertaActive)}
            >
              Oferta
              <span class:list={navUnderlineClass(isOfertaActive)}></span>
              <svg class="chevron h-3 w-3 transition-transform duration-200" viewBox="0 0 10 10" fill="none" aria-hidden="true">
                <path d="M2 3.5L5 6.5L8 3.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </button>
            <div class="dropdown-panel absolute left-0 top-full z-50 min-w-[12rem] border border-graphite-200/50 bg-white py-1" role="menu">
              {oferta.map((item) => (
                <a href={item.href} data-nav-href={item.href} role="menuitem" class:list={dropdownItemClass(isActive(item.href))}>
                  {item.label}
                </a>
              ))}
            </div>
          </li>

          <!-- Kawiarnia -->
          <li>
            <a
              href="/kawiarnia"
              data-nav-href="/kawiarnia"
              aria-current={isActive("/kawiarnia") ? "page" : undefined}
              class:list={navLinkClass(isActive("/kawiarnia"))}
            >
              Kawiarnia
              <span class:list={navUnderlineClass(isActive("/kawiarnia"))}></span>
            </a>
          </li>

          <!-- Kontakt -->
          <li>
            <a
              href="/kontakt"
              data-nav-href="/kontakt"
              aria-current={isActive("/kontakt") ? "page" : undefined}
              class:list={navLinkClass(isActive("/kontakt"))}
            >
              Kontakt
              <span class:list={navUnderlineClass(isActive("/kontakt"))}></span>
            </a>
          </li>
        </ul>

        <!-- ── Wyróżnione: Sklep + Rezerwacja (identyczny rozmiar) ── -->
        <div class="hidden items-center gap-1.5 sm:flex">

          <!-- Sklep: ghost outline z ikoną torby -->
          <a
            href="/sklep"
            data-nav-cta="sklep"
            data-nav-href="/sklep"
            class:list={[
              navCtaBase,
              "nav-cta-sklep group border",
              isActive("/sklep")
                ? "is-nav-active border-[#e6c800] bg-yellow text-graphite"
                : "border-yellow bg-yellow text-graphite hover:border-[#e6c800] hover:bg-[#f5d500]",
            ]}
          >
            <svg class="h-3.5 w-3.5 shrink-0" viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <path d="M3.5 5h9l-1.25 7.5h-6.5L3.5 5z" stroke="currentColor" stroke-width="1.25" stroke-linejoin="round"/>
              <path d="M6 5c0-1.1.9-2 2-2s2 .9 2 2" stroke="currentColor" stroke-width="1.25" stroke-linecap="round"/>
            </svg>
            Sklep
          </a>

          <!-- Zarezerwuj stolik: solid z ikoną kalendarza -->
          <a
            href="/rezerwacja"
            data-nav-cta="rezerwacja"
            data-nav-href="/rezerwacja"
            class:list={[
              navCtaBase,
              "nav-cta-rezerwacja font-semibold text-white hover:shadow-[0_5px_18px_-6px_rgba(44,94,169,0.45)]",
              isActive("/rezerwacja") ? "is-nav-active bg-[#244d8f]" : "bg-blue hover:bg-[#244d8f]",
            ]}
          >
            <svg class="h-3.5 w-3.5 shrink-0" viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <rect x="2" y="4.5" width="12" height="9.5" rx="1.5" stroke="currentColor" stroke-width="1.25"/>
              <path d="M5.5 2.5v3M10.5 2.5v3" stroke="currentColor" stroke-width="1.25" stroke-linecap="round"/>
              <path d="M2 7.5h12" stroke="currentColor" stroke-width="1.1" stroke-linecap="round"/>
            </svg>
            Zarezerwuj stolik
          </a>

          <!-- Burger -->
          <button
            id="nav-burger"
            class="grid h-10 w-10 place-items-center rounded-xl text-graphite transition-colors duration-200 hover:bg-graphite-100 lg:hidden"
            aria-label="Otwórz menu"
            aria-expanded="false"
            aria-controls="mobile-drawer"
          >
            <span class="burger-icon" aria-hidden="true">
              <span></span>
              <span></span>
              <span></span>
            </span>
          </button>
        </div>

      </nav>
    </div>
  </div>
</header>

<!-- ── Mobile drawer ── -->
<div
  id="mobile-drawer"
  class="invisible fixed inset-0 z-40 opacity-0 lg:hidden"
>
  <div class="absolute inset-0 bg-graphite/50 backdrop-blur-sm" data-close></div>

  <div class="absolute inset-x-4 top-[4.5rem] max-h-[calc(100dvh-5.5rem)] overflow-y-auto rounded-[22px] bg-white px-4 py-5 shadow-soft">

    <!-- Główne linki -->
    <div class="grid grid-cols-2 gap-2">
      <a href="/" data-nav-href="/" class:list={mobileLinkClass(isActive("/"))}>
        Strona główna
      </a>
      <a href="/kawiarnia" data-nav-href="/kawiarnia" class:list={mobileLinkClass(isActive("/kawiarnia"))}>
        Kawiarnia
      </a>
      <a href="/kontakt" data-nav-href="/kontakt" class:list={[mobileLinkClass(isActive("/kontakt")), "col-span-2"]}>
        Kontakt
      </a>
    </div>

    <!-- O nas -->
    <div class="mt-5">
      <p class="mb-2 px-1 text-[10px] font-bold uppercase tracking-[0.22em] text-graphite-muted">O nas</p>
      <div class="grid grid-cols-2 gap-2">
        {oNas.map((item) => (
          <a href={item.href} data-nav-href={item.href} class:list={mobileTileClass(isActive(item.href))}>
            {item.label}
          </a>
        ))}
      </div>
    </div>

    <!-- Oferta -->
    <div class="mt-4">
      <p class="mb-2 px-1 text-[10px] font-bold uppercase tracking-[0.22em] text-graphite-muted">Oferta</p>
      <div class="grid grid-cols-3 gap-2">
        {oferta.map((item) => (
          <a href={item.href} data-nav-href={item.href} class:list={mobileTileSmClass(isActive(item.href))}>
            {item.label}
          </a>
        ))}
      </div>
    </div>

    <!-- Wyróżnione CTA -->
    <div class="mt-5 grid grid-cols-2 gap-2">
      <a
        href="/sklep"
        data-nav-href="/sklep"
        data-nav-cta="sklep"
        class:list={[
          "nav-mobile-link flex items-center justify-center rounded-[16px] border-2 py-3.5 text-[14px] font-bold transition-colors",
          isActive("/sklep")
            ? "is-nav-active border-[#e6c800] bg-yellow text-graphite"
            : "border-yellow bg-yellow text-graphite hover:bg-[#f5d500]",
        ]}
      >
        Sklep
      </a>
      <a
        href="/rezerwacja"
        data-nav-href="/rezerwacja"
        data-nav-cta="rezerwacja"
        class:list={[
          "nav-mobile-link flex items-center justify-center rounded-[16px] py-3.5 text-[14px] font-bold text-white transition-colors",
          isActive("/rezerwacja") ? "is-nav-active bg-[#244d8f]" : "bg-blue hover:bg-[#244d8f]",
        ]}
      >
        Zarezerwuj stolik
      </a>
    </div>

    <!-- Info strip -->
    <div class="mt-5 flex items-center justify-between rounded-[16px] bg-graphite-100 px-4 py-3.5">
      <div>
        <p class="text-[10px] font-bold uppercase tracking-[0.18em] text-graphite-muted">Zadzwoń</p>
        <a
          href={"tel:" + BRAND.phone.replace(/\s/g, "")}
          class="mt-0.5 block text-[15px] font-bold text-graphite hover:text-orange"
        >
          {BRAND.phone}
        </a>
      </div>
      <div class="text-right text-[11px] leading-relaxed text-graphite-muted">
        <p>Pon–Pt 8:00–19:00</p>
        <p>Sob 9–18 · Nd 10–16</p>
      </div>
    </div>

  </div>
</div>

<style>
  /* ── Burger ── */
  .burger-icon {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4.5px;
  }
  .burger-icon span {
    display: block;
    height: 1.5px;
    background: #333;
    border-radius: 99px;
    transition: transform 0.28s cubic-bezier(0.22, 1, 0.36, 1),
                opacity  0.2s  ease,
                width    0.28s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .burger-icon span:nth-child(1) { width: 18px; }
  .burger-icon span:nth-child(2) { width: 18px; }
  .burger-icon span:nth-child(3) { width: 11px; }

  [aria-expanded="true"] .burger-icon span:nth-child(1) {
    width: 18px;
    transform: translateY(6px) rotate(45deg);
  }
  [aria-expanded="true"] .burger-icon span:nth-child(2) {
    opacity: 0;
    transform: scaleX(0);
  }
  [aria-expanded="true"] .burger-icon span:nth-child(3) {
    width: 18px;
    transform: translateY(-6px) rotate(-45deg);
  }

  /* ── Logo: większe, lekko w dół, poszerzone — wystaje ponad navbar ── */
  .logo-img {
    height: 6.5rem;
    transform: translateY(calc(-50% + 5px)) scaleX(1.1);
    transform-origin: left center;
  }
  @media (min-width: 640px) {
    .logo-img {
      height: 8rem;
      transform: translateY(calc(-50% + 6px)) scaleX(1.1);
    }
  }

  /* ── Nav link underline ── */
  .nav-link { position: relative; }

  #site-header nav ul > li {
    display: flex;
    align-items: center;
  }

  #site-header .nav-group-trigger {
    margin: 0;
    font-family: inherit;
    line-height: 1;
    vertical-align: middle;
  }

  /* Aktywna podstrona — sterowane klasą .is-nav-active (także po View Transitions) */
  #site-header .nav-item:not(.is-nav-active) {
    color: #6b6b6b;
  }
  #site-header .nav-item.is-nav-active {
    color: #2c5ea9;
  }
  #site-header .nav-group-trigger:not(.is-nav-active) {
    color: #6b6b6b;
  }
  #site-header .nav-group-trigger.is-nav-active {
    color: #2c5ea9;
  }
  #site-header .dropdown-item.is-nav-active {
    color: #2c5ea9;
    border-left-color: #2c5ea9;
    background: rgba(44, 94, 169, 0.07);
  }
  #site-header .nav-mobile-link:not(.is-nav-active) {
    background-color: #f4f4f3;
    color: #333333;
    border-color: #e7e6e4;
  }
  #site-header .nav-mobile-link.is-nav-active {
    background-color: rgba(44, 94, 169, 0.1);
    color: #2c5ea9;
    border-color: rgba(44, 94, 169, 0.3);
  }
  #site-header .nav-cta-sklep:not(.is-nav-active),
  #site-header [data-nav-cta="sklep"].nav-mobile-link:not(.is-nav-active) {
    border-color: #ffde00;
    background-color: #ffde00;
    color: #333333;
  }
  #site-header .nav-cta-sklep.is-nav-active,
  #site-header [data-nav-cta="sklep"].nav-mobile-link.is-nav-active {
    border-color: #e6c800;
    background-color: #ffde00;
    color: #333333;
  }
  #site-header .nav-cta-rezerwacja.is-nav-active {
    background-color: #244d8f;
  }
  #site-header .nav-cta-rezerwacja:not(.is-nav-active) {
    background-color: #2c5ea9;
  }

  #site-header .nav-cta {
    box-sizing: border-box;
    width: auto;
    height: 2.125rem;
    padding-inline: 0.625rem;
  }

  /* ── Po scroll: frosted glass (bez animacji) ── */
  #site-header.scrolled #nav-inner {
    background: rgba(255, 255, 255, 0.96);
    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);
    border-color: rgba(51, 51, 51, 0.07);
    box-shadow: 0 2px 28px -6px rgba(51, 51, 51, 0.14);
  }

  /* ── Dropdown ── */
  .dropdown-panel {
    opacity: 0;
    pointer-events: none;
    box-shadow:
      0 1px 0 0 rgba(44,94,169,0.18) inset,  /* górna kreska akcentowa */
      0 18px 48px -14px rgba(51, 51, 51, 0.2),
      0 4px 10px -4px rgba(51, 51, 51, 0.06);
    margin-top: 6px;
  }
  .dropdown-panel::before {
    content: "";
    position: absolute;
    top: -8px;
    inset-inline: 0;
    height: 8px;
  }
  /* lewy pasek akcentowy na pozycjach dropdown */
  .dropdown-item {
    position: relative;
    border-left: 2px solid transparent;
  }
  .dropdown-item:hover {
    border-left-color: #2c5ea9;
    background: #f4f4f3;
    padding-left: calc(0.875rem - 2px);
  }
  .dropdown-item.is-nav-active {
    border-left-color: #2c5ea9;
    background: rgba(44, 94, 169, 0.07);
  }

  [data-dropdown]:hover .dropdown-panel,
  [data-dropdown].is-open .dropdown-panel {
    opacity: 1;
    pointer-events: auto;
  }
  [data-dropdown]:hover .chevron,
  [data-dropdown].is-open .chevron {
    transform: rotate(180deg);
  }

  /* ── Mobile drawer ── */
  #mobile-drawer.is-open {
    visibility: visible;
    opacity: 1;
  }
</style>

<script>
  import { HOME_SECTION_SCROLL } from "@data/site";

  const HOME_SECTIONS = Object.values(HOME_SECTION_SCROLL);
  const NAV_OFFSET_PX = 72;

  let activeHomeSection: string | null = null;

  function normalizePath(pathname: string): string {
    const path = pathname.split("?")[0].split("#")[0];
    if (path !== "/" && path.endsWith("/")) return path.slice(0, -1);
    return path || "/";
  }

  function parseNavHref(href: string): { path: string; hash: string } {
    const raw = href.split("?")[0];
    const [pathPart, hashPart] = raw.split("#");
    return {
      path: normalizePath(pathPart || "/"),
      hash: hashPart ? `#${hashPart}` : "",
    };
  }

  function updateHomeSectionFromScroll() {
    const pagePath = normalizePath(window.location.pathname);
    if (pagePath !== "/") {
      activeHomeSection = null;
      return;
    }

    let active: string | null = null;

    for (const { id, extraOffset } of HOME_SECTIONS) {
      const section = document.getElementById(id);
      if (!section) continue;

      if (section.getBoundingClientRect().top <= NAV_OFFSET_PX - extraOffset + 48) {
        active = id;
      }
    }

    activeHomeSection = active;
  }

  function navLinkIsActive(href: string, pathname: string): boolean {
    const { path: linkPath, hash: linkHash } = parseNavHref(href);
    const pagePath = normalizePath(pathname);

    if (linkPath !== pagePath) {
      if (linkPath === "/") return false;
      return pagePath === linkPath || pagePath.startsWith(`${linkPath}/`);
    }

    if (pagePath === "/") {
      if (linkHash) return activeHomeSection === linkHash.slice(1);
      return activeHomeSection === null;
    }

    return !linkHash || window.location.hash === linkHash;
  }

  function setNavItemActive(el: HTMLElement, active: boolean) {
    el.classList.toggle("is-nav-active", active);
    if (el instanceof HTMLAnchorElement) {
      if (active) el.setAttribute("aria-current", "page");
      else el.removeAttribute("aria-current");
    }
    const underline = el.querySelector(".nav-underline");
    if (underline) {
      underline.classList.toggle("opacity-100", active);
      underline.classList.toggle("opacity-0", !active);
    }
  }

  /** Odświeża podkreślenie i kolory po nawigacji (navbar ma transition:persist). */
  function updateNavActive() {
    updateHomeSectionFromScroll();
    const path = normalizePath(window.location.pathname);

    document.querySelectorAll<HTMLElement>("[data-nav-href]").forEach((el) => {
      const href = el.getAttribute("data-nav-href")!;
      setNavItemActive(el, navLinkIsActive(href, path));
    });

    document.querySelectorAll<HTMLElement>("[data-nav-group]").forEach((group) => {
      const paths = (group.getAttribute("data-nav-paths") || "").split(",").filter(Boolean);
      const active = paths.some((h) => navLinkIsActive(h, path));
      const btn = group.querySelector<HTMLElement>(".nav-group-trigger");
      if (!btn) return;
      btn.classList.toggle("is-nav-active", active);
      btn.classList.toggle("text-blue", active);
      btn.classList.toggle("text-graphite-muted", !active);
      const underline = btn.querySelector(".nav-underline");
      if (underline) {
        underline.classList.toggle("opacity-100", active);
        underline.classList.toggle("opacity-0", !active);
      }
    });
  }

  let navInteractionsBound = false;

  function initNav() {
    updateNavActive();
    if (navInteractionsBound) return;
    navInteractionsBound = true;

    const burger = document.getElementById("nav-burger") as HTMLButtonElement | null;
    const drawer = document.getElementById("mobile-drawer");
    const header = document.getElementById("site-header");
    if (!burger || !drawer) return;

    const closeDrawer = () => {
      drawer.classList.remove("is-open");
      burger.setAttribute("aria-expanded", "false");
      burger.setAttribute("aria-label", "Otwórz menu");
      document.body.style.overflow = "";
    };
    const openDrawer = () => {
      drawer.classList.add("is-open");
      burger.setAttribute("aria-expanded", "true");
      burger.setAttribute("aria-label", "Zamknij menu");
      document.body.style.overflow = "hidden";
    };

    burger.addEventListener("click", () =>
      drawer.classList.contains("is-open") ? closeDrawer() : openDrawer()
    );
    drawer.querySelectorAll("[data-close], a").forEach((el) =>
      el.addEventListener("click", closeDrawer)
    );
    document.addEventListener("keydown", (e) => e.key === "Escape" && closeDrawer());

    // Dropdowns
    document.querySelectorAll<HTMLElement>("[data-dropdown]").forEach((dd) => {
      const btn = dd.querySelector("button");
      btn?.addEventListener("click", (e) => {
        e.stopPropagation();
        const open = dd.classList.toggle("is-open");
        btn.setAttribute("aria-expanded", String(open));
        document.querySelectorAll<HTMLElement>("[data-dropdown]").forEach((other) => {
          if (other !== dd) {
            other.classList.remove("is-open");
            other.querySelector("button")?.setAttribute("aria-expanded", "false");
          }
        });
      });
    });
    document.addEventListener("click", () => {
      document.querySelectorAll("[data-dropdown].is-open").forEach((dd) => {
        dd.classList.remove("is-open");
        dd.querySelector("button")?.setAttribute("aria-expanded", "false");
      });
    });

    const onScroll = () => {
      header?.classList.toggle("scrolled", window.scrollY > 8);
      updateNavActive();
    };
    onScroll();
    window.addEventListener("scroll", onScroll, { passive: true });
    window.addEventListener("hashchange", updateNavActive);
  }

  initNav();
  document.addEventListener("astro:after-swap", updateNavActive);
  document.addEventListener("astro:page-load", () => {
    requestAnimationFrame(() => {
      updateNavActive();
      requestAnimationFrame(updateNavActive);
    });
  });
</script>
