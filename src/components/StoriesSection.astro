---
import SectionHeading from "@components/SectionHeading.astro";
import StoriesShowstopper from "@components/StoriesShowstopper.tsx";
import { STORIES, COLORS } from "@data/site";

const stories = STORIES.map((s) => ({ ...s, accent: COLORS[s.accent] }));
---
<section class="relative overflow-hidden bg-graphite py-20 text-white sm:py-28">
  <div class="pointer-events-none absolute inset-0 opacity-[0.05]">
    <img src="/brand/pattern.png" alt="" class="h-full w-full object-cover" />
  </div>

  <div class="shell relative">
    <SectionHeading kicker="Historie pełne MOCy" title="Za każdą filiżanką <span class='text-orange'>stoi człowiek</span>">
      <p class="mt-3 max-w-xl text-fluid-sm text-white/70">
        Najedź, by przywrócić im kolor. Kliknij, by poznać całą historię.
      </p>
    </SectionHeading>
  </div>

  <div class="relative mt-12">
    <StoriesShowstopper client:visible stories={stories} />
  </div>
</section>

<style is:global>
  /* Nagłówek tej sekcji jest na ciemnym tle */
  section.bg-graphite h2 {
    color: #fff;
  }
</style>
