---
import Photo from "@components/Photo.astro";
import Counter from "@components/Counter.tsx";
import { STATS } from "@data/site";
---
<section class="relative py-20 sm:py-28">
  <div class="shell">
    <div class="grid gap-6 lg:grid-cols-12 lg:gap-7">
      <!-- Duży kafel: zdjęcie założycielki z zespołem -->
      <div class="relative lg:col-span-7">
        <Photo
          alt="Założycielka MOCnej z zespołem"
          label="Założycielka z zespołem — początek wszystkiego"
          icon={`<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 00-3-3.87M16 3.13a4 4 0 010 7.75"/></svg>`}
          color="#2c5ea9"
          mask="rounded"
          ratio="16/11"
          class="h-full shadow-soft"
        />
      </div>

      <!-- Kafel z misją -->
      <div class="flex flex-col justify-between rounded-[32px] bg-yellow-cream p-8 lg:col-span-5 sm:p-10">
        <div>
          <span class="kicker">Poznaj MOCną!</span>
          <p class="text-fluid-xl font-display font-bold leading-tighter tracking-tightest text-balance">
            Nie zaczynamy od stanowiska pracy.
            <span class="text-orange">Zaczynamy od człowieka.</span>
          </p>
          <p class="mt-5 text-fluid-sm leading-relaxed text-graphite-soft">
            Wierzymy, że praca to coś więcej niż obowiązek — to godność, rytm
            dnia i poczucie sprawczości. Budujemy zespół, w którym każdy ma
            swoje miejsce przy barze i w tej historii.
          </p>
        </div>
        <a href="/o-mocnej" class="btn-orange mt-8 self-start">Poznaj naszą historię →</a>
      </div>

      <!-- Liczniki – wyspy Astro -->
      {STATS.map((s) => (
        <div class="lg:col-span-3">
          <Counter client:visible value={s.value} suffix={s.suffix} label={s.label} color={s.color} />
        </div>
      ))}
    </div>
  </div>
</section>
