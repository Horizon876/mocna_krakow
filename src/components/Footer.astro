---
import { FOOTER_SECTIONS } from "@data/site";

const year = new Date().getFullYear();
---
<footer class="bg-[#0f1b33] text-white">
  <div class="shell py-16 sm:py-20">
    <div class="grid gap-12 lg:grid-cols-[1.35fr_1fr_1fr_1fr]">
      <div>
        <a href="/" class="inline-block">
          <img src="/brand/logo-white.svg" alt="MOCna!" class="h-20 w-auto sm:h-28" />
        </a>
        <p class="mt-6 max-w-md text-fluid-sm leading-relaxed text-white/75">
          Fundacja MOCna! tworzymy miejsca pracy, rozwijamy samodzielność i budujemy
          przestrzeń spotkań dla osób z niepełnosprawnościami oraz ich bliskich.
        </p>
      </div>

      {
        FOOTER_SECTIONS.map((section) => (
          <nav aria-label={`Stopka — ${section.title}`}>
            <h3 class="text-fluid-sm font-semibold uppercase tracking-[0.18em] text-white/50">
              {section.title}
            </h3>
            <ul class="mt-4 grid gap-2">
              {
                section.links.map((item) => (
                  <li>
                    <a
                      href={item.href}
                      class="text-fluid-sm text-white/80 transition-colors hover:text-orange-soft"
                    >
                      {item.label}
                    </a>
                  </li>
                ))
              }
            </ul>
          </nav>
        ))
      }
    </div>

    <div class="mt-14 flex flex-col gap-3 text-xs text-white/45 sm:flex-row sm:items-center sm:justify-between">
      <p>© {year} Fundacja MOCna!</p>
      <p class="uppercase tracking-[0.12em]">
        DESIGN BY{" "}
        <a
          href="https://web2sell.pl/"
          target="_blank"
          rel="noopener noreferrer"
          class="transition-colors hover:text-orange-soft"
        >
          WEB2SELL
        </a>
      </p>
    </div>
  </div>
</footer>
