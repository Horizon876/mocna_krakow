    <!-- Tooltip -->
    <div
      id="table-tooltip"
      class="pointer-events-none fixed z-50 hidden max-w-[180px] border border-graphite-200 bg-graphite px-3 py-2 shadow-soft"
      role="tooltip"
      aria-live="polite"
    >
      <p id="tt-name" class="text-sm font-bold text-white"></p>
      <p id="tt-zone" class="text-xs text-white/70"></p>
      <p id="tt-cap"  class="text-xs text-white/70"></p>
      <p id="tt-stat" class="mt-1 text-xs font-semibold"></p>
    </div>

    <!-- Podsumowanie wyboru -->
    <div id="selection-summary" class="mt-6 hidden border border-graphite-200 bg-white p-5">
      <p class="mb-1 text-sm text-graphite-muted">Wybrany stolik</p>
      <p id="summary-table"  class="text-lg font-bold text-graphite"></p>
      <p id="summary-detail" class="text-sm text-graphite-muted"></p>
      <p id="summary-datetime" class="mt-1 text-sm font-semibold capitalize text-blue"></p>
    </div>

    <!-- Hidden inputs dla formularza -->
    <input type="hidden" id="selected-table-input" name="tableId"          value=""/>
    <input type="hidden" id="selected-time-input"  name="reservationTime"  value=""/>
    <input type="hidden" id="selected-date-input"  name="reservationDate"  value=""/>
  </div>
</div>

<script define:vars={{ metaJSON, occupiedJSON, MAX_DATE, MONTH_NAMES, timeSlotsJSON }}>
  const TABLE_META     = JSON.parse(metaJSON);
  const occupiedTables = new Set(JSON.parse(occupiedJSON));
  const TIME_SLOTS     = JSON.parse(timeSlotsJSON);

  let selectedTableId = null;
  let selectedTime    = null;
  let selectedDate    = null;

  let minDate  = null;
  let maxDate  = null;
  let viewYear = 0;
  let viewMonth = 0;

  function parseISODate(value) {
    const [y, m, d] = value.split("-").map(Number);
    return new Date(y, m - 1, d);
  }

  function toISO(date) {
    const y = date.getFullYear();
    const m = String(date.getMonth() + 1).padStart(2, "0");
    const d = String(date.getDate()).padStart(2, "0");
    return `${y}-${m}-${d}`;
  }

  function getLocalToday() {
    const now = new Date();
    return new Date(now.getFullYear(), now.getMonth(), now.getDate());
  }

  function isSameDay(a, b) {
    return a.getFullYear() === b.getFullYear()
      && a.getMonth() === b.getMonth()
      && a.getDate() === b.getDate();
  }

  function formatDateLabel(value) {
    return parseISODate(value).toLocaleDateString("pl-PL", {
      weekday: "long",
      day: "numeric",
      month: "long",
      year: "numeric",
    });
  }

  function slotToMinutes(slot) {
    const [h, m] = slot.split(":").map(Number);
    return h * 60 + m;
  }

  /** Najwcześniejsza godzina rezerwacji: teraz + 2h, zaokrąglone w górę do 30 min */
  function getEarliestBookableDateTime() {
    const t = new Date();
    t.setSeconds(0, 0);
    t.setMinutes(t.getMinutes() + 120);
    const mins = t.getMinutes();
    if (mins % 30 !== 0) {
      t.setMinutes(mins + (30 - (mins % 30)));
    }
    return t;
  }

  function slotToDateTime(dateISO, slot) {
    const d = parseISODate(dateISO);
    const [h, m] = slot.split(":").map(Number);
    d.setHours(h, m, 0, 0);
    return d;
  }

  function isSlotAvailable(slot, dateISO) {
    if (!dateISO) return false;

    const selected = parseISODate(dateISO);
    const today = getLocalToday();

    if (selected < today) return false;
    if (selected > today) return true;

    const earliest = getEarliestBookableDateTime();
    const earliestDay = new Date(earliest.getFullYear(), earliest.getMonth(), earliest.getDate());

    // Np. o 23:00 + 2h wypada już następny dzień — dziś brak wolnych godzin
    if (earliestDay > selected) return false;

    return slotToDateTime(dateISO, slot) >= earliest;
  }

  function hasAvailableSlots(dateISO) {
    return TIME_SLOTS.some((slot) => isSlotAvailable(slot, dateISO));
  }

  function renderTimeSlots(dateISO) {
    const hint = document.getElementById("time-slots-hint");
    let availableCount = 0;

    document.querySelectorAll(".time-slot").forEach((btn) => {
      const slot = btn.dataset.time;
      const available = isSlotAvailable(slot, dateISO);
      const isSelected = selectedTime === slot;

      btn.classList.remove("time-slot--available", "time-slot--unavailable", "time-slot--selected");
      btn.disabled = !available;
      btn.style.background = "";
      btn.style.borderColor = "";
      btn.style.boxShadow = "";

      if (!available) {
        btn.classList.add("time-slot--unavailable");
        btn.style.color = "#8a8a8a";
        btn.style.fontWeight = "400";
      } else {
        availableCount += 1;
        btn.classList.add("time-slot--available");
        if (isSelected) {
          btn.classList.add("time-slot--selected");
          btn.style.color = "#ffffff";
          btn.style.fontWeight = "700";
          btn.style.background = "#2c5ea9";
          btn.style.borderColor = "#2c5ea9";
        } else {
          btn.style.color = "#333333";
          btn.style.fontWeight = "700";
        }
      }
    });

    if (selectedTime && !isSlotAvailable(selectedTime, dateISO)) {
      selectedTime = null;
    }

    if (hint) {
      hint.classList.toggle("hidden", availableCount > 0);
    }
  }

  function resetTimeSlots() {
    selectedTime = null;
  }

  function showDateStep() {
    const stepPickDate = document.getElementById("step-pick-date");
    const stepPickTime = document.getElementById("step-pick-time");
    const stepTimeHint = document.getElementById("step-time-hint");
    stepPickDate?.classList.remove("hidden");
    stepPickTime?.classList.add("hidden");
    if (stepTimeHint) stepTimeHint.textContent = "Wybierz datę wizyty.";
    renderCalendar();
  }

  function showTimeStep(value, keepTime = false) {
    const stepPickDate   = document.getElementById("step-pick-date");
    const stepPickTime   = document.getElementById("step-pick-time");
    const pickedDateLabel= document.getElementById("picked-date-label");
    const stepTimeHint   = document.getElementById("step-time-hint");
    const dateInput      = document.getElementById("date-input");

    if (dateInput) dateInput.value = value;
    if (pickedDateLabel) pickedDateLabel.textContent = formatDateLabel(value);
    if (stepTimeHint) stepTimeHint.textContent = "Wybierz godzinę rezerwacji.";

    stepPickDate?.classList.add("hidden");
    stepPickTime?.classList.remove("hidden");

    if (!keepTime) resetTimeSlots();
    renderTimeSlots(value);
    updateConfirmBtn();
  }

  function updateCalNavButtons() {
    const calPrev = document.getElementById("cal-prev");
    const calNext = document.getElementById("cal-next");
    const viewStart = new Date(viewYear, viewMonth, 1);
    const viewEnd   = new Date(viewYear, viewMonth + 1, 0);
    if (calPrev) calPrev.disabled = viewEnd < minDate;
    if (calNext) calNext.disabled = viewStart > maxDate;
  }

  function renderCalendar() {
    const calGrid       = document.getElementById("cal-grid");
    const calMonthLabel = document.getElementById("cal-month-label");
    const dateInput     = document.getElementById("date-input");
    if (!calGrid || !calMonthLabel || !minDate || !maxDate) return;

    calMonthLabel.textContent = `${MONTH_NAMES[viewMonth]} ${viewYear}`;
    calGrid.innerHTML = "";

    const firstDayOffset = (new Date(viewYear, viewMonth, 1).getDay() + 6) % 7;
    const daysInMonth    = new Date(viewYear, viewMonth + 1, 0).getDate();
    const today          = getLocalToday();
    const selected       = dateInput?.value ? parseISODate(dateInput.value) : null;

    for (let i = 0; i < firstDayOffset; i++) {
      const spacer = document.createElement("span");
      spacer.className = "date-calendar__spacer";
      spacer.setAttribute("aria-hidden", "true");
      calGrid.appendChild(spacer);
    }

    for (let day = 1; day <= daysInMonth; day++) {
      const date       = new Date(viewYear, viewMonth, day);
      const iso        = toISO(date);
      const isPast     = date < minDate;
      const isTooFar   = date > maxDate;
      const noSlots    = !hasAvailableSlots(iso);
      const isDisabled = isPast || isTooFar || noSlots;
      const isToday    = isSameDay(date, today);
      const isSelected = selected && isSameDay(date, selected);

      const btn = document.createElement("button");
      btn.type = "button";
      btn.textContent = String(day);
      btn.dataset.date = iso;
      btn.setAttribute("role", "gridcell");
      btn.setAttribute("aria-label", formatDateLabel(iso));
      btn.className = "date-calendar__day";

      if (isDisabled) {
        btn.disabled = true;
        btn.classList.add("date-calendar__day--disabled");
        if (isPast || noSlots) {
          btn.classList.add("date-calendar__day--past");
          btn.style.color = "#6b6b6b";
          btn.style.fontWeight = "400";
          btn.style.opacity = isPast ? "0.65" : "0.75";
        } else {
          btn.style.color = "#9ca3af";
          btn.style.fontWeight = "400";
        }
      } else {
        btn.classList.add("date-calendar__day--available");
        btn.style.color = "#333333";
        btn.style.fontWeight = "700";
      }

      if (isToday && !isDisabled) btn.classList.add("date-calendar__day--today");
      if (isSelected) {
        btn.classList.add("date-calendar__day--selected");
        btn.setAttribute("aria-selected", "true");
      }

      calGrid.appendChild(btn);
    }

    updateCalNavButtons();
  }

  function updateConfirmBtn() {
    const dateInput  = document.getElementById("date-input");
    const showMapBtn = document.getElementById("show-map-btn");
    const ok = selectedTime && dateInput?.value;
    if (!showMapBtn) return;
    showMapBtn.disabled = !ok;
    showMapBtn.classList.toggle("opacity-50", !ok);
  }

  function initBookingDateTime() {
    const root = document.getElementById("table-map-root");
    if (!root) return;

    minDate = getLocalToday();
    maxDate = parseISODate(MAX_DATE);
    viewYear = minDate.getFullYear();
    viewMonth = minDate.getMonth();

    if (!root.dataset.listenersReady) {
      root.dataset.listenersReady = "1";

      root.addEventListener("click", (e) => {
        const dayBtn = e.target.closest(".date-calendar__day--available");
        if (dayBtn?.dataset.date) {
          showTimeStep(dayBtn.dataset.date);
          return;
        }

        if (e.target.closest("#cal-prev")) {
          viewMonth -= 1;
          if (viewMonth < 0) { viewMonth = 11; viewYear -= 1; }
          renderCalendar();
          return;
        }

        if (e.target.closest("#cal-next")) {
          viewMonth += 1;
          if (viewMonth > 11) { viewMonth = 0; viewYear += 1; }
          renderCalendar();
          return;
        }

        if (e.target.closest("#back-to-date-btn")) {
          const dateInput = document.getElementById("date-input");
          if (dateInput) dateInput.value = "";
          showDateStep();
          updateConfirmBtn();
          return;
        }

        const timeBtn = e.target.closest(".time-slot");
        if (timeBtn && !timeBtn.disabled) {
          selectedTime = timeBtn.dataset.time;
          const dateInput = document.getElementById("date-input");
          if (dateInput?.value) renderTimeSlots(dateInput.value);
          updateConfirmBtn();
          return;
        }

        if (e.target.closest("#show-map-btn")) {
          const dateInput = document.getElementById("date-input");
          if (!dateInput?.value || !selectedTime) return;
          goToMapStep(dateInput.value, selectedTime);
        }
      });
    }

    showDateStep();
  }

  function goToMapStep(dateValue, timeValue) {
    const stepTime       = document.getElementById("step-time");
    const stepMap        = document.getElementById("step-map");
    const chosenDatetime = document.getElementById("chosen-datetime");
    const timeInput      = document.getElementById("selected-time-input");
    const dateInputHidden= document.getElementById("selected-date-input");

    selectedDate = dateValue;
    selectedTime = timeValue;
    const dateStr = formatDateLabel(dateValue);
    if (chosenDatetime) chosenDatetime.textContent = `${dateStr}, godz. ${selectedTime}`;
    if (timeInput) timeInput.value = selectedTime;
    if (dateInputHidden) dateInputHidden.value = selectedDate;

    if (!stepTime || !stepMap) return;

    stepTime.style.opacity = "0";
    stepTime.style.transform = "translateY(-12px)";
    setTimeout(() => {
      stepTime.classList.add("hidden");
      stepTime.style.opacity = "";
      stepTime.style.transform = "";
      stepMap.classList.remove("hidden");
      stepMap.style.opacity = "0";
      stepMap.style.transform = "translateY(12px)";
      requestAnimationFrame(() => {
        stepMap.style.transition = "opacity .4s ease, transform .4s ease";
        stepMap.style.opacity = "1";
        stepMap.style.transform = "translateY(0)";
      });
    }, 220);

    document.dispatchEvent(
      new CustomEvent("timeSelected", { detail: { date: selectedDate, time: selectedTime } })
    );

    // Pobierz aktualne zajęte stoliki dla wybranego slotu z backendu
    fetch(`/api/occupied-tables?date=${encodeURIComponent(dateValue)}&time=${encodeURIComponent(timeValue)}`)
      .then((r) => r.json())
      .then((ids) => {
        occupiedTables.clear();
        ids.forEach((id) => occupiedTables.add(id));
        Object.keys(TABLE_META).forEach((id) => {
          const group = document.querySelector(`[data-table-id="${id}"]`);
          if (!group) return;
          if (occupiedTables.has(id)) {
            setTableFill(id, COLOR.occupied);
            group.setAttribute("data-status", "occupied");
            group.setAttribute("aria-disabled", "true");
          } else {
            setTableFill(id, COLOR.free);
            group.setAttribute("data-status", "free");
            group.removeAttribute("aria-disabled");
          }
        });
      })
      .catch(() => {});
  }

  initBookingDateTime();
  document.addEventListener("astro:page-load", initBookingDateTime);

  const backBtn         = document.getElementById("back-btn");
  const stepTime        = document.getElementById("step-time");
  const stepMap         = document.getElementById("step-map");
  const tooltip         = document.getElementById("table-tooltip");
  const ttName          = document.getElementById("tt-name");
  const ttZone          = document.getElementById("tt-zone");
  const ttCap           = document.getElementById("tt-cap");
  const ttStat          = document.getElementById("tt-stat");
  const selSummary      = document.getElementById("selection-summary");
  const sumTable        = document.getElementById("summary-table");
  const sumDetail       = document.getElementById("summary-detail");
  const sumDatetime     = document.getElementById("summary-datetime");
  const tableInput      = document.getElementById("selected-table-input");

  backBtn?.addEventListener("click", () => {
    stepMap.classList.add("hidden");
    stepTime.classList.remove("hidden");
    const dateInput = document.getElementById("date-input");
    if (dateInput?.value) {
      showTimeStep(dateInput.value, true);
    } else {
      showDateStep();
    }
    clearTableSelection();
    document.dispatchEvent(new CustomEvent("bookingReset", { bubbles: true }));
  });

  // ---- KROK 2: interakcja ze stolikami ----
  // Obsługuje T10 z wieloma .table-circle (fotele + kanapa)
  function setTableFill(id, color) {
    const g = document.querySelector(`[data-table-id="${id}"]`);
    if (!g) return;
    g.querySelectorAll(".table-circle").forEach((el) => el.setAttribute("fill", color));
  }

  function clearTableSelection() {
    if (!selectedTableId) return;
    setTableFill(selectedTableId, occupiedTables.has(selectedTableId) ? "#9ca3af" : "#2c5ea9");
    selectedTableId = null;
    tableInput.value = "";
    if (sumDatetime) sumDatetime.textContent = "";
    selSummary.classList.add("hidden");
  }

  const COLOR = { free: "#2c5ea9", occupied: "#9ca3af", selected: "#de3c42" };

  function ensureTooltipInBody() {
    if (tooltip && tooltip.parentElement !== document.body) {
      document.body.appendChild(tooltip);
    }
  }

  function positionTooltipNearTable(group) {
    if (!tooltip || !group) return;
    ensureTooltipInBody();

    tooltip.classList.remove("hidden");
    tooltip.style.visibility = "hidden";

    const rect = group.getBoundingClientRect();
    const tipW = tooltip.offsetWidth;
    const tipH = tooltip.offsetHeight;
    const gap = 10;

    let left = rect.left + rect.width / 2 - tipW / 2;
    let top = rect.top - tipH - gap;

    if (top < 8) top = rect.bottom + gap;

    left = Math.max(8, Math.min(left, window.innerWidth - tipW - 8));
    top = Math.max(8, Math.min(top, window.innerHeight - tipH - 8));

    tooltip.style.left = `${left}px`;
    tooltip.style.top = `${top}px`;
    tooltip.style.visibility = "visible";
  }

  let hoveredTableGroup = null;

  document.querySelectorAll(".cafe-table").forEach((group) => {
    const id = group.dataset.tableId;

    group.addEventListener("mouseenter", () => {
      hoveredTableGroup = group;
      const meta  = TABLE_META[id] || {};
      const isSel = selectedTableId === id;
      const isOcc = occupiedTables.has(id);
      ttName.textContent = meta.label || id;
      ttZone.textContent = meta.zone  || "";
      ttCap.textContent  = meta.cap   ? `${meta.cap} ${meta.cap === 1 ? "osoba" : "osoby"}` : "";
      ttStat.textContent = isSel ? "✓ Wybrany" : isOcc ? "Zajęty" : "Wolny";
      ttStat.style.color = isSel ? "#fa8080" : isOcc ? "#d1d5db" : "#86efac";
      positionTooltipNearTable(group);
      if (!isOcc && !isSel) setTableFill(id, "#3b73c8");
    });

    group.addEventListener("mousemove", () => {
      positionTooltipNearTable(group);
    });

    group.addEventListener("mouseleave", () => {
      hoveredTableGroup = null;
      tooltip.classList.add("hidden");
      tooltip.style.visibility = "";
      const isOcc = occupiedTables.has(id);
      const isSel = selectedTableId === id;
      if (!isSel) setTableFill(id, isOcc ? COLOR.occupied : COLOR.free);
    });

    group.addEventListener("click", () => {
      if (occupiedTables.has(id)) return;
      if (selectedTableId === id) { clearTableSelection(); return; }
      if (selectedTableId) setTableFill(selectedTableId, COLOR.free);

      selectedTableId = id;
      setTableFill(id, COLOR.selected);
      tableInput.value = id;

      const meta = TABLE_META[id] || {};
      const dateInput = document.getElementById("date-input");
      sumTable.textContent  = meta.label || id;
      sumDetail.textContent = `${meta.zone || ""} · ${meta.cap || "–"} ${meta.cap <= 1 ? "osoba" : "osoby"}`;
      const reservationDate = dateInput?.value || selectedDate;
      if (sumDatetime && reservationDate && selectedTime) {
        sumDatetime.textContent = `${formatDateLabel(reservationDate)}, godz. ${selectedTime}`;
      }
      selSummary.classList.remove("hidden");

      document.dispatchEvent(
        new CustomEvent("tableSelected", {
          detail: { tableId: id, label: meta.label, zone: meta.zone, cap: meta.cap, date: selectedDate, time: selectedTime },
          bubbles: true,
        })
      );
    });

    group.addEventListener("keydown", (e) => {
      if (e.key === "Enter" || e.key === " ") {
        e.preventDefault();
        group.dispatchEvent(new MouseEvent("click"));
      }
    });
  });

  document.getElementById("cafe-floorplan")?.parentElement?.addEventListener("scroll", () => {
    if (hoveredTableGroup) positionTooltipNearTable(hoveredTableGroup);
  }, { passive: true });
</script>

