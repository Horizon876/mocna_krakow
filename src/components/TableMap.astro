---
/**
 * TableMap.astro – interaktywna mapa stolików kawiarni MOCna!
 *
 * Props:
 *   occupiedTables – tablica ID zajętych stolików, np. ['T1', 'G3']
 *
 * Emituje CustomEvent('tableSelected', { detail: { tableId, date, time, ... } })
 * oraz ustawia ukryte inputy #selected-table-input / #selected-time-input / #selected-date-input.
 */

interface Props {
  occupiedTables?: string[];
}
const { occupiedTables = [] } = Astro.props;

// Sloty 09:00–18:30 co 30 min
const TIME_SLOTS: string[] = [];
for (let h = 9; h <= 18; h++) {
  TIME_SLOTS.push(`${String(h).padStart(2, "0")}:00`);
  if (h < 19) TIME_SLOTS.push(`${String(h).padStart(2, "0")}:30`);
}

const TODAY    = new Date().toISOString().split("T")[0];
const MAX_DATE = new Date(Date.now() + 90 * 24 * 3600 * 1000).toISOString().split("T")[0];

// ---- Układ wg szkicu ----
// Wnętrze górny rząd:  T1–T5 (2-osobowe)
// Wnętrze dolny rząd:  T6(2os), T7(2os), T8(1os), T9(2os), T10(lounge 4os)
// Ogród od dołu:       G1, G2 (3os) | G3, G4 (3os) | G5 (3os) | G6 (3os)
const TABLE_META: Record<string, { label: string; cap: number; zone: string }> = {
  T1:  { label: "Stolik 1",      cap: 2, zone: "Wnętrze" },
  T2:  { label: "Stolik 2",      cap: 2, zone: "Wnętrze" },
  T3:  { label: "Stolik 3",      cap: 2, zone: "Wnętrze" },
  T4:  { label: "Stolik 4",      cap: 2, zone: "Wnętrze" },
  T5:  { label: "Stolik 5",      cap: 2, zone: "Wnętrze" },
  T6:  { label: "Stolik 6",      cap: 2, zone: "Wnętrze" },
  T7:  { label: "Stolik 7",      cap: 2, zone: "Wnętrze" },
  T8:  { label: "Stolik 8",      cap: 1, zone: "Wnętrze" },
  T9:  { label: "Stolik 9",      cap: 2, zone: "Wnętrze" },
  T10: { label: "Stolik 10", cap: 4, zone: "Strefa lounge" },
  G1:  { label: "Ogród 1",       cap: 3, zone: "Ogród" },
  G2:  { label: "Ogród 2",       cap: 3, zone: "Ogród" },
  G3:  { label: "Ogród 3",       cap: 3, zone: "Ogród" },
  G4:  { label: "Ogród 4",       cap: 3, zone: "Ogród" },
  G5:  { label: "Ogród 5",       cap: 3, zone: "Ogród" },
  G6:  { label: "Ogród 6",       cap: 3, zone: "Ogród" },
};

const occupiedSet = new Set(occupiedTables);
const tableColor  = (id: string) => occupiedSet.has(id) ? "#9ca3af" : "#2c5ea9";
const tableCursor = (id: string) => occupiedSet.has(id) ? "not-allowed" : "pointer";

const metaJSON       = JSON.stringify(TABLE_META);
const occupiedJSON   = JSON.stringify(occupiedTables);
const timeSlotsJSON  = JSON.stringify(TIME_SLOTS);

const MONTH_NAMES = [
  "styczeń", "luty", "marzec", "kwiecień", "maj", "czerwiec",
  "lipiec", "sierpień", "wrzesień", "październik", "listopad", "grudzień",
];
const WEEKDAY_NAMES = ["Pon", "Wt", "Śr", "Cz", "Pt", "So", "Nd"];
---

<div id="table-map-root" class="w-full">

  <!-- ===== KROK 1: Wybór daty i godziny ===== -->
  <div id="step-time" class="mx-auto max-w-2xl">
    <div class="mb-8 text-center">
      <h2 class="text-fluid-xl font-display font-bold tracking-tightest" aria-label="Zarezerwuj stolik">
        <span class="text-blue">Z</span><span class="text-red">a</span><span class="text-yellow">r</span><span class="text-green">e</span><span class="text-pink">z</span><span class="text-orange">e</span><span class="text-blue">r</span><span class="text-red">w</span><span class="text-yellow">u</span><span class="text-green">j</span>
        {" "}
        <span class="text-pink">s</span><span class="text-orange">t</span><span class="text-blue">o</span><span class="text-red">l</span><span class="text-yellow">i</span><span class="text-green">k</span>
      </h2>
      <p id="step-time-hint" class="mt-2 font-bold text-graphite">
        Wybierz datę wizyty.
      </p>
    </div>

    <!-- Krok 1a: kalendarz -->
    <div id="step-pick-date">
      <div id="date-calendar" class="date-calendar" role="application" aria-label="Wybierz datę wizyty">
        <div class="date-calendar__header">
          <button id="cal-prev" type="button" class="date-calendar__nav" aria-label="Poprzedni miesiąc">
            <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M10 3L5 8l5 5"/>
            </svg>
          </button>
          <p id="cal-month-label" class="date-calendar__month"></p>
          <button id="cal-next" type="button" class="date-calendar__nav" aria-label="Następny miesiąc">
            <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M6 3l5 5-5 5"/>
            </svg>
          </button>
        </div>

        <div class="date-calendar__weekdays" aria-hidden="true">
          {WEEKDAY_NAMES.map((day) => (
            <span class="date-calendar__weekday">{day}</span>
          ))}
        </div>

        <div id="cal-grid" class="date-calendar__grid" role="grid" aria-label="Dni miesiąca"></div>
      </div>

      <input type="hidden" id="date-input" value="" />
    </div>

    <!-- Krok 1b: godziny (po wyborze daty) -->
    <div id="step-pick-time" class="hidden">
      <div class="mb-5 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
        <div>
          <p class="text-sm text-graphite-muted">Wybrana data</p>
          <p id="picked-date-label" class="text-lg font-bold capitalize text-graphite"></p>
        </div>
        <button id="back-to-date-btn" type="button" class="btn btn-outline self-start text-sm sm:self-auto">
          ← Zmień datę
        </button>
      </div>

      <p id="time-slots-hint" class="mb-3 hidden text-sm text-graphite-muted">
        Na dziś nie ma już wolnych terminów. Wybierz inny dzień.
      </p>
      <div id="time-slots-grid" class="time-slots-grid mb-8">
        {TIME_SLOTS.map((slot) => (
          <button type="button" class="time-slot" data-time={slot}>
            {slot}
          </button>
        ))}
      </div>

      <button
        id="show-map-btn"
        type="button"
        disabled
        class="btn btn-orange w-full justify-center opacity-50 disabled:cursor-not-allowed disabled:hover:translate-y-0"
      >
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6-10l6-3m0 13l5.447 2.724A1 1 0 0021 18.382V7.618a1 1 0 00-1.447-.894L15 4m0 13V4"/>
        </svg>
        Pokaż plan kawiarni
      </button>
    </div>
  </div>

  <!-- ===== KROK 2: Mapa kawiarni ===== -->
  <div id="step-map" class="hidden">

    <div class="mb-6 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
      <div>
        <p class="text-sm text-graphite-muted">Rezerwacja na</p>
        <p class="text-lg font-bold text-graphite" id="chosen-datetime">— —</p>
      </div>
      <button id="back-btn" type="button" class="btn btn-outline self-start text-sm sm:self-auto">
        ← Zmień godzinę
      </button>
    </div>

    <!-- Legenda -->
    <div class="mb-4 flex flex-wrap gap-4 text-sm font-medium text-graphite-soft">
      <span class="flex items-center gap-2">
        <span class="inline-block h-4 w-4 rounded-full bg-blue shadow-sm"></span>Wolny
      </span>
      <span class="flex items-center gap-2">
        <span class="inline-block h-4 w-4 rounded-full bg-[#9ca3af] shadow-sm"></span>Zajęty
      </span>
      <span class="flex items-center gap-2">
        <span class="inline-block h-4 w-4 rounded-full bg-red shadow-sm"></span>Wybrany
      </span>
    </div>

    <!-- ============================================================
         SVG PLAN KAWIARNI
         viewBox: 0 0 920 480
         Wnętrze: x=22..610, y=22..458
         Separator: x=610..630
         Ogród: x=630..898, y=22..458
    ============================================================ -->
    <div class="relative w-full overflow-x-auto rounded-none border border-graphite-200 bg-white shadow-sm">
      <svg
        id="cafe-floorplan"
        viewBox="0 0 920 480"
        xmlns="http://www.w3.org/2000/svg"
        class="w-full"
        role="img"
        aria-label="Plan kawiarni MOCna! ze stolikami"
        style="min-width:460px; max-height:80vh"
      >
        <defs>
          <filter id="tshadow" x="-30%" y="-30%" width="160%" height="160%">
            <feDropShadow dx="0" dy="2" stdDeviation="3" flood-color="#1e3a5f" flood-opacity="0.22"/>
          </filter>
          <pattern id="parquet" patternUnits="userSpaceOnUse" width="24" height="24">
            <rect width="24" height="24" fill="#fdf6ee"/>
            <rect x="0"  y="0"  width="12" height="12" fill="#f7eedd" opacity="0.7"/>
            <rect x="12" y="12" width="12" height="12" fill="#f7eedd" opacity="0.7"/>
          </pattern>
          <pattern id="grass" patternUnits="userSpaceOnUse" width="14" height="14">
            <rect width="14" height="14" fill="#dcfce7"/>
            <path d="M3 12 Q4.5 7 6 12" stroke="#86efac" stroke-width="1.2" fill="none"/>
            <path d="M8 12 Q9.5 8 11 12" stroke="#86efac" stroke-width="1.2" fill="none"/>
          </pattern>
        </defs>

        <!-- ==============================
             TŁO
        ============================== -->
        <!-- Podłoga wnętrza (parkiet) -->
        <rect x="22" y="22" width="588" height="436" fill="url(#parquet)"/>
        <!-- Ogród (trawa) -->
        <rect x="630" y="22" width="268" height="436" fill="url(#grass)"/>
        <!-- Szyba tarasowa (między wnętrzem a ogrodem) -->
        <rect x="610" y="22" width="20" height="436" fill="#bfdbfe" opacity="0.22"/>
        <line x1="617" y1="22" x2="617" y2="458" stroke="#93c5fd" stroke-width="1"  opacity="0.6"/>
        <line x1="623" y1="22" x2="623" y2="458" stroke="#93c5fd" stroke-width="1"  opacity="0.6"/>
        <line x1="610" y1="130" x2="630" y2="130" stroke="#6b7280" stroke-width="1" opacity="0.4"/>
        <line x1="610" y1="240" x2="630" y2="240" stroke="#6b7280" stroke-width="1" opacity="0.4"/>
        <line x1="610" y1="350" x2="630" y2="350" stroke="#6b7280" stroke-width="1" opacity="0.4"/>

        <!-- ==============================
             DEKORACYJNE ROŚLINY W OGRODZIE
        ============================== -->
        <circle cx="644" cy="38"  r="9"  fill="#4ade80" opacity="0.45"/>
        <circle cx="657" cy="46"  r="6"  fill="#22c55e" opacity="0.40"/>
        <circle cx="886" cy="38"  r="9"  fill="#4ade80" opacity="0.45"/>
        <circle cx="874" cy="46"  r="6"  fill="#22c55e" opacity="0.40"/>
        <circle cx="644" cy="450" r="9"  fill="#4ade80" opacity="0.45"/>
        <circle cx="657" cy="442" r="6"  fill="#22c55e" opacity="0.40"/>
        <circle cx="886" cy="450" r="9"  fill="#4ade80" opacity="0.45"/>
        <circle cx="874" cy="442" r="6"  fill="#22c55e" opacity="0.40"/>

        <!-- ==============================
             KRZESŁA – rysowane PRZED stolikami
        ============================== -->

        <!-- -- TOP ROW (y=100, r=22) – żółte, 2-osobowe -- -->
        <!-- T1 cx=110 -->
        <rect x="103" y="68"  width="14" height="8" rx="2" fill="#ffde00" opacity="0.95"/>
        <rect x="103" y="124" width="14" height="8" rx="2" fill="#ffde00" opacity="0.95"/>
        <!-- T2 cx=210 -->
        <rect x="203" y="68"  width="14" height="8" rx="2" fill="#ffde00" opacity="0.95"/>
        <rect x="203" y="124" width="14" height="8" rx="2" fill="#ffde00" opacity="0.95"/>
        <!-- T3 cx=310 -->
        <rect x="303" y="68"  width="14" height="8" rx="2" fill="#ffde00" opacity="0.95"/>
        <rect x="303" y="124" width="14" height="8" rx="2" fill="#ffde00" opacity="0.95"/>
        <!-- T4 cx=410 -->
        <rect x="403" y="68"  width="14" height="8" rx="2" fill="#ffde00" opacity="0.95"/>
        <rect x="403" y="124" width="14" height="8" rx="2" fill="#ffde00" opacity="0.95"/>
        <!-- T5 cx=510 -->
        <rect x="503" y="68"  width="14" height="8" rx="2" fill="#ffde00" opacity="0.95"/>
        <rect x="503" y="124" width="14" height="8" rx="2" fill="#ffde00" opacity="0.95"/>

        <!-- -- BOTTOM ROW (y=390) – żółte -- -->
        <!-- T6 cx=85, r=22 -->
        <rect x="78"  y="358" width="14" height="8" rx="2" fill="#ffde00" opacity="0.95"/>
        <rect x="78"  y="414" width="14" height="8" rx="2" fill="#ffde00" opacity="0.95"/>
        <!-- T7 cx=172, r=22 -->
        <rect x="165" y="358" width="14" height="8" rx="2" fill="#ffde00" opacity="0.95"/>
        <rect x="165" y="414" width="14" height="8" rx="2" fill="#ffde00" opacity="0.95"/>
        <!-- T8 cx=288, r=22 (1-osobowy, tylko 1 krzesło) -->
        <rect x="281" y="358" width="14" height="8" rx="2" fill="#ffde00" opacity="0.95"/>
        <!-- T9 cx=375, r=22 -->
        <rect x="368" y="358" width="14" height="8" rx="2" fill="#ffde00" opacity="0.95"/>
        <rect x="368" y="414" width="14" height="8" rx="2" fill="#ffde00" opacity="0.95"/>

        <!-- -- OGRÓD – szare krzesła (3 na stolik: lewe, prawe, dolne) -- -->
        <!-- G1 cx=672, cy=415 -->
        <rect x="640" y="408" width="8" height="14" rx="2" fill="#d1d5db" opacity="0.95"/>
        <rect x="696" y="408" width="8" height="14" rx="2" fill="#d1d5db" opacity="0.95"/>
        <rect x="665" y="439" width="14" height="8" rx="2" fill="#d1d5db" opacity="0.95"/>
        <!-- G2 cx=840, cy=415 -->
        <rect x="808" y="408" width="8" height="14" rx="2" fill="#d1d5db" opacity="0.95"/>
        <rect x="864" y="408" width="8" height="14" rx="2" fill="#d1d5db" opacity="0.95"/>
        <rect x="833" y="439" width="14" height="8" rx="2" fill="#d1d5db" opacity="0.95"/>
        <!-- G3 cx=672, cy=320 -->
        <rect x="640" y="313" width="8" height="14" rx="2" fill="#d1d5db" opacity="0.95"/>
        <rect x="696" y="313" width="8" height="14" rx="2" fill="#d1d5db" opacity="0.95"/>
        <rect x="665" y="344" width="14" height="8" rx="2" fill="#d1d5db" opacity="0.95"/>
        <!-- G4 cx=840, cy=320 -->
        <rect x="808" y="313" width="8" height="14" rx="2" fill="#d1d5db" opacity="0.95"/>
        <rect x="864" y="313" width="8" height="14" rx="2" fill="#d1d5db" opacity="0.95"/>
        <rect x="833" y="344" width="14" height="8" rx="2" fill="#d1d5db" opacity="0.95"/>
        <!-- G5 cx=756, cy=225 -->
        <rect x="724" y="218" width="8" height="14" rx="2" fill="#d1d5db" opacity="0.95"/>
        <rect x="780" y="218" width="8" height="14" rx="2" fill="#d1d5db" opacity="0.95"/>
        <rect x="749" y="249" width="14" height="8" rx="2" fill="#d1d5db" opacity="0.95"/>
        <!-- G6 cx=756, cy=130 -->
        <rect x="724" y="123" width="8" height="14" rx="2" fill="#d1d5db" opacity="0.95"/>
        <rect x="780" y="123" width="8" height="14" rx="2" fill="#d1d5db" opacity="0.95"/>
        <rect x="749" y="154" width="14" height="8" rx="2" fill="#d1d5db" opacity="0.95"/>

        <!-- ==============================
             STREFA LOUNGE – tło
        ============================== -->
        <rect x="450" y="342" width="144" height="104" rx="8" fill="#fff1f2" opacity="0.8"/>

        <!-- ==============================
             STOLIKI – WNĘTRZE GÓRNY RZĄD (r=22, 2-osobowe)
        ============================== -->
        <g class="cafe-table" data-table-id="T1"
           data-status={occupiedSet.has("T1") ? "occupied" : "free"}
           style={`cursor:${tableCursor("T1")}`}
           role="button" tabindex="0" aria-label="Stolik 1 – 2 os. – Wnętrze">
          <circle cx="110" cy="100" r="22" fill={tableColor("T1")} filter="url(#tshadow)" class="table-circle"/>
          <text x="110" y="104" text-anchor="middle" font-size="11" font-weight="700" fill="white" font-family="sans-serif">1</text>
        </g>

        <g class="cafe-table" data-table-id="T2"
           data-status={occupiedSet.has("T2") ? "occupied" : "free"}
           style={`cursor:${tableCursor("T2")}`}
           role="button" tabindex="0" aria-label="Stolik 2 – 2 os. – Wnętrze">
          <circle cx="210" cy="100" r="22" fill={tableColor("T2")} filter="url(#tshadow)" class="table-circle"/>
          <text x="210" y="104" text-anchor="middle" font-size="11" font-weight="700" fill="white" font-family="sans-serif">2</text>
        </g>

        <g class="cafe-table" data-table-id="T3"
           data-status={occupiedSet.has("T3") ? "occupied" : "free"}
           style={`cursor:${tableCursor("T3")}`}
           role="button" tabindex="0" aria-label="Stolik 3 – 2 os. – Wnętrze">
          <circle cx="310" cy="100" r="22" fill={tableColor("T3")} filter="url(#tshadow)" class="table-circle"/>
          <text x="310" y="104" text-anchor="middle" font-size="11" font-weight="700" fill="white" font-family="sans-serif">3</text>
        </g>

        <g class="cafe-table" data-table-id="T4"
           data-status={occupiedSet.has("T4") ? "occupied" : "free"}
           style={`cursor:${tableCursor("T4")}`}
           role="button" tabindex="0" aria-label="Stolik 4 – 2 os. – Wnętrze">
          <circle cx="410" cy="100" r="22" fill={tableColor("T4")} filter="url(#tshadow)" class="table-circle"/>
          <text x="410" y="104" text-anchor="middle" font-size="11" font-weight="700" fill="white" font-family="sans-serif">4</text>
        </g>

        <g class="cafe-table" data-table-id="T5"
           data-status={occupiedSet.has("T5") ? "occupied" : "free"}
           style={`cursor:${tableCursor("T5")}`}
           role="button" tabindex="0" aria-label="Stolik 5 – 2 os. – Wnętrze">
          <circle cx="510" cy="100" r="22" fill={tableColor("T5")} filter="url(#tshadow)" class="table-circle"/>
          <text x="510" y="104" text-anchor="middle" font-size="11" font-weight="700" fill="white" font-family="sans-serif">5</text>
        </g>

        <!-- ==============================
             STOLIKI – WNĘTRZE DOLNY RZĄD
        ============================== -->
        <!-- T6: 2-osobowy, cx=85, cy=390 -->
        <g class="cafe-table" data-table-id="T6"
           data-status={occupiedSet.has("T6") ? "occupied" : "free"}
           style={`cursor:${tableCursor("T6")}`}
           role="button" tabindex="0" aria-label="Stolik 6 – 2 os. – Wnętrze">
          <circle cx="85" cy="390" r="22" fill={tableColor("T6")} filter="url(#tshadow)" class="table-circle"/>
          <text x="85" y="394" text-anchor="middle" font-size="11" font-weight="700" fill="white" font-family="sans-serif">6</text>
        </g>

        <!-- T7: 2-osobowy, cx=172, cy=390 -->
        <g class="cafe-table" data-table-id="T7"
           data-status={occupiedSet.has("T7") ? "occupied" : "free"}
           style={`cursor:${tableCursor("T7")}`}
           role="button" tabindex="0" aria-label="Stolik 7 – 2 os. – Wnętrze">
          <circle cx="172" cy="390" r="22" fill={tableColor("T7")} filter="url(#tshadow)" class="table-circle"/>
          <text x="172" y="394" text-anchor="middle" font-size="11" font-weight="700" fill="white" font-family="sans-serif">7</text>
        </g>

        <!-- T8: 1-osobowy, cx=288, cy=390 -->
        <g class="cafe-table" data-table-id="T8"
           data-status={occupiedSet.has("T8") ? "occupied" : "free"}
           style={`cursor:${tableCursor("T8")}`}
           role="button" tabindex="0" aria-label="Stolik 8 – 1 os. – Wnętrze">
          <circle cx="288" cy="390" r="22" fill={tableColor("T8")} filter="url(#tshadow)" class="table-circle"/>
          <text x="288" y="394" text-anchor="middle" font-size="11" font-weight="700" fill="white" font-family="sans-serif">8</text>
        </g>

        <!-- T9: 2-osobowy, cx=375, cy=390 -->
        <g class="cafe-table" data-table-id="T9"
           data-status={occupiedSet.has("T9") ? "occupied" : "free"}
           style={`cursor:${tableCursor("T9")}`}
           role="button" tabindex="0" aria-label="Stolik 9 – 2 os. – Wnętrze">
          <circle cx="375" cy="390" r="22" fill={tableColor("T9")} filter="url(#tshadow)" class="table-circle"/>
          <text x="375" y="394" text-anchor="middle" font-size="11" font-weight="700" fill="white" font-family="sans-serif">9</text>
        </g>

        <!-- T10: Strefa Lounge (2 fotele + kanapa = 4 os.) -->
        <!-- Krzesła przy fotelach (czerwone, dekoracyjne) -->
        <rect x="469" y="342" width="14" height="8"  rx="2" fill="#de3c42" opacity="0.7"/>
        <rect x="443" y="363" width="8"  height="14" rx="2" fill="#de3c42" opacity="0.7"/>
        <rect x="543" y="342" width="14" height="8"  rx="2" fill="#de3c42" opacity="0.7"/>
        <rect x="572" y="363" width="8"  height="14" rx="2" fill="#de3c42" opacity="0.7"/>

        <g class="cafe-table" data-table-id="T10"
           data-status={occupiedSet.has("T10") ? "occupied" : "free"}
