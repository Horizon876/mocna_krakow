---
---
<div
  id="cart-drawer"
  class="cart-drawer"
  aria-hidden="true"
  inert
  transition:persist="cart-drawer"
>
  <button
    type="button"
    class="cart-drawer-overlay"
    data-cart-close
    aria-label="Zamknij koszyk"
  ></button>

  <aside
    id="cart-drawer-panel"
    class="cart-drawer-panel"
    role="dialog"
    aria-modal="true"
    aria-labelledby="cart-drawer-title"
  >
    <!-- ── Nagłówek ── -->
    <header class="cdr-header">
      <div class="cdr-header-left">
        <svg class="cdr-header-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
          <path d="M6 6h15l-1.5 9h-12z" stroke-linejoin="round"></path>
          <path d="M6 6l-1.2-3H2" stroke-linecap="round"></path>
          <circle cx="9" cy="20" r="1"></circle>
          <circle cx="18" cy="20" r="1"></circle>
        </svg>
        <h2 id="cart-drawer-title" class="cdr-header-title">Koszyk</h2>
        <span id="cart-drawer-count" class="cdr-badge" style="display:none" aria-live="polite"></span>
      </div>
      <button type="button" class="cdr-close" data-cart-close aria-label="Zamknij koszyk">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M6 6l12 12M18 6L6 18" stroke-linecap="round"></path>
        </svg>
      </button>
    </header>

    <!-- ── Lista produktów ── -->
    <div id="cart-drawer-body" class="cdr-body">

      <!-- Pusty koszyk -->
      <div id="cart-drawer-empty" class="cdr-empty" style="display:none">
        <div class="cdr-empty-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4">
            <path d="M6 6h15l-1.5 9h-12z" stroke-linejoin="round"></path>
            <path d="M6 6l-1.2-3H2" stroke-linecap="round"></path>
            <circle cx="9" cy="20" r="1"></circle>
            <circle cx="18" cy="20" r="1"></circle>
          </svg>
        </div>
        <p class="cdr-empty-title">Koszyk jest pusty</p>
        <p class="cdr-empty-text">Dodaj produkty ze sklepu MOCnej,<br>aby złożyć zamówienie.</p>
        <a href="/sklep" data-cart-close class="btn-orange cdr-empty-btn">Przejdź do sklepu</a>
      </div>

      <!-- Produkty -->
      <ul id="cart-drawer-list" class="cdr-list"></ul>
    </div>

    <!-- ── Stopka ── -->
    <footer id="cart-drawer-footer" class="cdr-footer" style="display:none">
      <div id="cart-drawer-total-row" class="cdr-total">
        <span class="cdr-total-label">Razem do zapłaty</span>
        <span id="cart-drawer-total" class="cdr-total-value"></span>
      </div>
      <button type="button" id="cart-drawer-checkout" class="btn-orange cdr-checkout">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
          <path d="M3 3h2l.4 2M7 13h10l4-8H5.4" stroke-linecap="round" stroke-linejoin="round"></path>
          <circle cx="9" cy="21" r="1"></circle>
          <circle cx="20" cy="21" r="1"></circle>
        </svg>
        Przejdź do kasy
      </button>
    </footer>
  </aside>
</div>

<style>
  /* ── Wrapper (tło zasłona) ── */
  .cart-drawer {
    position: fixed;
    inset: 0;
    z-index: 100;
    visibility: hidden;
    pointer-events: none;
  }
  .cart-drawer.is-open {
    visibility: visible;
    pointer-events: auto;
  }

  .cart-drawer-overlay {
    position: absolute;
    inset: 0;
    border: 0;
    background: rgba(20, 20, 20, 0.5);
    opacity: 0;
    transition: opacity 0.3s ease;
    cursor: pointer;
    backdrop-filter: blur(2px);
  }
  .cart-drawer.is-open .cart-drawer-overlay { opacity: 1; }

  /* ── Panel ── */
  .cart-drawer-panel {
    position: absolute;
    top: 0;
    right: 0;
    display: flex;
    height: 100%;
    width: min(100vw, 36rem);
    flex-direction: column;
    background: #f9f6f1;
    box-shadow: -20px 0 60px -10px rgba(20, 20, 20, 0.25);
    transform: translateX(100%);
    transition: transform 0.38s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .cart-drawer.is-open .cart-drawer-panel { transform: translateX(0); }

  /* ── Nagłówek ── */
  .cdr-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 1.35rem 1.5rem 1.25rem;
    background: #fff;
    border-bottom: 2px solid #f0ece6;
    flex-shrink: 0;
  }
  .cdr-header-left {
    display: flex;
    align-items: center;
    gap: 0.65rem;
  }
  .cdr-header-icon {
    height: 1.4rem;
    width: 1.4rem;
    color: #f39200;
    flex-shrink: 0;
  }
  .cdr-header-title {
    font-size: 1.35rem;
    font-weight: 700;
    letter-spacing: -0.025em;
    color: #1c1c1c;
    line-height: 1;
  }
  .cdr-badge {
    display: inline-flex;
    align-items: center;
    border-radius: 999px;
    background: #fff3cd;
    border: 1px solid #ffd966;
    padding: 0.15rem 0.6rem;
    font-size: 0.75rem;
    font-weight: 700;
    color: #7a5900;
    white-space: nowrap;
    line-height: 1.4;
  }
  .cdr-close {
    display: grid;
    height: 2.4rem;
    width: 2.4rem;
    place-items: center;
    border-radius: 0.6rem;
    color: #777;
    flex-shrink: 0;
    transition: background 0.18s, color 0.18s;
  }
  .cdr-close:hover { background: #f0ece6; color: #1c1c1c; }
  .cdr-close svg { height: 1.2rem; width: 1.2rem; }

  /* ── Przewijalna lista ── */
  .cdr-body {
    flex: 1;
    overflow-y: auto;
    padding: 1.25rem 1.35rem 1.5rem;
    scrollbar-width: thin;
    scrollbar-color: #f39200 transparent;
  }

  /* ── Pusty koszyk ── */
  .cdr-empty {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 3rem 1rem 1rem;
    text-align: center;
    gap: 0;
  }
  .cdr-empty-icon {
    display: grid;
    height: 5rem;
    width: 5rem;
    place-items: center;
    background: #fff;
    border: 1.5px solid #e8e4de;
    color: #bbb;
  }
  .cdr-empty-icon svg { height: 2.25rem; width: 2.25rem; }
  .cdr-empty-title {
    margin-top: 1.35rem;
    font-size: 1.1rem;
    font-weight: 700;
    color: #1c1c1c;
  }
  .cdr-empty-text {
    margin-top: 0.5rem;
    font-size: 0.9375rem;
    line-height: 1.65;
    color: #888;
  }
  .cdr-empty-btn {
    margin-top: 1.5rem;
    min-width: 14rem;
    justify-content: center;
  }

  /* ── Lista produktów ── */
  .cdr-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  /* ── Karta produktu (dynamiczne — :global) ── */
  :global(.cdr-item) {
    display: grid;
    grid-template-columns: 5.5rem 1fr;
    grid-template-rows: auto auto;
    background: #fff;
    border: 1.5px solid #e8e4de;
    overflow: hidden;
    box-shadow: 0 4px 16px -8px rgba(20, 20, 20, 0.12);
    transition: box-shadow 0.2s;
  }
  :global(.cdr-item:hover) { box-shadow: 0 6px 20px -8px rgba(20, 20, 20, 0.18); }

  :global(.cdr-item-thumb) {
    grid-column: 1;
    grid-row: 1 / 3;
    display: grid;
    place-items: center;
    border-right: 1.5px solid #e8e4de;
    min-height: 7rem;
  }
  :global(.cdr-item-emoji) {
    font-size: 2.4rem;
    line-height: 1;
    filter: drop-shadow(0 2px 5px rgba(0,0,0,0.08));
    user-select: none;
  }
  :global(.cdr-item-img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  :global(.cdr-item-top) {
    grid-column: 2;
    grid-row: 1;
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.5rem;
    padding: 0.85rem 0.95rem 0.4rem;
    min-width: 0;
  }
  :global(.cdr-item-info) { min-width: 0; flex: 1; }
  :global(.cdr-item-name) {
    font-size: 0.9375rem;
    font-weight: 700;
    color: #1c1c1c;
    line-height: 1.3;
    margin: 0;
  }
  :global(.cdr-item-unit) {
    font-size: 0.8125rem;
    color: #888;
    margin-top: 0.2rem;
  }

  :global(.cdr-item-remove) {
    display: grid;
    height: 1.9rem;
    width: 1.9rem;
    place-items: center;
    flex-shrink: 0;
    border: 1.5px solid #fad0d0;
    background: #fff8f8;
    color: #c0392b;
    border-radius: 0.4rem;
    transition: background 0.18s, border-color 0.18s, color 0.18s;
    cursor: pointer;
  }
  :global(.cdr-item-remove:hover) { background: #fde8e8; border-color: #e57373; color: #8b0000; }
  :global(.cdr-item-remove svg) { height: 0.9rem; width: 0.9rem; }

  :global(.cdr-item-bottom) {
    grid-column: 2;
    grid-row: 2;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    padding: 0.6rem 0.95rem 0.85rem;
    border-top: 1px dashed #ede9e3;
    min-width: 0;
  }

  :global(.cdr-qty) {
    display: inline-flex;
    align-items: center;
    border: 1.5px solid #ddd8d0;
    background: #f9f6f1;
    overflow: hidden;
  }
  :global(.cdr-qty-btn) {
    display: grid;
    height: 2.1rem;
    width: 2.1rem;
    place-items: center;
    font-size: 1.15rem;
    line-height: 1;
    color: #444;
    background: transparent;
    transition: background 0.15s;
    cursor: pointer;
  }
  :global(.cdr-qty-btn:hover) { background: #ede9e3; }
  :global(.cdr-qty-input) {
    height: 2.1rem;
    width: 3rem;
    border-inline: 1.5px solid #ddd8d0;
    background: #fff;
    text-align: center;
    font-size: 0.9rem;
    font-weight: 700;
    color: #1c1c1c;
    appearance: textfield;
    -moz-appearance: textfield;
  }
  :global(.cdr-qty-input::-webkit-outer-spin-button),
  :global(.cdr-qty-input::-webkit-inner-spin-button) { -webkit-appearance: none; margin: 0; }
  :global(.cdr-qty-input:focus) { outline: none; box-shadow: inset 0 0 0 2px rgba(44,94,169,0.2); }

  :global(.cdr-item-price) {
    font-size: 1.1rem;
    font-weight: 800;
    letter-spacing: -0.025em;
    color: #1c1c1c;
    white-space: nowrap;
  }

  /* ── Stopka ── */
  .cdr-footer {
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    background: #fff;
    border-top: 2px solid #f0ece6;
    padding: 1.2rem 1.5rem 1.5rem;
  }
  .cdr-total {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    background: #fff8f0;
    border: 1.5px solid #f5dbb5;
    padding: 0.85rem 1.1rem;
  }
  .cdr-total-label {
    font-size: 0.875rem;
    font-weight: 600;
    color: #777;
  }
  .cdr-total-value {
    font-size: 1.45rem;
    font-weight: 800;
    letter-spacing: -0.03em;
    color: #1c1c1c;
  }
  .cdr-checkout {
    justify-content: center;
    gap: 0.6rem;
    min-height: 3.1rem;
    font-size: 1rem;
  }
  .cdr-checkout svg { height: 1.15rem; width: 1.15rem; }

  #cart-drawer-checkout:disabled {
    opacity: 0.45;
    cursor: not-allowed;
  }
</style>

<script>
  import { PRODUCTS, COLORS } from "@data/site";
  import {
    readCart,
    cartTotal,
    clampQty,
    formatPln,
    migrateCart,
    parsePriceAmount,
    removeCartItem,
    setCartItemQty,
    type CartItem,
  } from "../scripts/cart";

  let lastFocus: HTMLElement | null = null;

  function getEls() {
    return {
      drawer:   document.getElementById("cart-drawer"),
      panel:    document.getElementById("cart-drawer-panel"),
      list:     document.getElementById("cart-drawer-list")     as HTMLUListElement | null,
      empty:    document.getElementById("cart-drawer-empty"),
      count:    document.getElementById("cart-drawer-count"),
      footer:   document.getElementById("cart-drawer-footer"),
      totalRow: document.getElementById("cart-drawer-total-row"),
      totalEl:  document.getElementById("cart-drawer-total"),
      checkout: document.getElementById("cart-drawer-checkout") as HTMLButtonElement | null,
    };
  }

  function linePrice(item: CartItem) {
    const unit = parsePriceAmount(item.price);
    return unit !== null ? formatPln(unit * item.qty) : item.price;
  }

  function enrichItem(item: CartItem): CartItem & { emoji: string; color: string; image?: string } {
    const p = PRODUCTS.find((x) => x.id === item.id);
    return {
      ...item,
      emoji: item.emoji || p?.emoji || "🛍️",
      color: item.color || (p ? COLORS[p.color] : "#f39200"),
      image: item.image || p?.image,
    };
  }

  function buildItem(raw: CartItem): HTMLLIElement {
    const item = enrichItem(raw);
    const li = document.createElement("li");
    li.className = "cdr-item";
    li.dataset.cartItemId = item.id;

    /* ── miniatura ── */
    const thumb = document.createElement("div");
    thumb.className = "cdr-item-thumb";
    thumb.style.background = `${item.color}1a`;
    thumb.setAttribute("aria-hidden", "true");

    if (item.image) {
      const img = document.createElement("img");
      img.className = "cdr-item-img";
      img.src = item.image;
      img.alt = item.name;
      img.loading = "lazy";
      thumb.append(img);
    } else {
      const em = document.createElement("span");
      em.className = "cdr-item-emoji";
      em.textContent = item.emoji;
      thumb.append(em);
    }

    /* ── wiersz 1: info + usuń ── */
    const top = document.createElement("div");
    top.className = "cdr-item-top";

    const info = document.createElement("div");
    info.className = "cdr-item-info";

    const name = document.createElement("h3");
    name.className = "cdr-item-name";
    name.textContent = item.name;

    const unit = document.createElement("p");
    unit.className = "cdr-item-unit";
    unit.textContent = `${item.price} / szt.`;

    info.append(name, unit);

    const removeBtn = document.createElement("button");
    removeBtn.type = "button";
    removeBtn.className = "cdr-item-remove";
    removeBtn.dataset.cartRemove = item.id;
    removeBtn.setAttribute("aria-label", `Usuń ${item.name} z koszyka`);
    removeBtn.innerHTML =
      `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
        <path d="M3 6h18M8 6V4h8v2M19 6l-1 14H6L5 6" stroke-linecap="round" stroke-linejoin="round"></path>
      </svg>`;

    top.append(info, removeBtn);

    /* ── wiersz 2: stepper + suma ── */
    const bottom = document.createElement("div");
    bottom.className = "cdr-item-bottom";

    const qty = document.createElement("div");
    qty.className = "cdr-qty";

    const minus = document.createElement("button");
    minus.type = "button";
    minus.className = "cdr-qty-btn";
    minus.dataset.cartQtyMinus = item.id;
    minus.setAttribute("aria-label", `Zmniejsz ilość — ${item.name}`);
    minus.textContent = "−";

    const input = document.createElement("input");
    input.type = "number";
    input.min = "1";
    input.max = "99";
    input.step = "1";
    input.inputMode = "numeric";
    input.className = "cdr-qty-input";
    input.dataset.cartQty = item.id;
    input.value = String(item.qty);
    input.setAttribute("aria-label", `Ilość — ${item.name}`);

    const plus = document.createElement("button");
    plus.type = "button";
    plus.className = "cdr-qty-btn";
    plus.dataset.cartQtyPlus = item.id;
    plus.setAttribute("aria-label", `Zwiększ ilość — ${item.name}`);
    plus.textContent = "+";

    qty.append(minus, input, plus);

    const price = document.createElement("span");
    price.className = "cdr-item-price";
    price.textContent = linePrice(item);

    bottom.append(qty, price);

    li.append(thumb, top, bottom);
    return li;
  }

  function renderCart() {
    const { list, empty, count, footer, totalRow, totalEl, checkout } = getEls();
    if (!list || !empty || !count || !footer || !totalRow || !totalEl || !checkout) return;

    const items = readCart();
    list.replaceChildren();

    if (items.length === 0) {
      empty.style.display = "flex";
      count.style.display = "none";
      footer.style.display = "none";
      checkout.disabled = true;
      return;
    }

    empty.style.display = "none";
    footer.style.display = "";
    checkout.disabled = false;

    const totalQty = items.reduce((s, i) => s + i.qty, 0);
    count.style.display = "";
    count.textContent = totalQty === 1 ? "1 szt." : `${totalQty} szt.`;

    items.forEach((item) => list.append(buildItem(item)));

    const total = cartTotal(items);
    if (total > 0) {
      totalRow.classList.remove("hidden");
      totalEl.textContent = formatPln(total);
    } else {
      totalRow.classList.add("hidden");
    }
  }

  function openCartDrawer() {
    const { drawer } = getEls();
    if (!drawer) return;
    lastFocus = document.activeElement as HTMLElement | null;
    drawer.classList.add("is-open");
    drawer.setAttribute("aria-hidden", "false");
    drawer.removeAttribute("inert");
    document.body.style.overflow = "hidden";
    renderCart();
    drawer.querySelector<HTMLElement>(".cdr-close")?.focus();
  }

  function closeCartDrawer() {
    const { drawer } = getEls();
    if (!drawer) return;
    drawer.classList.remove("is-open");
    drawer.setAttribute("aria-hidden", "true");
    drawer.setAttribute("inert", "");
    document.body.style.overflow = "";
    lastFocus?.focus();
    lastFocus = null;
  }

  function handleClick(e: Event) {
    const t = e.target as HTMLElement;

    if (t.closest("#cart-drawer [data-cart-close]")) {
      closeCartDrawer();
      return;
    }

    const rem = t.closest<HTMLElement>("[data-cart-remove]");
    if (rem) { removeCartItem(rem.dataset.cartRemove ?? ""); return; }

    const mn = t.closest<HTMLElement>("[data-cart-qty-minus]");
    if (mn) {
      const id = mn.dataset.cartQtyMinus ?? "";
      const it = readCart().find((x) => x.id === id);
      if (it) setCartItemQty(id, it.qty - 1);
      return;
    }

    const pl = t.closest<HTMLElement>("[data-cart-qty-plus]");
    if (pl) {
      const id = pl.dataset.cartQtyPlus ?? "";
      const it = readCart().find((x) => x.id === id);
      if (it) setCartItemQty(id, it.qty + 1);
    }
  }

  function handleChange(e: Event) {
    const input = e.target as HTMLInputElement;
    if (!input.matches("#cart-drawer [data-cart-qty]")) return;
    const id = input.dataset.cartQty ?? "";
    if (id) setCartItemQty(id, clampQty(parseInt(input.value, 10) || 1));
  }

  function init() {
    migrateCart();
    renderCart();

    const win = window as Window & { __mocnaCartDrawerReady?: boolean; mocnaOpenCart?: () => void };
    win.mocnaOpenCart = openCartDrawer;
    if (win.__mocnaCartDrawerReady) return;
    win.__mocnaCartDrawerReady = true;

    document.addEventListener("click", handleClick);
    document.addEventListener("change", handleChange);
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && document.getElementById("cart-drawer")?.classList.contains("is-open")) {
        closeCartDrawer();
      }
    });

    window.addEventListener("mocna:open-cart", openCartDrawer);
    window.addEventListener("mocna:cart-updated", renderCart);
    window.addEventListener("storage", (e) => { if (e.key === "mocna-cart") renderCart(); });
  }

  init();
  document.addEventListener("astro:page-load", init);
</script>
