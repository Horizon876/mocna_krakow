---
import OptimizedImage from "@components/OptimizedImage.astro";
import { HERO_PHOTO_SIZES, PHOTO_IMAGE_WIDTHS } from "@/lib/optimized-image";

interface Props {
  imageUrl?: string;
  imagePosition?: string;
  imageAlt?: string;
}

const {
  imageUrl = "/photos/zespol.jpeg",
  imagePosition = "58% 50%",
  imageAlt = "Cały zespół kawiarni MOCna! przy barze",
} = Astro.props;

const primary = { label: "Zobacz wydarzenia", href: "/wydarzenia" };
const secondaryAccent = {
  orange: {
    btn: "border-[#f39200] bg-[#f39200] text-graphite hover:border-[#d97f00] hover:bg-[#d97f00]",
    icon: "text-graphite",
    label: "text-graphite",
  },
  yellow: {
    btn: "border-yellow bg-yellow text-graphite hover:border-[#e6c800] hover:bg-[#f5d500]",
    icon: "text-graphite",
    label: "text-graphite",
  },
  red: {
    btn: "border-[#c2343a] bg-[#c2343a] text-white hover:border-[#a92a30] hover:bg-[#a92a30]",
    icon: "text-white",
    label: "text-white",
  },
  green: {
    btn: "border-[#007a4c] bg-[#007a4c] text-white hover:border-[#006640] hover:bg-[#006640]",
    icon: "text-white",
    label: "text-white",
  },
} as const;

const secondary = [
  {
    label: "Kawiarnia",
    href: "/kawiarnia",
    accent: "orange" as const,
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8h1a4 4 0 010 8h-1"/><path d="M2 8h16v9a4 4 0 01-4 4H6a4 4 0 01-4-4V8z"/><path d="M6 1v3M10 1v3M14 1v3"/></svg>`,
  },
  {
    label: "Sklep MOCnej",
    href: "/sklep",
    accent: "yellow" as const,
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4z"/><path d="M3 6h18"/><path d="M16 10a4 4 0 01-8 0"/></svg>`,
  },
  {
    label: "Wesprzyj nas",
    href: "/wesprzyj",
    accent: "red" as const,
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20.84 4.61a5.5 5.5 0 00-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 00-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 000-7.78z"/></svg>`,
  },
  {
    label: "Projekty",
    href: "/projekty",
    accent: "green" as const,
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 19a2 2 0 01-2 2H4a2 2 0 01-2-2V5a2 2 0 012-2h5l2 3h9a2 2 0 012 2z"/><path d="M12 11v6M9 14h6"/></svg>`,
  },
];
---

<!-- Dokładnie jeden ekran minus navbar, min-h by uniknąć obcinania na małych mobilkach -->
<section
  class="hero-section relative flex min-h-[calc(100dvh-4rem)] flex-col overflow-hidden bg-transparent sm:min-h-[calc(100dvh-4.5rem)] lg:flex-row lg:items-stretch lg:gap-8 xl:gap-10"
>

  <!-- Lewa kolumna: wyśrodkowana pionowo, równe marginesy góra/dół -->
  <div class="relative z-10 flex min-h-0 flex-1 flex-col justify-center bg-transparent px-7 py-10 sm:px-10 sm:py-12 lg:max-w-[44rem] lg:flex-none lg:shrink-0 lg:px-10 lg:py-14 xl:px-14 xl:py-16">

    <h1 class="font-display leading-[1.0] tracking-tightest text-graphite">
      <span class="hero-kicker mb-2.5 block font-semibold uppercase tracking-[0.28em] text-blue sm:mb-3">
        Fundacja
      </span>
      <span class="hero-brand block font-display leading-none tracking-tightest" aria-label="MOCna!">
        <span class="text-blue">M</span><span class="text-red">O</span><span class="text-yellow">C</span><span class="text-green">n</span><span class="text-pink">a</span><span class="text-orange">!</span>
      </span>
      <span class="hero-sub mt-3 block font-semibold leading-[1.1] text-blue sm:mt-3.5">
        miejsce, gdzie <span class="text-brand-orange-ink">kawa</span><br />
        spotyka <span class="text-red">człowieka</span>.
      </span>
    </h1>

    <p class="hero-lead mt-5 font-light leading-relaxed text-graphite-soft sm:mt-6">
      Tworzymy miejsca pracy dla osób z niepełnosprawnościami. Prowadzimy
      społeczną kawiarnię, organizujemy wydarzenia, szkolenia i budujemy
      społeczność opartą na relacjach.
    </p>

    <div class="hero-ctas mt-9 flex flex-col gap-2 sm:mt-11 sm:gap-2.5 lg:mt-12">

      <!-- Główne CTA – pełna szerokość -->
      <a
        href={primary.href}
        class="hero-btn hero-btn-primary flex items-center justify-between gap-3 bg-blue px-6 py-5 text-[15px] font-bold tracking-[-0.015em] text-white transition-all duration-300 ease-organic hover:-translate-y-px hover:bg-[#244d8f] sm:text-[15.5px]"
        style="--delay:0ms"
      >
        <span class="flex items-center gap-3">
          <svg class="h-5 w-5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="3" y="5" width="18" height="16" rx="2"/>
            <path d="M8 3v4M16 3v4M3 9h18"/>
          </svg>
          {primary.label}
        </span>
        <svg class="h-[18px] w-[18px] shrink-0 opacity-75" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M3 8h10M9 4l4 4-4 4"/>
        </svg>
      </a>

      <!-- Dodatkowe CTA – 4 kolumny -->
      <div class="grid grid-cols-2 gap-2 sm:grid-cols-4 sm:gap-2.5">
        {secondary.map((c, i) => {
          const tone = secondaryAccent[c.accent];
          return (
            <a
              href={c.href}
              class:list={[
                "hero-btn group flex flex-col items-center gap-2 border px-2.5 py-4 text-center transition-all duration-300 ease-organic hover:-translate-y-px sm:py-4.5",
                tone.btn,
              ]}
              style={`--delay:${(i + 1) * 60}ms`}
            >
              <span
                class:list={[
                  "flex h-9 w-9 items-center justify-center transition-colors duration-300 sm:h-10 sm:w-10",
                  tone.icon,
                ]}
                aria-hidden="true"
              >
                <Fragment set:html={c.icon} />
              </span>
              <span
                class:list={[
                  "block text-[12.5px] font-semibold leading-tight transition-colors duration-300 sm:text-[13px]",
                  tone.label,
                ]}
              >
                {c.label}
              </span>
            </a>
          );
        })}
      </div>
    </div>
  </div>

  <!-- Prawa kolumna — zdjęcie z marginesem. Ukryte na mobile, widoczne od LG -->
  <div class="hero-photo-col hidden min-w-0 flex-1 flex-col lg:flex lg:min-h-0 lg:py-8 lg:pl-6 lg:pr-0 xl:py-10 xl:pl-8">
    <div class="hero-photo relative min-h-0 flex-1">
      <!-- Nieregularna maska (kształt + rozmycie brzegów) -->
      <svg class="hero-mask-defs" aria-hidden="true" focusable="false">
        <defs>
          <filter id="hero-mask-feather" filterUnits="objectBoundingBox" x="-0.1" y="-0.1" width="1.2" height="1.2">
            <feGaussianBlur in="SourceGraphic" stdDeviation="0.018" />
          </filter>
          <mask id="hero-photo-organic-mask" maskUnits="objectBoundingBox" maskContentUnits="objectBoundingBox">
            <path
              fill="white"
              filter="url(#hero-mask-feather)"
              d="M 0.1 0.06 C 0.24 0.14 0.2 0.02 0.38 0.05 L 0.94 0.04 C 1.02 0.12 0.96 0.2 1 0.3 L 0.96 0.88 C 0.9 0.98 0.78 0.94 0.64 0.98 L 0.08 0.95 C -0.01 0.8 0.04 0.7 0.02 0.52 C 0 0.33 0.05 0.16 0.1 0.06 Z"
            />
          </mask>
          <mask id="hero-photo-organic-mask-lg" maskUnits="objectBoundingBox" maskContentUnits="objectBoundingBox">
            <path
              fill="white"
              filter="url(#hero-mask-feather)"
              d="M 0.17 0.05 C 0.31 0.13 0.26 0.02 0.44 0.05 L 0.95 0.03 C 1.03 0.11 0.97 0.19 1 0.29 L 0.97 0.87 C 0.91 0.97 0.79 0.93 0.65 0.97 L 0.07 0.94 C -0.02 0.79 0.03 0.69 0.01 0.51 C -0.01 0.32 0.04 0.15 0.17 0.05 Z"
            />
          </mask>
        </defs>
      </svg>
      <div class="hero-photo-masked absolute inset-0">
        <OptimizedImage
          src={imageUrl}
          alt={imageAlt}
          widths={PHOTO_IMAGE_WIDTHS}
          sizes={HERO_PHOTO_SIZES}
          class="hero-photo-img absolute inset-0 h-full w-full object-cover"
          style={`object-position: ${imagePosition};`}
          loading="eager"
          fetchpriority="high"
        />
      </div>
      <div class="hero-photo-fade pointer-events-none absolute inset-0" aria-hidden="true"></div>
    </div>
  </div>

</section>

<style>
  .hero-kicker {
    font-size: clamp(1.125rem, 0.9rem + 0.95vw, 1.65rem);
  }
  .hero-brand {
    font-size: clamp(4.6rem, 1.85rem + 8.5vw, 6.75rem);
  }
  .hero-sub {
    font-size: clamp(1.85rem, 0.98rem + 3vw, 2.85rem);
  }
  .hero-lead {
    font-size: clamp(0.98rem, 0.88rem + 0.35vw, 1.1rem);
  }

  /* Zdjęcie: nieregularne zanikanie (maska SVG + miękkie plamy koloru tła) */
  .hero-photo {
    --hero-fade-bg: #fff8f0;
    overflow: visible;
  }

  .hero-mask-defs {
    position: absolute;
    width: 0;
    height: 0;
    overflow: hidden;
  }

  .hero-photo-masked {
    transform: scale(1.02);
    transform-origin: center;
    -webkit-mask: url(#hero-photo-organic-mask);
    mask: url(#hero-photo-organic-mask);
    -webkit-mask-size: 100% 100%;
    mask-size: 100% 100%;
    -webkit-mask-repeat: no-repeat;
    mask-repeat: no-repeat;
  }

  @media (min-width: 1024px) {
    .hero-photo-masked {
      -webkit-mask: url(#hero-photo-organic-mask-lg);
      mask: url(#hero-photo-organic-mask-lg);
    }
  }

  .hero-photo-img {
    transform: none;
  }

  .hero-photo-fade {
    background:
      linear-gradient(152deg, var(--hero-fade-bg) 0%, transparent 18%),
      linear-gradient(228deg, color-mix(in srgb, var(--hero-fade-bg) 85%, transparent) 0%, transparent 16%),
      linear-gradient(12deg, transparent 62%, color-mix(in srgb, var(--hero-fade-bg) 50%, transparent) 100%),
      radial-gradient(ellipse 26% 40% at 1% 36%, var(--hero-fade-bg) 0%, transparent 70%),
      radial-gradient(ellipse 20% 28% at 99% 14%, var(--hero-fade-bg) 0%, transparent 65%),
      radial-gradient(ellipse 18% 24% at 96% 88%, color-mix(in srgb, var(--hero-fade-bg) 70%, transparent) 0%, transparent 62%);
    opacity: 0.5;
  }

  @media (min-width: 1024px) {
    .hero-photo-fade {
      background:
        linear-gradient(138deg, var(--hero-fade-bg) 0%, transparent 22%),
        linear-gradient(242deg, color-mix(in srgb, var(--hero-fade-bg) 75%, transparent) 0%, transparent 14%),
        linear-gradient(8deg, transparent 70%, color-mix(in srgb, var(--hero-fade-bg) 40%, transparent) 100%),
        radial-gradient(ellipse 30% 44% at 0% 40%, var(--hero-fade-bg) 0%, transparent 72%),
        radial-gradient(ellipse 18% 26% at 100% 10%, color-mix(in srgb, var(--hero-fade-bg) 55%, transparent) 0%, transparent 68%);
      opacity: 0.48;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    h1 .hero-kicker,
    h1 .hero-brand,
    h1 .hero-sub,
    .hero-lead,
    .hero-photo-col {
      opacity: 0;
      transform: translateY(22px);
      animation: hero-rise 0.7s cubic-bezier(0.22, 1, 0.36, 1) forwards;
    }

    .hero-btn,
    .hero-btn-primary {
      transform: translateY(22px);
      animation: hero-rise-motion 0.7s cubic-bezier(0.22, 1, 0.36, 1) forwards;
    }

    h1 .hero-kicker    { animation-delay: 0.05s; }
    h1 .hero-brand    { animation-delay: 0.10s; }
    h1 .hero-sub      { animation-delay: 0.16s; }
    .hero-lead        { animation-delay: 0.22s; }
    .hero-btn-primary { animation-delay: calc(0.30s + var(--delay, 0ms)); }
    .hero-btn         { animation-delay: calc(0.30s + var(--delay, 0ms)); }
    .hero-photo-col   { animation-delay: 0.10s; transform: translateY(0) scale(0.985); }

    @keyframes hero-rise {
      to { opacity: 1; transform: translateY(0) scale(1); }
    }

    @keyframes hero-rise-motion {
      to { transform: translateY(0); }
    }
  }
</style>
