# PostgreSQL (Vercel Postgres, Neon, Supabase…)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Losowy sekret do podpisywania sesji admina (min. 32 znaki)
SESSION_SECRET=wygeneruj-losowy-ciag-min-32-znaki

# Hash hasła admina zakodowany w base64 (bcrypt)
# Wygeneruj: node -e "console.log(Buffer.from('$2a$12$...bcrypt_hash...').toString('base64'))"
ADMIN_PASSWORD_HASH_B64=

# Hash hasła pracownika (bcrypt, base64) — np. node -e "import bcrypt from 'bcryptjs'; ..."
PRACOWNIK_PASSWORD_HASH_B64=

# Vercel Blob – upload zdjęć produktów w produkcji (auto po podłączeniu Blob w Vercel)
BLOB_READ_WRITE_TOKEN=

# Resend – potwierdzenia rezerwacji i emaile o zamówieniach (https://resend.com)
RESEND_API_KEY=
# Nadawca — po weryfikacji domeny np. MOCna! <sklep@mocna.org>
RESEND_FROM_EMAIL=MOCna! <onboarding@resend.dev>
# W dev z onboarding@resend.dev emaile trafiają tylko na ten adres (konto Resend)
RESEND_TEST_TO=twoj@email.resend.com

# Stripe – klucz tajny do płatności online
STRIPE_SECRET_KEY=sk_live_...

# InPost GeoWidget – token z https://sandbox-manager.paczkomaty.pl (test) lub manager.paczkomaty.pl (prod)
# Bez tokenu działa wyszukiwarka testowa paczkomatów (publiczne API ShipX)
INPOST_GEOWIDGET_TOKEN=
INPOST_GEOWIDGET_SANDBOX=true

# URL witryny lokalnie / produkcyjnie (emaile, Stripe redirect)
SITE=http://localhost:4321

# Sekret ISR / odświeżania cache stron (min. 32 znaki) — po zmianie treści w panelu
REVALIDATE_SECRET=wygeneruj-losowy-ciag-min-32-znaki
