{
  "name": "mocna",
  "type": "module",
  "version": "1.0.0",
  "description": "MOCna! – społeczna kawiarnia specialty. Wielostronicowa witryna w Astro.",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "node scripts/setup-fonts.mjs && node scripts/optimize-images.mjs && astro build && node scripts/patch-vercel-runtime.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio",
    "setup": "powershell -ExecutionPolicy Bypass -File scripts/setup.ps1",
    "setup:vercel": "node scripts/setup-vercel-env.mjs",
    "fonts:setup": "node scripts/setup-fonts.mjs",
    "images:optimize": "node scripts/optimize-images.mjs",
    "gen:creds": "node scripts/gen-creds.mjs",
    "deploy": "npx vercel --prod --yes"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.9",
    "@astrojs/react": "^3.6.2",
    "@astrojs/tailwind": "^5.1.2",
    "@astrojs/vercel": "^7.8.2",
    "@stripe/stripe-js": "^9.7.0",
    "@types/qrcode": "^1.5.6",
    "@vercel/blob": "^0.27.3",
    "astro": "^4.16.7",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "framer-motion": "^11.11.17",
    "postgres": "^3.4.9",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "resend": "^6.12.4",
    "stripe": "^22.2.0",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.9.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/pg": "^8.20.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "drizzle-kit": "^0.31.10",
    "sharp": "^0.34.5"
  }
}
